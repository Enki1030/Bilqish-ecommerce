---
---

<div
  id="confirm-overlay"
  class="fixed inset-0 z-[1200] hidden items-center justify-center bg-ink/35 backdrop-blur-[2px] px-4 py-8"
>
  <div
    id="confirm-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="confirm-title"
    aria-describedby="confirm-message"
    class="relative w-full max-w-[460px] max-h-[calc(100dvh-2rem)] overflow-y-auto bg-ivory border border-line shadow-[0_30px_90px_-24px_rgba(26,24,21,0.45)] p-6 sm:p-8"
  >
    <button
      id="confirm-close"
      type="button"
      class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center text-ink/35 hover:text-oxblood transition-colors cursor-pointer"
      aria-label="Tutup"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="flex items-start gap-4 pr-8">
      <div id="confirm-icon" class="w-11 h-11 shrink-0 flex items-center justify-center border border-line text-ink">
        <svg data-confirm-icon="default" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <svg data-confirm-icon="danger" class="hidden w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>

      <div class="min-w-0 flex-1">
        <p id="confirm-eyebrow" class="text-[10px] uppercase tracking-[0.3em] text-ink/40">Konfirmasi</p>
        <h3 id="confirm-title" class="display-font text-[24px] sm:text-[27px] leading-[1.15] text-ink mt-1.5">Konfirmasi</h3>
        <p id="confirm-message" class="text-[13px] leading-relaxed text-ink/60 mt-2.5"></p>
      </div>
    </div>

    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2.5 mt-8 pt-5 border-t border-line">
      <button
        id="confirm-cancel"
        type="button"
        class="border border-line bg-bone text-ink px-5 py-3 text-[11px] uppercase tracking-[0.2em] hover:border-ink transition-colors cursor-pointer"
      >
        Batal
      </button>
      <button
        id="confirm-ok"
        type="button"
        class="border border-ink bg-ink text-ivory px-5 py-3 text-[11px] uppercase tracking-[0.2em] hover:bg-oxblood hover:border-oxblood transition-colors cursor-pointer"
      >
        Oke
      </button>
    </div>
  </div>
</div>

<style>
  #confirm-overlay.is-open {
    animation: confirm-overlay-in 0.2s ease-out both;
  }

  #confirm-overlay.is-open #confirm-dialog {
    animation: confirm-dialog-in 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes confirm-overlay-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes confirm-dialog-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  type ConfirmTone = 'default' | 'danger';

  interface ConfirmOptions {
    title?: string;
    message: string;
    eyebrow?: string;
    confirmLabel?: string;
    cancelLabel?: string;
    tone?: ConfirmTone;
  }

  declare global {
    interface Window {
      showConfirm: (options: ConfirmOptions) => Promise<boolean>;
    }
  }

  const overlay = document.getElementById('confirm-overlay');
  const dialog = document.getElementById('confirm-dialog');
  const iconBox = document.getElementById('confirm-icon');
  const defaultIcon = document.querySelector('[data-confirm-icon="default"]');
  const dangerIcon = document.querySelector('[data-confirm-icon="danger"]');
  const eyebrowEl = document.getElementById('confirm-eyebrow');
  const titleEl = document.getElementById('confirm-title');
  const messageEl = document.getElementById('confirm-message');
  const okBtn = document.getElementById('confirm-ok') as HTMLButtonElement | null;
  const cancelBtn = document.getElementById('confirm-cancel') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('confirm-close');

  let activeResolve: ((value: boolean) => void) | null = null;
  let previousFocus: HTMLElement | null = null;
  let previousOverflow = '';

  function closeConfirm(result: boolean) {
    if (!overlay || overlay.classList.contains('hidden')) return;

    overlay.classList.add('hidden');
    overlay.classList.remove('flex', 'is-open');
    document.documentElement.style.overflow = previousOverflow;
    document.removeEventListener('keydown', onKeyDown);

    const resolve = activeResolve;
    activeResolve = null;

    if (previousFocus && typeof previousFocus.focus === 'function') {
      previousFocus.focus();
    }
    previousFocus = null;

    if (resolve) resolve(result);
  }

  function onKeyDown(event: KeyboardEvent) {
    if (event.key === 'Escape') {
      event.preventDefault();
      closeConfirm(false);
    }
  }

  window.showConfirm = function (options: ConfirmOptions): Promise<boolean> {
    if (!overlay || !dialog || !iconBox || !eyebrowEl || !titleEl || !messageEl || !okBtn || !cancelBtn) {
      return Promise.resolve(false);
    }

    // Jika ada dialog lain yang masih terbuka, anggap dibatalkan.
    if (activeResolve) closeConfirm(false);

    const tone: ConfirmTone = options.tone === 'danger' ? 'danger' : 'default';

    eyebrowEl.textContent = options.eyebrow || 'Konfirmasi';
    titleEl.textContent = options.title || 'Konfirmasi';
    messageEl.textContent = options.message || '';
    okBtn.textContent = options.confirmLabel || 'Oke';
    cancelBtn.textContent = options.cancelLabel || 'Batal';

    iconBox.classList.toggle('border-oxblood/30', tone === 'danger');
    iconBox.classList.toggle('text-oxblood', tone === 'danger');
    iconBox.classList.toggle('border-line', tone !== 'danger');
    iconBox.classList.toggle('text-ink', tone !== 'danger');

    defaultIcon?.classList.toggle('hidden', tone === 'danger');
    dangerIcon?.classList.toggle('hidden', tone !== 'danger');

    previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    previousOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';

    overlay.classList.remove('hidden');
    overlay.classList.add('flex', 'is-open');
    document.addEventListener('keydown', onKeyDown);

    return new Promise<boolean>((resolve) => {
      activeResolve = resolve;

      // Untuk aksi destruktif, fokus ke Batal agar tidak tidak sengaja terhapus.
      window.requestAnimationFrame(() => {
        (tone === 'danger' ? cancelBtn : okBtn)?.focus();
      });
    });
  };

  okBtn?.addEventListener('click', () => closeConfirm(true));
  cancelBtn?.addEventListener('click', () => closeConfirm(false));
  closeBtn?.addEventListener('click', () => closeConfirm(false));

  overlay?.addEventListener('click', (event) => {
    if (event.target === overlay) closeConfirm(false);
  });
</script>
