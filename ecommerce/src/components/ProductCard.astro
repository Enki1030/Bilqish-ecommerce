---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---
<div 
  class="product-card group relative bg-white flex flex-col hover:-translate-y-1 transition-transform duration-500 cursor-pointer" 
  data-category={product.category} 
  data-model={product.model} 
  data-sizes={JSON.stringify(product.sizes)}
  onclick={`if (!event.target.closest('.favorite-btn')) window.location.href='/product/${product.id}'`}
>
  <!-- Favorite Button (Independent Overlay) -->
  <button 
    data-product-id={product.id} 
    data-product-name={product.name} 
    data-product-price={product.price} 
    data-product-image={product.image} 
    class="favorite-btn absolute top-3 right-3 p-2 bg-white/80 hover:bg-white text-gray-400 hover:text-primary transition-all z-20 focus:outline-none rounded-full shadow-2xs"
    onclick="event.stopPropagation()"
  >
    <svg class="w-5 h-5 fill-current transition-colors heart-icon" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
  </button>

  <!-- Image -->
  <a href={`/product/${product.id}`} class="block relative bg-gray-100 aspect-[4/5] overflow-hidden flex items-center justify-center">
    <img src={product.image} alt={product.name} class="w-full h-full object-center object-cover mix-blend-multiply group-hover:scale-105 transition-transform duration-700 ease-out" />
  </a>
  
  <!-- Info -->
  <div class="pt-5 pb-3 flex flex-col flex-1 text-center">
    <a href={`/product/${product.id}`} class="block group-hover:text-primary transition-colors">
      <h3 class="text-base font-heading font-normal text-gray-900 tracking-widest uppercase mb-2" title={product.name}>
        {product.name}
      </h3>
      <p class="text-xl font-body font-medium text-gray-900 mb-6">Rp {product.price.toLocaleString('id-ID')}</p>
    </a>
    
    <div class="mt-auto">
      <a 
        href={`/product/${product.id}`}
        class="block w-full bg-white border border-gray-900 text-gray-900 text-xs font-button font-medium uppercase tracking-widest px-4 py-3 hover:bg-gray-900 hover:text-white transition-colors text-center"
      >
        View Details
      </a>
    </div>
  </div>
</div>
