---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<!--
  LOGIC WAJIB YANG TIDAK BOLEH DIUBAH:
  - class "product-card"
  - onclick guard ".favorite-btn" -> window.location.href='/product/{id}'
  - class "favorite-btn" + atribut data-product-id/name/price/image
  - class "heart-icon" (index.astro men-toggle text-red-500 / fill-red-500)
  - atribut data-category, data-model, data-sizes
-->
<div
  class="product-card group relative flex flex-col cursor-pointer"
  data-category={product.category}
  data-model={product.model}
  data-sizes={JSON.stringify(product.sizes)}
  onclick={`if (!event.target.closest('.favorite-btn')) window.location.href='/product/${product.id}'`}
>
  {/* Tombol hati — lingkaran di pojok kanan atas foto */}
  <button
    data-product-id={product.id}
    data-product-name={product.name}
    data-product-price={product.price}
    data-product-image={product.image}
    class="favorite-btn absolute top-3.5 right-3.5 z-20 w-9 h-9 rounded-full bg-ivory/85 backdrop-blur-sm border border-ink/15 flex items-center justify-center text-ink/50 cursor-pointer transition-all duration-300 hover:border-oxblood focus:outline-none"
    onclick="event.stopPropagation()"
    aria-label="Simpan ke wishlist"
  >
    <svg class="w-[15px] h-[15px] fill-current transition-colors heart-icon" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
  </button>

  {/* Fotografi portrait 4:5 — tanpa kartu/kotak, langsung di atas background */}
  <div class="relative w-full aspect-[4/5] bg-bone overflow-hidden border border-bone">
    {product.image ? (
      <img
        src={product.image}
        alt={product.name}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1200ms] ease-out"
      />
    ) : (
      <div class="w-full h-full bg-bone flex flex-col items-center justify-center text-ink/40">
        <svg class="w-10 h-10 mb-2 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        <span class="text-[10px] uppercase tracking-[0.2em]">Gambar Produk</span>
      </div>
    )}
  </div>

  {/* Informasi minimal: nama + harga, langsung di atas background */}
  <div class="pt-5 flex flex-col">
    <h3 class="display-font text-[20px] leading-snug text-ink line-clamp-1 group-hover:underline" title={product.name}>
      {product.name}
    </h3>
    <p class="text-[17px] font-semibold text-ink mt-3">
      Rp {product.price.toLocaleString('id-ID')}
    </p>
  </div>
</div>