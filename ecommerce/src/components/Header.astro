---
---
<header class="bg-white border-b border-gray-100 py-3.5 sm:py-4 sticky top-0 z-50 shadow-2xs">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center gap-4 sm:gap-8">
      
      {/* Mobile Hamburger & Logo */}
      <div class="flex items-center gap-3">
        <button 
          id="mobile-menu-toggle-btn" 
          class="lg:hidden p-2 -ml-1 text-gray-700 hover:text-gray-900 rounded-lg hover:bg-gray-100 transition-colors"
          aria-label="Buka Navigasi"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <a href="/" class="text-xl sm:text-2xl font-heading font-bold text-primary tracking-widest uppercase">
          BALL<span class="text-gray-900">QISH</span>
        </a>
      </div>
      
      {/* Navigation Links (Desktop) */}
      <nav class="hidden lg:flex items-center space-x-8">
        <a href="/" class="text-sm font-medium text-gray-900 hover:text-primary transition-colors uppercase tracking-widest border-b-2 border-transparent hover:border-primary">Shop</a>
        <a href="/blog" class="text-sm font-medium text-gray-500 hover:text-primary transition-colors uppercase tracking-widest border-b-2 border-transparent hover:border-primary">Blog</a>
        <a href="#about" class="text-sm font-medium text-gray-500 hover:text-primary transition-colors uppercase tracking-widest border-b-2 border-transparent hover:border-primary">About</a>
        <a href="#contact" class="text-sm font-medium text-gray-500 hover:text-primary transition-colors uppercase tracking-widest border-b-2 border-transparent hover:border-primary">Contact</a>
      </nav>

      {/* Search (Desktop & Tablet) */}
      <div class="flex-1 max-w-sm hidden md:block ml-auto">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <input type="text" class="block w-full pl-10 pr-4 py-2 border border-gray-200 text-sm bg-transparent placeholder-gray-400 focus:outline-none focus:border-primary transition-colors" placeholder="Cari sepatu...">
        </div>
      </div>

      {/* Right Icons */}
      <div class="flex items-center space-x-2 sm:space-x-6">
        {/* Desktop Only: Orders & Favorites */}
        <button id="orders-btn" title="Cek Pesanan" class="hidden lg:flex p-2 text-gray-600 hover:text-primary items-center gap-2 text-sm font-medium transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
        </button>
        <button id="favorites-btn" title="Favorit Saya" class="hidden lg:flex p-2 text-gray-600 hover:text-primary items-center gap-2 text-sm font-medium transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
        </button>

        {/* Cart Button (Always visible on mobile & desktop) */}
        <button id="cart-button" title="Keranjang Belanja" class="p-2 relative text-gray-600 hover:text-primary flex items-center gap-2 text-sm font-medium transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
          <span id="cart-count" class="absolute top-0.5 right-0.5 inline-flex items-center justify-center w-4 h-4 text-[10px] font-bold text-white bg-primary rounded-full hidden">0</span>
        </button>

        {/* Mobile-Only Auth Action (Clean Login / Logout text button on the right edge) */}
        <div class="lg:hidden ml-1">
          <a 
            href="/login" 
            id="mobile-login-link" 
            class="text-[11px] font-heading font-semibold text-gray-900 hover:text-primary uppercase tracking-wider py-1.5 px-3 border border-gray-300 rounded-lg transition-colors hidden"
          >
            Login
          </a>
          <button 
            id="mobile-logout-btn" 
            class="text-[11px] font-heading font-semibold text-rose-600 hover:text-rose-700 uppercase tracking-wider py-1.5 px-3 bg-rose-50 border border-rose-200 rounded-lg transition-colors hidden cursor-pointer"
          >
            Logout
          </button>
        </div>

        {/* Desktop-Only Auth Container (Profile Box + Logout) */}
        <div id="auth-container" class="hidden lg:block relative ml-2 border-l border-gray-200 pl-4">
          <a href="/login" id="login-link" class="text-xs font-heading font-semibold text-gray-900 hover:text-primary uppercase tracking-wider transition-colors hidden">
            Login
          </a>
          <div id="user-menu" class="hidden flex items-center gap-3">
            <div class="h-8 w-8 bg-gray-100 border border-gray-200 rounded-full overflow-hidden flex-shrink-0 cursor-pointer">
              <img id="user-avatar" src="https://ui-avatars.com/api/?name=User&background=random" alt="Profile" class="w-full h-full object-cover">
            </div>
            <button id="logout-btn" class="text-xs font-heading font-semibold text-gray-500 hover:text-primary uppercase tracking-wider transition-colors cursor-pointer">
              Logout
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Mobile Navigation Drawer */}
  <div id="mobile-nav-backdrop" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 hidden transition-opacity lg:hidden"></div>
  <div id="mobile-nav-drawer" class="fixed top-0 bottom-0 left-0 w-[290px] bg-white z-50 shadow-2xl flex flex-col -translate-x-full transition-transform duration-300 ease-in-out lg:hidden">
    {/* Drawer Header */}
    <div class="h-16 flex items-center justify-between px-6 border-b border-gray-100">
      <span class="text-lg font-heading font-bold text-primary tracking-widest uppercase">
        BALL<span class="text-gray-900">QISH</span>
      </span>
      <button id="mobile-nav-close-btn" class="p-2 text-gray-500 hover:text-gray-900 rounded-lg hover:bg-gray-100 transition-colors" aria-label="Tutup Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    {/* Drawer Body */}
    <div class="flex-1 py-5 px-6 space-y-4 overflow-y-auto">
      {/* Profile Box Inside Drawer (Cleanly integrated without cluttering the navbar) */}
      <div id="drawer-user-profile" class="hidden p-3.5 bg-gray-50 border border-gray-200/70 rounded-2xl items-center gap-3">
        <div class="h-10 w-10 bg-white border border-gray-200 rounded-full overflow-hidden flex-shrink-0 shadow-2xs">
          <img id="drawer-user-avatar" src="https://ui-avatars.com/api/?name=User&background=random" alt="Profile" class="w-full h-full object-cover">
        </div>
        <div class="min-w-0 flex-1">
          <p id="drawer-user-email" class="text-xs font-semibold text-gray-900 truncate">user@email.com</p>
          <span class="text-[10px] text-emerald-700 font-medium">Akun Pelanggan Aktif</span>
        </div>
      </div>

      <div id="drawer-guest-login" class="hidden">
        <a href="/login" class="block w-full py-2.5 px-4 bg-gray-900 text-white text-xs font-heading font-semibold uppercase tracking-wider text-center rounded-xl hover:bg-gray-800 transition-colors">
          Masuk / Daftar Akun
        </a>
      </div>

      <div class="space-y-3 pt-2">
        <a href="/" class="block text-sm font-semibold text-gray-900 hover:text-primary tracking-wide">Koleksi Sepatu</a>
        <a href="/blog" class="block text-sm font-semibold text-gray-700 hover:text-primary tracking-wide">Blog & Cerita</a>
        <a href="#about" class="block text-sm font-semibold text-gray-700 hover:text-primary tracking-wide">Tentang Ballqish</a>
        <a href="#contact" class="block text-sm font-semibold text-gray-700 hover:text-primary tracking-wide">Kontak Kami</a>
      </div>
      
      <hr class="border-gray-100 my-3" />

      {/* Moved from Mobile Navbar into Drawer */}
      <div class="space-y-1">
        <button id="mobile-drawer-orders-btn" class="w-full text-left flex items-center gap-3 text-sm font-medium text-gray-700 hover:text-primary py-2.5 transition-colors cursor-pointer">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
          Lacak Pesanan Saya
        </button>
        <button id="mobile-drawer-fav-btn" class="w-full text-left flex items-center gap-3 text-sm font-medium text-gray-700 hover:text-primary py-2.5 transition-colors cursor-pointer">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
          Sepatu Favorit
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  import { supabase } from '../lib/supabase';

  // Desktop Auth Elements
  const loginLink = document.getElementById('login-link');
  const userMenu = document.getElementById('user-menu');
  const userAvatar = document.getElementById('user-avatar') as HTMLImageElement;
  const logoutBtn = document.getElementById('logout-btn');

  // Mobile Auth Elements
  const mobileLoginLink = document.getElementById('mobile-login-link');
  const mobileLogoutBtn = document.getElementById('mobile-logout-btn');
  const drawerUserProfile = document.getElementById('drawer-user-profile');
  const drawerGuestLogin = document.getElementById('drawer-guest-login');
  const drawerUserAvatar = document.getElementById('drawer-user-avatar') as HTMLImageElement;
  const drawerUserEmail = document.getElementById('drawer-user-email');

  async function checkAuth() {
    const { data: { session } } = await supabase.auth.getSession();
    
    if (session) {
      // Logged in State
      const email = session.user.email || 'User';
      const avatarUrl = `https://ui-avatars.com/api/?name=${encodeURIComponent(email)}&background=111827&color=fff`;

      // Desktop
      if (loginLink) loginLink.classList.add('hidden');
      if (userMenu) {
        userMenu.classList.remove('hidden');
        userMenu.classList.add('flex');
      }
      if (userAvatar) userAvatar.src = avatarUrl;

      // Mobile Navbar: Show clean Logout button
      if (mobileLoginLink) mobileLoginLink.classList.add('hidden');
      if (mobileLogoutBtn) mobileLogoutBtn.classList.remove('hidden');

      // Mobile Drawer: Show rich User Profile Card
      if (drawerGuestLogin) drawerGuestLogin.classList.add('hidden');
      if (drawerUserProfile) {
        drawerUserProfile.classList.remove('hidden');
        drawerUserProfile.classList.add('flex');
      }
      if (drawerUserAvatar) drawerUserAvatar.src = avatarUrl;
      if (drawerUserEmail) drawerUserEmail.textContent = email;

    } else {
      // Guest State (Not Logged In)
      // Desktop
      if (loginLink) loginLink.classList.remove('hidden');
      if (userMenu) {
        userMenu.classList.add('hidden');
        userMenu.classList.remove('flex');
      }

      // Mobile Navbar: Show clean Login button
      if (mobileLoginLink) mobileLoginLink.classList.remove('hidden');
      if (mobileLogoutBtn) mobileLogoutBtn.classList.add('hidden');

      // Mobile Drawer: Show Guest Login Card
      if (drawerGuestLogin) drawerGuestLogin.classList.remove('hidden');
      if (drawerUserProfile) {
        drawerUserProfile.classList.add('hidden');
        drawerUserProfile.classList.remove('flex');
      }
    }
  }

  // Initial check
  checkAuth();

  // Listen for changes
  supabase.auth.onAuthStateChange((event) => {
    if (event === 'SIGNED_IN' || event === 'SIGNED_OUT') {
      checkAuth();
    }
  });

  const performLogout = async () => {
    await supabase.auth.signOut();
    window.location.reload();
  };

  logoutBtn?.addEventListener('click', performLogout);
  mobileLogoutBtn?.addEventListener('click', performLogout);

  // Global Cart Count Logic
  function updateCartCountGlobal() {
    const cartCountEl = document.getElementById('cart-count');
    if (!cartCountEl) return;
    
    let cart = [];
    try {
      const c = localStorage.getItem('ballqish_cart');
      if (c) cart = JSON.parse(c);
    } catch(e) {}
    
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    
    if (totalItems > 0) {
      cartCountEl.textContent = totalItems.toString();
      cartCountEl.classList.remove('hidden');
    } else {
      cartCountEl.classList.add('hidden');
    }
  }

  updateCartCountGlobal();
  window.addEventListener('cartUpdated', updateCartCountGlobal);

  // Global Navigation for Modals
  const triggerCart = document.getElementById('cart-button');
  const triggerFav = document.getElementById('favorites-btn');
  const triggerOrder = document.getElementById('orders-btn');

  function handleModalNavigation(param) {
    if (window.location.pathname !== '/') {
      window.location.href = `/?${param}=true`;
    }
  }

  triggerCart?.addEventListener('click', () => handleModalNavigation('openCart'));
  triggerFav?.addEventListener('click', () => handleModalNavigation('openFav'));
  triggerOrder?.addEventListener('click', () => handleModalNavigation('openOrders'));

  // Mobile Drawer Toggle Logic
  const mobileToggleBtn = document.getElementById('mobile-menu-toggle-btn');
  const mobileBackdrop = document.getElementById('mobile-nav-backdrop');
  const mobileDrawer = document.getElementById('mobile-nav-drawer');
  const mobileCloseBtn = document.getElementById('mobile-nav-close-btn');
  const mobileDrawerOrders = document.getElementById('mobile-drawer-orders-btn');
  const mobileDrawerFav = document.getElementById('mobile-drawer-fav-btn');

  function openMobileMenu() {
    mobileBackdrop?.classList.remove('hidden');
    mobileDrawer?.classList.remove('-translate-x-full');
    mobileDrawer?.classList.add('translate-x-0');
  }

  function closeMobileMenu() {
    mobileBackdrop?.classList.add('hidden');
    mobileDrawer?.classList.remove('translate-x-0');
    mobileDrawer?.classList.add('-translate-x-full');
  }

  mobileToggleBtn?.addEventListener('click', openMobileMenu);
  mobileBackdrop?.addEventListener('click', closeMobileMenu);
  mobileCloseBtn?.addEventListener('click', closeMobileMenu);

  mobileDrawerOrders?.addEventListener('click', () => {
    closeMobileMenu();
    handleModalNavigation('openOrders');
  });

  mobileDrawerFav?.addEventListener('click', () => {
    closeMobileMenu();
    handleModalNavigation('openFav');
  });
</script>
