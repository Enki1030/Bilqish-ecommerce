---
interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
---

<header
  id="main-header"
  data-theme="editorial"
  class={`w-full top-0 z-[100] transition-all duration-300 border-b border-line ${transparent ? 'fixed bg-transparent border-transparent is-transparent' : 'sticky bg-ivory/90 backdrop-blur-md'}`}
>
  <div class="max-w-[1400px] mx-auto px-6 md:px-10 h-20 grid grid-cols-[auto_1fr_auto] md:grid-cols-[1fr_auto_1fr] items-center gap-4">

    {/* ================= LEFT: Mobile Toggle + Navigation Links ================= */}
    <div class="flex items-center gap-3 lg:gap-9">
      <button
        id="mobile-menu-toggle-btn"
        class="lg:hidden -ml-2 p-2 text-ink hover:text-oxblood transition-colors"
        aria-label="Buka Navigasi"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <nav class="hidden lg:flex items-center gap-6 xl:gap-8">
        <a href="/" class="nav-link nav-link-active">Beranda</a>
        <a href="#collection" class="nav-link">Koleksi Sepatu</a>
        <a href="#b2b" class="nav-link">
          <span class="inline-block w-1 h-1 rounded-full bg-oxblood align-middle mr-1.5"></span>Grosir &amp; B2B
        </a>
        <a href="/blog" class="nav-link">Blog</a>
        <a href="#about" class="nav-link">Tentang Kami</a>
      </nav>
    </div>

    {/* ================= CENTER: Brand Logo ================= */}
    <a href="/" class="text-center leading-none select-none">
      <span class="display-font block text-[17px] md:text-[20px] tracking-[0.3em] text-ink pl-[0.3em]">BALLQISH</span>
      <span class="block text-[8px] md:text-[9px] font-medium tracking-[0.3em] text-ink/50 uppercase mt-[6px] pl-[0.3em]">Pantofel Mewah</span>
    </a>

    {/* ================= RIGHT: Search + Utility Actions ================= */}
    <div class="flex items-center justify-end gap-5 lg:gap-6">

      {/* Search (Desktop & Tablet) */}
      <div class="relative hidden md:block">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
          <svg class="h-4 w-4 text-ink/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <input type="text" class="block w-[190px] xl:w-[230px] pl-9 pr-3 py-2 bg-transparent border border-line text-[13px] text-ink placeholder-ink/40 placeholder:text-[13px] focus:outline-none focus:border-ink transition-colors" placeholder="Cari sepatu...">
      </div>

      {/* Orders (Desktop Only) */}
      <button id="orders-btn" title="Cek Pesanan" class="hidden lg:flex p-1.5 text-ink hover:text-oxblood transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
      </button>

      {/* Favorites / Wishlist */}
      <button id="favorites-btn" title="Favorit Saya" class="relative p-1.5 text-ink hover:text-oxblood transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
        <span id="favorites-count" class="absolute top-0 right-0 min-w-[15px] h-[15px] px-[3px] inline-flex items-center justify-center text-[9px] font-medium text-ivory bg-oxblood rounded-full hidden">0</span>
      </button>

      {/* Cart */}
      <button id="cart-button" title="Keranjang Belanja" class="relative p-1.5 text-ink hover:text-oxblood transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        <span id="cart-count" class="absolute top-0 right-0 min-w-[15px] h-[15px] px-[3px] inline-flex items-center justify-center text-[9px] font-medium text-ivory bg-oxblood rounded-full hidden">0</span>
      </button>

      {/* Mobile Auth */}
      <div class="lg:hidden">
        <a
          href="/login"
          id="mobile-login-link"
          class="text-[11px] font-semibold text-ink hover:text-oxblood uppercase tracking-wider transition-colors hidden"
        >
          Masuk
        </a>
        <button
          id="mobile-logout-btn"
          class="text-[11px] font-semibold text-ink hover:text-oxblood uppercase tracking-wider transition-colors hidden cursor-pointer"
        >
          Keluar
        </button>
      </div>

      {/* Desktop Auth */}
      <div id="auth-container" class="hidden lg:block relative pl-5 border-l border-line">
        <a href="/login" id="login-link" class="text-[11px] font-semibold text-ink hover:text-oxblood uppercase tracking-wider transition-colors hidden">
          Masuk
        </a>
        <div id="user-menu" class="hidden items-center gap-4">
          <button id="desktop-address-btn" title="Buku Alamat Saya" class="p-1.5 text-ink hover:text-oxblood transition-colors cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </button>
          <div class="h-8 w-8 bg-bone border border-line rounded-full overflow-hidden flex-shrink-0 cursor-pointer">
            <img id="user-avatar" src="https://ui-avatars.com/api/?name=User&background=random" alt="Profile" class="w-full h-full object-cover">
          </div>
          <button id="logout-btn" class="text-[11px] font-semibold text-ink/50 hover:text-ink uppercase tracking-wider transition-colors cursor-pointer">
            Keluar
          </button>
        </div>
      </div>
    </div>
  </div>

  {/* Mobile Navigation Drawer */}
  <div id="mobile-nav-backdrop" data-theme="editorial" class="fixed inset-0 bg-ink/40 backdrop-blur-sm z-50 hidden transition-opacity lg:hidden"></div>
  <div id="mobile-nav-drawer" data-theme="editorial" class="fixed top-0 bottom-0 left-0 w-[290px] bg-ivory z-50 flex flex-col -translate-x-full transition-transform duration-300 ease-in-out lg:hidden">
    {/* Drawer Header */}
    <div class="h-16 flex items-center justify-between px-6 border-b border-line">
      <span class="display-font text-[17px] tracking-[0.3em] text-ink pl-[0.3em]">BALL<span class="text-brass">QISH</span></span>
      <button id="mobile-nav-close-btn" class="p-2 text-ink hover:text-oxblood transition-colors" aria-label="Tutup Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    {/* Drawer Body */}
    <div class="flex-1 py-5 px-6 space-y-4 overflow-y-auto">

      {/* Profile Box Inside Drawer */}
      <div id="drawer-user-profile" class="hidden items-center gap-3.5 bg-white border border-line p-4">
        <div class="h-10 w-10 bg-bone border border-line rounded-full overflow-hidden flex-shrink-0">
          <img id="drawer-user-avatar" src="https://ui-avatars.com/api/?name=User&background=random" alt="Profile" class="w-full h-full object-cover">
        </div>
        <div class="min-w-0 flex-1">
          <p id="drawer-user-email" class="text-[13px] text-ink truncate">user@email.com</p>
          <span class="block text-[10px] uppercase tracking-[0.2em] text-ink/45 mt-1">Akun Pelanggan Aktif</span>
        </div>
      </div>

      <div id="drawer-guest-login" class="hidden bg-white border border-line p-4">
        <p class="text-[10px] uppercase tracking-[0.2em] text-ink/45 mb-3">Belum masuk</p>
        <a href="/login" class="block w-full bg-ink text-ivory text-[10px] uppercase tracking-[0.25em] text-center py-3.5 transition-colors hover:bg-oxblood">
          Masuk / Daftar Akun
        </a>
      </div>

      <div class="space-y-3 pt-2">
        <a href="/" class="block text-sm font-medium text-ink hover:text-oxblood transition-colors">Beranda</a>
        <a href="#collection" class="block text-sm font-medium text-ink/70 hover:text-oxblood transition-colors">Koleksi Sepatu</a>
        <a href="#b2b" class="block text-sm font-medium text-oxblood transition-colors">Grosir &amp; Kerja Sama B2B</a>
        <a href="/blog" class="block text-sm font-medium text-ink/70 hover:text-oxblood transition-colors">Blog &amp; Artikel</a>
        <a href="#about" class="block text-sm font-medium text-ink/70 hover:text-oxblood transition-colors">Tentang Ballqish</a>
      </div>

      <hr class="border-bone my-3" />

      <div class="space-y-1">
        <button id="mobile-drawer-orders-btn" class="w-full text-left flex items-center gap-3 text-sm font-medium text-ink/70 hover:text-oxblood py-2.5 transition-colors cursor-pointer">
          <svg class="w-5 h-5 text-ink/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
          Lacak Pesanan Saya
        </button>
        <button id="mobile-drawer-fav-btn" class="w-full text-left flex items-center gap-3 text-sm font-medium text-ink/70 hover:text-oxblood py-2.5 transition-colors cursor-pointer">
          <svg class="w-5 h-5 text-ink/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
          Sepatu Favorit
        </button>
        <button id="mobile-drawer-address-btn" class="w-full text-left flex items-center gap-3 text-sm font-medium text-ink/70 hover:text-oxblood py-2.5 transition-colors cursor-pointer">
          <svg class="w-5 h-5 text-ink/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          Buku Alamat Saya
        </button>
      </div>
    </div>
  </div>

  {/* FLOATING CUSTOMER SERVICE WHATSAPP BUTTON (ALWAYS ON SCREEN) */}
  <a
    href="https://wa.me/6281234567890?text=Halo%20Admin%20Ballqish,%20saya%20ingin%20tanya%20mengenai%20produk%20sepatu%20pantofel%20atau%20kerjasama%20grosir"
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-6 right-6 z-50 flex items-center gap-2.5 bg-ink text-ivory text-[11px] uppercase tracking-[0.2em] px-5 py-3.5 rounded-full hover:bg-oxblood hover:scale-105 active:scale-95 transition-all duration-300 group"
    title="Hubungi Customer Service WhatsApp"
  >
    <div class="relative flex items-center justify-center">
      <span class="absolute inline-flex h-full w-full rounded-full bg-oxblood opacity-60 animate-ping"></span>
      <svg class="w-5 h-5 relative z-10 fill-current" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
    </div>
    <span class="block sm:hidden text-[11px] uppercase tracking-[0.2em] text-ink">Tanya CS Ballqish</span>
  </a>
</header>

<script>
  import { supabase } from '../lib/supabase';

  // Desktop Auth Elements
  const loginLink = document.getElementById('login-link');
  const userMenu = document.getElementById('user-menu');
  const userAvatar = document.getElementById('user-avatar') as HTMLImageElement;
  const logoutBtn = document.getElementById('logout-btn');

  // Mobile Auth Elements
  const mobileLoginLink = document.getElementById('mobile-login-link');
  const mobileLogoutBtn = document.getElementById('mobile-logout-btn');
  const drawerUserProfile = document.getElementById('drawer-user-profile');
  const drawerGuestLogin = document.getElementById('drawer-guest-login');
  const drawerUserAvatar = document.getElementById('drawer-user-avatar') as HTMLImageElement;
  const drawerUserEmail = document.getElementById('drawer-user-email');

  function addReturnPathToLoginLinks() {
    const returnPath = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    const loginUrl = `/login?redirect=${encodeURIComponent(returnPath)}`;
    document.querySelectorAll('a[href="/login"]').forEach(link => {
      link.setAttribute('href', loginUrl);
    });
  }

  async function checkAuth() {
    const { data: { session } } = await supabase.auth.getSession();

    if (session) {
      // Logged in State
      const email = session.user.email || 'User';
      const avatarUrl = `https://ui-avatars.com/api/?name=${encodeURIComponent(email)}&background=1A1A1A&color=fff`;

      // Desktop
      if (loginLink) loginLink.classList.add('hidden');
      if (userMenu) {
        userMenu.classList.remove('hidden');
        userMenu.classList.add('flex');
      }
      if (userAvatar) userAvatar.src = avatarUrl;

      // Mobile Navbar: Show clean Logout button
      if (mobileLoginLink) mobileLoginLink.classList.add('hidden');
      if (mobileLogoutBtn) mobileLogoutBtn.classList.remove('hidden');

      // Mobile Drawer: Show rich User Profile Card
      if (drawerGuestLogin) drawerGuestLogin.classList.add('hidden');
      if (drawerUserProfile) {
        drawerUserProfile.classList.remove('hidden');
        drawerUserProfile.classList.add('flex');
      }
      if (drawerUserAvatar) drawerUserAvatar.src = avatarUrl;
      if (drawerUserEmail) drawerUserEmail.textContent = email;

    } else {
      // Guest State (Not Logged In)
      // Desktop
      if (loginLink) loginLink.classList.remove('hidden');
      if (userMenu) {
        userMenu.classList.add('hidden');
        userMenu.classList.remove('flex');
      }

      // Mobile Navbar: Show clean Login button
      if (mobileLoginLink) mobileLoginLink.classList.remove('hidden');
      if (mobileLogoutBtn) mobileLogoutBtn.classList.add('hidden');

      // Mobile Drawer: Show Guest Login Card
      if (drawerGuestLogin) drawerGuestLogin.classList.remove('hidden');
      if (drawerUserProfile) {
        drawerUserProfile.classList.add('hidden');
        drawerUserProfile.classList.remove('flex');
      }
    }
  }

  // Initial check
  addReturnPathToLoginLinks();
  checkAuth();

  // Listen for changes
  supabase.auth.onAuthStateChange((event) => {
    if (event === 'SIGNED_IN' || event === 'SIGNED_OUT') {
      checkAuth();
    }
  });

  const performLogout = async () => {
    await supabase.auth.signOut();
    window.location.reload();
  };

  logoutBtn?.addEventListener('click', performLogout);
  mobileLogoutBtn?.addEventListener('click', performLogout);

  // Global Cart Count Logic
  function updateCartCountGlobal() {
    const cartCountEl = document.getElementById('cart-count');
    if (!cartCountEl) return;

    let cart = [];
    try {
      const c = localStorage.getItem('ballqish_cart');
      if (c) cart = JSON.parse(c);
    } catch(e) {}

    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);

    if (totalItems > 0) {
      cartCountEl.textContent = totalItems.toString();
      cartCountEl.classList.remove('hidden');
    } else {
      cartCountEl.classList.add('hidden');
    }
  }

  updateCartCountGlobal();
  window.addEventListener('cartUpdated', updateCartCountGlobal);

  // Wishlist Count Badge (hanya menampilkan jumlah, logika favorit tetap di index.astro)
  function updateFavCountGlobal() {
    const favCountEl = document.getElementById('favorites-count');
    if (!favCountEl) return;

    let favs = [];
    try {
      const f = localStorage.getItem('ballqish_favs');
      if (f) favs = JSON.parse(f);
    } catch(e) {}

    if (Array.isArray(favs) && favs.length > 0) {
      favCountEl.textContent = favs.length.toString();
      favCountEl.classList.remove('hidden');
    } else {
      favCountEl.classList.add('hidden');
    }
  }

  updateFavCountGlobal();
  window.addEventListener('favoritesUpdated', updateFavCountGlobal);

  // Global Navigation for Modals
  const triggerCart = document.getElementById('cart-button');
  const triggerFav = document.getElementById('favorites-btn');
  const triggerOrder = document.getElementById('orders-btn');
  const triggerAddress = document.getElementById('desktop-address-btn');

  function handleModalNavigation(param) {
    if ((window as any).openAddressModal && param === 'openAddress') {
      (window as any).openAddressModal();
      return;
    }
    if (window.location.pathname !== '/') {
      window.location.href = `/?${param}=true`;
    }
  }

  triggerCart?.addEventListener('click', () => handleModalNavigation('openCart'));
  triggerFav?.addEventListener('click', () => handleModalNavigation('openFav'));
  triggerOrder?.addEventListener('click', () => handleModalNavigation('openOrders'));
  triggerAddress?.addEventListener('click', () => handleModalNavigation('openAddress'));

  // Mobile Drawer Toggle Logic
  const mobileToggleBtn = document.getElementById('mobile-menu-toggle-btn');
  const mobileBackdrop = document.getElementById('mobile-nav-backdrop');
  const mobileDrawer = document.getElementById('mobile-nav-drawer');
  const mobileCloseBtn = document.getElementById('mobile-nav-close-btn');
  const mobileDrawerOrders = document.getElementById('mobile-drawer-orders-btn');
  const mobileDrawerFav = document.getElementById('mobile-drawer-fav-btn');
  const mobileDrawerAddress = document.getElementById('mobile-drawer-address-btn');

  function openMobileMenu() {
    mobileBackdrop?.classList.remove('hidden');
    mobileDrawer?.classList.remove('-translate-x-full');
    mobileDrawer?.classList.add('translate-x-0');
  }

  function closeMobileMenu() {
    mobileBackdrop?.classList.add('hidden');
    mobileDrawer?.classList.remove('translate-x-0');
    mobileDrawer?.classList.add('-translate-x-full');
  }

  mobileToggleBtn?.addEventListener('click', openMobileMenu);
  mobileBackdrop?.addEventListener('click', closeMobileMenu);
  mobileCloseBtn?.addEventListener('click', closeMobileMenu);

  mobileDrawerOrders?.addEventListener('click', () => {
    closeMobileMenu();
    handleModalNavigation('openOrders');
  });

  mobileDrawerFav?.addEventListener('click', () => {
    closeMobileMenu();
    handleModalNavigation('openFav');
  });

  mobileDrawerAddress?.addEventListener('click', () => {
    closeMobileMenu();
    handleModalNavigation('openAddress');
  });

  // Header scroll transparency effect
  const header = document.getElementById('main-header');
  if (header && header.classList.contains('is-transparent')) {
    const handleScroll = () => {
      if (window.scrollY > 60) {
        header.classList.remove('is-transparent', 'bg-transparent', 'border-transparent');
        header.classList.add('bg-ivory', 'border-line', 'backdrop-blur-md');
      } else {
        header.classList.add('is-transparent', 'bg-transparent', 'border-transparent');
        header.classList.remove('bg-ivory', 'border-line', 'backdrop-blur-md');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }
</script>

<style is:global>
  /* Navigation link typography — Editorial Luxury */
  /* Navigation link — disamakan dengan tipografi tombol:
     Manrope 11px / 400 / uppercase, hanya letter-spacing diperkecil
     (0.18em vs 0.3em pada tombol) agar seluruh menu muat satu baris. */
  #main-header .nav-link {
    font-size: 11px;
    font-weight: 400;
    text-transform: uppercase;
    color: #1a1512;
    letter-spacing: 0.18em;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: color 0.3s ease, border-color 0.3s ease;
    white-space: nowrap;
  }
  #main-header .nav-link:hover {
    color: #5a1a1c;
    border-bottom-color: #5a1a1c;
  }
  #main-header .nav-link-active {
    font-weight: 600;
    border-bottom-color: #1a1512;
  }

  /* Transparent mode: hero berlatar Ivory, jadi teks tetap gelap (bukan putih) */
  #main-header.is-transparent .nav-link,
  #main-header.is-transparent .nav-link-active {
    color: #1a1512 !important;
    border-bottom-color: transparent !important;
  }
  #main-header.is-transparent .nav-link-active {
    border-bottom-color: #1a1512 !important;
  }
</style>