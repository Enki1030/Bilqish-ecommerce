---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';
import Footer from '../components/Footer.astro';
import AddressModal from '../components/AddressModal.astro';
import { supabase } from '../lib/supabase';
import { products as defaultProducts } from '../data/products';
import bgPantofel from '../assets/backgroundpantofel.jpg';

let productsData = null;
let latestArticles = [];

try {
  const [prodRes, artRes] = await Promise.all([
    supabase.from('products').select('*').order('created_at', { ascending: false }),
    supabase.from('articles').select('id, title, slug, excerpt, cover_image, created_at').order('created_at', { ascending: false }).limit(3)
  ]);
  productsData = prodRes.data;
  latestArticles = artRes.data || [];
} catch (err) {
  console.error('Error fetching from Supabase:', err);
}

const allProducts = (productsData && productsData.length > 0)
  ? productsData.map(p => ({
      ...p,
      image: p.image_url || p.image
    }))
  : defaultProducts;

// Fallback articles if Supabase is empty
const fallbackArticles = [
  {
    id: '1',
    title: 'Cara Memilih Sepatu Pantofel yang Nyaman untuk Kerja Seharian',
    slug: 'cara-memilih-sepatu-pantofel-nyaman',
    excerpt: 'Panduan lengkap memilih sol dan insole empuk agar kaki tidak pegal saat dipakai bertugas sepanjang hari.',
    cover_image: 'https://images.unsplash.com/photo-1614252209825-96144e1c25fc?q=80&w=600&auto=format&fit=crop',
    created_at: new Date().toISOString()
  },
  {
    id: '2',
    title: 'Perbedaan Sepatu Pantofel Tali vs Tanpa Tali (Loafers)',
    slug: 'perbedaan-pantofel-tali-vs-tanpa-tali',
    excerpt: 'Ketahui kelebihan dan use-case masing-masing model agar sesuai dengan etika busana instansi dan acara Anda.',
    cover_image: 'https://images.unsplash.com/photo-1549298916-b41d501d3772?q=80&w=600&auto=format&fit=crop',
    created_at: new Date().toISOString()
  },
  {
    id: '3',
    title: 'Tips Merawat Sepatu Pantofel Kulit Sintetis PU Agar Awet & Mengkilap',
    slug: 'tips-merawat-sepatu-pantofel-kulit-pu',
    excerpt: 'Langkah praktis pembersihan harian tanpa merusak permukaan sepatu buatan pengrajin Sidoarjo.',
    cover_image: 'https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?q=80&w=600&auto=format&fit=crop',
    created_at: new Date().toISOString()
  }
];

const articlesToShow = latestArticles.length > 0 ? latestArticles : fallbackArticles;
---

<Layout title="Ballqish - Sepatu Pantofel Pria & Wanita Handmade Sidoarjo | Grosir & Eceran">
  <Header />

  <main class="flex-1 bg-[#FAF9F6] text-black font-serif">
    
    {/* SECTION 2: HERO SECTION (High Contrast White Text on Dark Image Banner) */}
    <section class="relative w-full h-[70vh] md:h-[80vh] bg-stone-950 overflow-hidden flex items-end">
      
      {/* Background Image & Overlay */}
      <div class="absolute inset-0 z-0 bg-stone-900">
        <img 
          src={bgPantofel.src} 
          alt="Sepatu Pantofel Ballqish Sidoarjo" 
          class="w-full h-full object-cover object-center mix-blend-overlay opacity-80"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 to-black/30"></div>
      </div>

      {/* Visual Marker */}
      <div class="absolute top-6 right-6 z-10 hidden sm:block">
        <span class="text-xs font-serif text-stone-200 bg-black/70 px-3.5 py-1.5 border border-stone-600 shadow-sm">
          [ Visual Hero Banner ]
        </span>
      </div>

      {/* Bottom Left Overlay Content (CRISP WHITE HIGH CONTRAST) */}
      <div class="relative z-10 max-w-[1400px] mx-auto w-full px-6 sm:px-10 lg:px-16 pb-12 sm:pb-16 text-white font-serif">
        <p class="text-base text-stone-200 mb-2 font-normal">
          Pengrajin Asli Sruni, Sidoarjo
        </p>
        
        {/* SINGLE H1 FOR SEO - CRISP WHITE HIGH CONTRAST */}
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-normal tracking-normal max-w-3xl leading-snug mb-4 text-white drop-shadow-md">
          Sepatu Pantofel Handmade Nyaman & Terjangkau — Langsung dari Pengrajin Sidoarjo
        </h1>

        <p class="text-base sm:text-lg text-stone-100 font-normal max-w-2xl mb-8 leading-relaxed drop-shadow-xs">
          Karya presisi buatan tangan pengrajin lokal dengan sol empuk anti-licin. Diciptakan untuk kenyamanan kerja harian guru, PNS, karyawan, mahasiswa, hingga seragam grosir instansi.
        </p>

        {/* DUAL CTA BUTTONS */}
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 font-serif">
          <a 
            href="#collection" 
            class="inline-block bg-white text-black font-serif text-base font-medium px-8 py-3.5 border border-white hover:bg-stone-100 hover:underline transition-all shadow-md"
          >
            Belanja Sekarang
          </a>
          <a 
            href="#b2b" 
            class="inline-block bg-black/60 text-white font-serif text-base font-medium px-8 py-3.5 border border-white hover:bg-white hover:text-black hover:underline transition-all shadow-md"
          >
            Kerja Sama Grosir / Instansi
          </a>
        </div>
      </div>
    </section>

    {/* SECTION 3: TRUST SIGNAL BAR */}
    <section class="w-full bg-white border-b border-gray-200 py-6 px-6 lg:px-16">
      <div class="max-w-[1400px] mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 text-center font-serif">
        
        <div class="py-2 border-r last:border-r-0 border-gray-200">
          <h3 class="text-base font-semibold text-black">Pengrajin Asli Sidoarjo</h3>
          <p class="text-sm text-gray-700 font-normal mt-1">Desa Sruni, Gedangan</p>
        </div>

        <div class="py-2 border-r last:border-r-0 border-gray-200">
          <h3 class="text-base font-semibold text-black">Ribuan Pasang Terjual</h3>
          <p class="text-sm text-gray-700 font-normal mt-1">Teruji Awet oleh Guru & PNS</p>
        </div>

        <div class="py-2 border-r last:border-r-0 border-gray-200">
          <h3 class="text-base font-semibold text-black">Garansi Tukar Ukuran</h3>
          <p class="text-sm text-gray-700 font-normal mt-1">3 Hari Pasca Barang Sampai</p>
        </div>

        <div class="py-2">
          <h3 class="text-base font-semibold text-black">Grosir & Custom B2B</h3>
          <p class="text-sm text-gray-700 font-normal mt-1">Seragam Instansi & Reseller</p>
        </div>

      </div>
    </section>

    {/* SECTION 4: VISUAL CATEGORIES & CATALOG GRID */}
    <section id="collection" class="py-16 max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 font-serif">
      
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-normal text-black mb-2">Koleksi Sepatu Pantofel</h2>
        <div class="w-12 h-0.5 bg-black mx-auto mb-3"></div>
        <p class="text-sm text-gray-700 font-normal">Pilih model yang paling sesuai dengan aktivitas dan etika busana Anda</p>
      </div>

      {/* 2 Big Editorial Visual Showcase Cards */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        
        {/* Card 1: Tanpa Tali */}
        <div class="group bg-stone-100 border border-gray-200 p-6 flex flex-col justify-between cursor-pointer hover:border-black transition-all">
          <div class="w-full aspect-[16/9] bg-gray-200 mb-5 flex items-center justify-center relative overflow-hidden">
            <img src={bgPantofel.src} alt="Pantofel Tanpa Tali" class="w-full h-full object-cover mix-blend-multiply group-hover:scale-105 transition-transform duration-700" />
            <span class="absolute top-3 left-3 bg-black/75 text-white text-xs px-3 py-1">
              [ Foto Model: Tanpa Tali ]
            </span>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-black mb-2 group-hover:underline">Tanpa Tali (Loafers / Slip-On)</h3>
            <p class="text-sm text-gray-700 font-normal leading-relaxed mb-4">Praktis dilepas-pasang, sol empuk ringan, ideal untuk guru & PNS bertugas harian.</p>
            <button data-filter-category="tanpa-tali" class="category-filter-shortcut text-sm text-black underline font-normal hover:text-[#5c1616]">
              Lihat Model Tanpa Tali →
            </button>
          </div>
        </div>

        {/* Card 2: Dengan Tali */}
        <div class="group bg-stone-100 border border-gray-200 p-6 flex flex-col justify-between cursor-pointer hover:border-black transition-all">
          <div class="w-full aspect-[16/9] bg-gray-200 mb-5 flex items-center justify-center relative overflow-hidden">
            <img src={bgPantofel.src} alt="Pantofel Dengan Tali" class="w-full h-full object-cover mix-blend-multiply group-hover:scale-105 transition-transform duration-700" />
            <span class="absolute top-3 left-3 bg-black/75 text-white text-xs px-3 py-1">
              [ Foto Model: Dengan Tali ]
            </span>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-black mb-2 group-hover:underline">Dengan Tali (Lace-Up Classic)</h3>
            <p class="text-sm text-gray-700 font-normal leading-relaxed mb-4">Klasik, rapi, dan gagah. Cocok untuk wisuda, sidang skripsi, dan acara formal instansi.</p>
            <button data-filter-category="dengan-tali" class="category-filter-shortcut text-sm text-black underline font-normal hover:text-[#5c1616]">
              Lihat Model Dengan Tali →
            </button>
          </div>
        </div>

      </div>

      {/* Catalog Filter Tabs (Normal Sentence Case with Underline Active/Hover Indicator) */}
      <div class="flex justify-center gap-6 sm:gap-10 mb-10 border-b border-gray-200 pb-3 overflow-x-auto hide-scrollbar font-serif">
        <button
          type="button"
          class="catalog-tab text-base font-semibold text-black border-b-2 border-black pb-2 cursor-pointer transition-colors"
          data-tab="all"
        >
          Semua Koleksi ({allProducts.length})
        </button>
        <button
          type="button"
          class="catalog-tab text-base font-normal text-gray-600 border-b-2 border-transparent hover:text-black hover:border-black pb-2 cursor-pointer transition-colors"
          data-tab="tanpa-tali"
        >
          Tanpa Tali (Slip-on)
        </button>
        <button
          type="button"
          class="catalog-tab text-base font-normal text-gray-600 border-b-2 border-transparent hover:text-black hover:border-black pb-2 cursor-pointer transition-colors"
          data-tab="dengan-tali"
        >
          Dengan Tali (Lace-up)
        </button>
      </div>

      {/* BERLUTI STYLE CATALOG GRID */}
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        {allProducts.map((product) => {
          const isNoLace = product.type === 'Tanpa Tali' || product.model?.toLowerCase().includes('tanpa tali') || product.name?.toLowerCase().includes('slip');
          const categoryTag = isNoLace ? 'tanpa-tali' : 'dengan-tali';
          return (
            <div class="catalog-product-item" data-category={categoryTag}>
              <ProductCard product={product} />
            </div>
          );
        })}
      </div>

    </section>

    {/* SECTION 5: CRAFTSMANSHIP & VALUE PROPOSITION */}
    <section class="py-20 bg-white border-y border-gray-200 font-serif">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          {/* Left Column: Visual Placeholder Image Box */}
          <div class="lg:col-span-6 relative">
            <div class="w-full aspect-[4/3] bg-stone-200 border border-stone-300 relative overflow-hidden flex items-center justify-center">
              <img src={bgPantofel.src} alt="Craftsmanship Sidoarjo" class="w-full h-full object-cover mix-blend-darken" />
              <div class="absolute bottom-3 left-3 bg-white/90 px-3 py-1 text-sm text-black border border-gray-200">
                [ Workshop Pengrajin Sruni, Sidoarjo ]
              </div>
            </div>
          </div>

          {/* Right Column: Editorial Craftsmanship Narrative */}
          <div class="lg:col-span-6 space-y-6">
            <p class="text-sm text-gray-600 font-normal">
              Heritage & Craftsmanship
            </p>
            <h2 class="text-2xl sm:text-4xl font-normal text-black leading-snug">
              Kenapa Memilih Sepatu Pantofel Ballqish?
            </h2>
            <p class="text-base text-gray-800 font-normal leading-relaxed">
              Di balik setiap pasang sepatu pantofel Ballqish terdapat sentuhan tangan pengrajin lokal Desa Sruni, Gedangan, Sidoarjo yang mewariskan keahlian pembuatan sepatu secara turun-temurun.
            </p>

            <div class="space-y-4 pt-2">
              <div class="border-l-2 border-black pl-4">
                <h3 class="text-base font-semibold text-black mb-0.5">Sol Empuk & Anti-Licin</h3>
                <p class="text-sm text-gray-700 leading-relaxed font-normal">Outsole TPR fleksibel dan insole berpori penyerap tekanan untuk kenyamanan berdiri seharian.</p>
              </div>

              <div class="border-l-2 border-black pl-4">
                <h3 class="text-base font-semibold text-black mb-0.5">Harga Langsung Pengrajin</h3>
                <p class="text-sm text-gray-700 leading-relaxed font-normal">Kualitas bahan pilihan tanpa markup distributor perantara.</p>
              </div>

              <div class="border-l-2 border-black pl-4">
                <h3 class="text-base font-semibold text-black mb-0.5">Fleksibel untuk Berbagai Acara</h3>
                <p class="text-sm text-gray-700 leading-relaxed font-normal">Desain serasi untuk mengajar, kantor dinas, sidang skripsi, hingga acara keagamaan.</p>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    {/* SECTION 6: SECTION KHUSUS B2B (GROSIR & INSTANSI - CRISP WHITE TEXT ON DARK) */}
    <section id="b2b" class="py-20 bg-[#2c1810] text-white font-serif relative overflow-hidden">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16 relative z-10">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-7 space-y-5">
            <p class="text-sm text-amber-200 font-normal">
              Fasilitas Grosir & Pengadaan Instansi
            </p>

            <h2 class="text-2xl sm:text-4xl font-normal text-white leading-snug drop-shadow-xs">
              Kerja Sama Grosir, Reseller & Seragam Instansi
            </h2>

            <p class="text-base text-stone-100 font-normal leading-relaxed drop-shadow-xs">
              Ballqish melayani pemesanan sepatu pantofel partai besar langsung dari workshop pengrajin Sidoarjo untuk toko sepatu, instansi pemerintah, sekolah, dan perusahaan.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-stone-100 font-normal pt-2">
              <div class="p-4 bg-white/10 border border-white/20">
                <p class="font-semibold text-white mb-1">Diskon Grosir Khusus</p>
                <p>Minimal order 12 pasang dengan harga langsung pabrik.</p>
              </div>
              <div class="p-4 bg-white/10 border border-white/20">
                <p class="font-semibold text-white mb-1">Custom Logo & Size</p>
                <p>Bisa embossed logo perusahaan/instansi & ukuran khusus.</p>
              </div>
            </div>

            <div class="pt-4">
              <a 
                href="https://wa.me/6281234567890?text=Halo%20Tim%20B2B%20Ballqish,%20saya%20tertarik%20untuk%20kerja%20sama%20grosir%2Fseragam%20instansi" 
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-white text-black font-serif text-base font-medium px-8 py-3.5 border border-white hover:bg-stone-100 hover:underline transition-all shadow-md"
              >
                Hubungi Tim B2B via WhatsApp
              </a>
            </div>
          </div>

          {/* Right Column: Visual Box Placeholder */}
          <div class="lg:col-span-5">
            <div class="w-full aspect-[4/3] bg-stone-900 border border-stone-700 flex flex-col items-center justify-center p-6 text-center">
              <span class="text-sm text-amber-200 mb-2 font-semibold">[ Gambar Workshop Produksi Grosir ]</span>
              <p class="text-xs text-stone-300 font-normal">Pengiriman Terpercaya ke Seluruh Wilayah Indonesia</p>
            </div>
          </div>

        </div>

      </div>
    </section>

    {/* SECTION 7: TESTIMONI EDITORIAL */}
    <section class="py-20 bg-[#FAF9F6] font-serif">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16">
        
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-normal text-black mb-2">Apa Kata Mereka Tentang Ballqish?</h2>
          <div class="w-12 h-0.5 bg-black mx-auto"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <div class="bg-white p-6 border border-gray-200 flex flex-col justify-between">
            <p class="text-sm text-gray-800 font-serif italic leading-relaxed mb-6">
              "Sebagai guru yang harus berdiri mengajar beberapa jam sehari, sol pantofel Ballqish ini empuk sekali. Kakiku tidak pegal lagi."
            </p>
            <div class="border-t border-gray-100 pt-4">
              <p class="text-sm font-semibold text-black">Pak Rahmad S.</p>
              <p class="text-xs text-gray-600 font-normal">Guru Honorer • Mojokerto</p>
            </div>
          </div>

          <div class="bg-white p-6 border border-gray-200 flex flex-col justify-between">
            <p class="text-sm text-gray-800 font-serif italic leading-relaxed mb-6">
              "Beli yang tipe tanpa tali buat sidang skripsi dan interview. Tampilannya kelihatan mewah padahal harganya pas di kantong mahasiswa."
            </p>
            <div class="border-t border-gray-100 pt-4">
              <p class="text-sm font-semibold text-black">Dimas K.</p>
              <p class="text-xs text-gray-600 font-normal">Fresh Graduate • Malang</p>
            </div>
          </div>

          <div class="bg-white p-6 border border-gray-200 flex flex-col justify-between">
            <p class="text-sm text-gray-800 font-serif italic leading-relaxed mb-6">
              "Sudah 2 kali order grosir 50 pasang untuk toko saya. Jahitannya rapi, konsumen puas, dan respon admin WA sangat cepat."
            </p>
            <div class="border-t border-gray-100 pt-4">
              <p class="text-sm font-semibold text-black">Ibu Nita</p>
              <p class="text-xs text-gray-600 font-normal">Mitra Toko Sepatu • Sidoarjo</p>
            </div>
          </div>

        </div>

      </div>
    </section>

    {/* SECTION 8: FASHION JOURNAL (SUPABASE ARTICLES FETCH) */}
    <section class="py-20 bg-white border-t border-gray-200 font-serif">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-10 lg:px-16">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
          <div>
            <p class="text-sm text-gray-600 font-normal mb-1">
              Jurnal & Cerita
            </p>
            <h2 class="text-2xl sm:text-3xl font-normal text-black">Artikel & Tips Sepatu Pantofel</h2>
          </div>
          <a href="/blog" class="mt-4 md:mt-0 text-sm text-black underline font-normal hover:text-[#5c1616]">
            Lihat Semua Artikel →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {articlesToShow.map((article) => (
            <article class="bg-[#FAF9F6] border border-gray-200 flex flex-col justify-between group">
              <div>
                <div class="h-48 bg-gray-200 relative overflow-hidden flex items-center justify-center">
                  {article.cover_image ? (
                    <img src={article.cover_image} alt={article.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <span class="text-xs text-gray-500">[ Visual Article Cover ]</span>
                  )}
                </div>
                <div class="p-5">
                  <span class="text-xs text-gray-600 block mb-2 font-normal">
                    {new Date(article.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </span>
                  <h3 class="text-base font-semibold text-black mb-2 line-clamp-2 group-hover:underline">
                    <a href={`/blog/${article.slug}`}>{article.title}</a>
                  </h3>
                  <p class="text-sm text-gray-700 font-normal line-clamp-3 leading-relaxed">
                    {article.excerpt}
                  </p>
                </div>
              </div>
              <div class="px-5 pb-5">
                <a href={`/blog/${article.slug}`} class="text-sm text-black underline font-normal hover:text-[#5c1616]">
                  Baca Selengkapnya →
                </a>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    {/* SECTION 9: FAQ ACCORDION INTERACTIVE */}
    <section id="faq" class="py-20 bg-[#FAF9F6] border-t border-gray-200 font-serif">
      <div class="max-w-3xl mx-auto px-6 sm:px-10">
        
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-normal text-black mb-2">Pertanyaan Sering Diajukan (FAQ)</h2>
          <div class="w-12 h-0.5 bg-black mx-auto"></div>
        </div>

        <div class="space-y-4">
          
          <details class="group border border-gray-200 p-5 bg-white cursor-pointer">
            <summary class="flex justify-between items-center font-semibold text-black text-base list-none group-hover:underline">
              Apakah sepatu pantofel Ballqish nyaman dipakai berdiri seharian?
              <span class="transition group-open:rotate-180 ml-4 text-gray-600">↓</span>
            </summary>
            <p class="text-sm text-gray-800 font-normal mt-3 leading-relaxed border-t border-gray-100 pt-3">
              Sangat nyaman. Semua produk sepatu pantofel Ballqish dilengkapi insole berpori penyerap tekanan serta outsole fleksibel anti-licin, cocok untuk guru, PNS, dan karyawan.
            </p>
          </details>

          <details class="group border border-gray-200 p-5 bg-white cursor-pointer">
            <summary class="flex justify-between items-center font-semibold text-black text-base list-none group-hover:underline">
              Bagaimana jika ukuran sepatu yang saya beli kekecilan atau kebesaran?
              <span class="transition group-open:rotate-180 ml-4 text-gray-600">↓</span>
            </summary>
            <p class="text-sm text-gray-800 font-normal mt-3 leading-relaxed border-t border-gray-100 pt-3">
              Kami menyediakan Garansi Tukar Ukuran 3 Hari setelah paket diterima, dengan syarat kondisi sepatu masih mulus dan belum pernah dipakai beraktivitas di luar ruangan.
            </p>
          </details>

          <details class="group border border-gray-200 p-5 bg-white cursor-pointer">
            <summary class="flex justify-between items-center font-semibold text-black text-base list-none group-hover:underline">
              Apakah bisa memesan sepatu pantofel grosir / seragam instansi?
              <span class="transition group-open:rotate-180 ml-4 text-gray-600">↓</span>
            </summary>
            <p class="text-sm text-gray-800 font-normal mt-3 leading-relaxed border-t border-gray-100 pt-3">
              Tentu bisa. Sebagai produsen tangan pertama di Sidoarjo, kami melayani pesanan partai besar (B2B) dengan harga grosir khusus, custom logo instansi, serta invoice resmi.
            </p>
          </details>

          <details class="group border border-gray-200 p-5 bg-white cursor-pointer">
            <summary class="flex justify-between items-center font-semibold text-black text-base list-none group-hover:underline">
              Berapa lama estimasi pengiriman sepatu?
              <span class="transition group-open:rotate-180 ml-4 text-gray-600">↓</span>
            </summary>
            <p class="text-sm text-gray-800 font-normal mt-3 leading-relaxed border-t border-gray-100 pt-3">
              Area Jawa Timur & Jawa Tengah 1-3 hari kerja. Jabodetabek 2-4 hari kerja, dan luar Pulau Jawa 3-7 hari kerja.
            </p>
          </details>

        </div>

      </div>
    </section>

    {/* SIZE CHART SECTION */}
    <section id="size-chart" class="py-16 bg-white border-t border-gray-200 font-serif">
      <div class="max-w-4xl mx-auto px-6 sm:px-10">
        <div class="text-center mb-10">
          <h2 class="text-2xl font-normal text-black mb-1">Panduan Ukuran Kaki</h2>
          <p class="text-sm text-gray-700 font-normal">Gunakan acuan ini sebelum menentukan ukuran sepatu Anda.</p>
        </div>

        <div class="bg-[#FAF9F6] border border-gray-200 p-6 sm:p-8 flex flex-col md:flex-row gap-8 items-center">
          <div class="flex-1 w-full">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="border-b border-black text-black font-semibold">
                  <th class="py-2.5">Ukuran (EU)</th>
                  <th class="py-2.5">Panjang Kaki (cm)</th>
                </tr>
              </thead>
              <tbody class="text-gray-800 font-normal divide-y divide-gray-200">
                <tr><td class="py-2.5 font-semibold text-black">39</td><td class="py-2.5">24.0 cm</td></tr>
                <tr><td class="py-2.5 font-semibold text-black">40</td><td class="py-2.5">25.0 cm</td></tr>
                <tr><td class="py-2.5 font-semibold text-black">41</td><td class="py-2.5">26.0 cm</td></tr>
                <tr><td class="py-2.5 font-semibold text-black">42</td><td class="py-2.5">27.0 cm</td></tr>
                <tr><td class="py-2.5 font-semibold text-black">43</td><td class="py-2.5">28.0 cm</td></tr>
              </tbody>
            </table>
          </div>

          <div class="flex-1 w-full border-t md:border-t-0 md:border-l border-gray-200 pt-6 md:pt-0 md:pl-8 space-y-2 text-sm text-gray-800 font-normal">
            <h3 class="font-semibold text-black text-sm">Cara Mengukur:</h3>
            <p>1. Letakkan kaki Anda di atas selembar kertas putih.</p>
            <p>2. Tandai titik paling ujung jempol dan titik paling belakang tumit.</p>
            <p>3. Ukur jarak kedua titik menggunakan penggaris dalam satuan centimeter (cm).</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  {/* MODALS */}
  <div id="modal-overlay" class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm z-[90] hidden transition-opacity duration-300"></div>

  {/* Cart Modal */}
  <div id="cart-modal" class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl z-[100] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col font-serif">
    <div class="px-6 py-5 border-b border-gray-200 flex justify-between items-center bg-white">
      <h2 class="text-base font-semibold text-black">Keranjang Belanja</h2>
      <button class="close-modal text-gray-400 hover:text-black transition-colors p-1">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div id="cart-items" class="flex-1 overflow-y-auto p-6 space-y-4 bg-[#FAF9F6]">
    </div>
    <div class="border-t border-gray-200 p-6 bg-white">
      <div class="flex justify-between items-center mb-6">
        <span class="font-normal text-gray-700 text-sm">Total Pembayaran</span>
        <span id="cart-total" class="font-bold text-black text-xl">Rp 0</span>
      </div>
      <button id="btn-checkout-wa" class="w-full bg-black text-white font-serif text-base py-3.5 hover:bg-[#5c1616] hover:underline transition-colors">
        Lanjut ke Pembayaran
      </button>
    </div>
  </div>

  {/* Favorites Modal */}
  <div id="favorites-modal" class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl z-[100] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col font-serif">
    <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-white">
      <h2 class="text-lg font-semibold text-black">Sepatu Favorit</h2>
      <button class="close-modal text-gray-400 hover:text-black transition-colors p-1">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div id="favorites-items" class="flex-1 overflow-y-auto p-6 space-y-4 bg-gray-50">
    </div>
  </div>

  {/* Orders Modal */}
  <div id="orders-modal" class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl z-[100] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col font-serif">
    <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-white">
      <h2 class="text-lg font-semibold text-black">Riwayat Pesanan</h2>
      <button class="close-modal text-gray-400 hover:text-black transition-colors p-1">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div id="orders-items" class="flex-1 overflow-y-auto p-6 space-y-4 bg-gray-50">
      <div class="flex flex-col items-center justify-center h-full text-gray-400 mt-20">
        <svg class="w-16 h-16 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <p class="font-normal text-sm">Belum ada riwayat pesanan</p>
      </div>
    </div>
  </div>

  <AddressModal />
  <Footer />

  <style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

  <script>
    import { supabase } from '../lib/supabase';
    
    document.addEventListener('DOMContentLoaded', () => {
      let cart = [];
      let favorites = [];

      const catalogTabs = document.querySelectorAll('.catalog-tab');
      const catalogProducts = document.querySelectorAll('.catalog-product-item');
      const shortcutCategoryBtns = document.querySelectorAll('.category-filter-shortcut');
      
      const addToCartBtns = document.querySelectorAll('.add-to-cart');
      const favBtns = document.querySelectorAll('.favorite-btn');
      
      const overlay = document.getElementById('modal-overlay');
      const cartModal = document.getElementById('cart-modal');
      const favModal = document.getElementById('favorites-modal');
      const orderModal = document.getElementById('orders-modal');
      
      try {
        const c = localStorage.getItem('ballqish_cart');
        const f = localStorage.getItem('ballqish_favs');
        if (c) {
          cart = JSON.parse(c);
          cart = cart.filter(item => item.id && item.id.length === 36);
          localStorage.setItem('ballqish_cart', JSON.stringify(cart));
        }
        if (f) {
          favorites = JSON.parse(f);
          favorites = favorites.filter(item => item.id && item.id.length === 36);
          localStorage.setItem('ballqish_favs', JSON.stringify(favorites));
        }
      } catch(e) {}

      // Tab Switcher with Underline Indicator Active State
      function filterProducts(categoryTab) {
        catalogTabs.forEach(tab => {
          const isActive = (tab as HTMLButtonElement).dataset.tab === categoryTab;
          if (isActive) {
            tab.classList.add('border-black', 'text-black', 'font-semibold');
            tab.classList.remove('border-transparent', 'text-gray-600', 'font-normal');
          } else {
            tab.classList.remove('border-black', 'text-black', 'font-semibold');
            tab.classList.add('border-transparent', 'text-gray-600', 'font-normal');
          }
        });

        catalogProducts.forEach(product => {
          const pCat = product.getAttribute('data-category');
          if (categoryTab === 'all' || pCat === categoryTab) {
            product.classList.remove('hidden');
          } else {
            product.classList.add('hidden');
          }
        });
      }

      catalogTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const categoryTab = (tab as HTMLButtonElement).dataset.tab || 'all';
          filterProducts(categoryTab);
        });
      });

      shortcutCategoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = (btn as HTMLButtonElement).dataset.filterCategory || 'all';
          filterProducts(cat);
          const grid = document.getElementById('product-grid');
          if (grid) grid.scrollIntoView({ behavior: 'smooth' });
        });
      });

      function updateFavUI() {
        favBtns.forEach(btn => {
          const b = btn as HTMLButtonElement;
          const id = b.dataset.productId;
          const icon = b.querySelector('.heart-icon');
          if (favorites.some(f => f.id === id)) {
            icon.classList.add('text-red-500', 'fill-red-500');
            icon.classList.remove('text-gray-300', 'fill-current');
          } else {
            icon.classList.remove('text-red-500', 'fill-red-500');
            icon.classList.add('text-gray-300', 'fill-current');
          }
        });
        
        const favContainer = document.getElementById('favorites-items');
        if (favorites.length === 0) {
          favContainer.innerHTML = '<div class="flex flex-col items-center justify-center h-full text-gray-400 mt-20"><svg class="w-16 h-16 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg><p class="font-normal text-sm">Belum ada favorit</p></div>';
        } else {
          favContainer.innerHTML = favorites.map(item => `
            <div class="flex items-center gap-4 bg-white border border-gray-100 p-3 shadow-xs font-serif">
              <img src="${item.image}" class="w-16 h-16 object-cover" />
              <div class="flex-1">
                <h4 class="text-sm font-serif font-semibold text-black line-clamp-1 mb-1">${item.name}</h4>
                <p class="text-sm font-serif font-bold text-black">Rp ${item.price.toLocaleString('id-ID')}</p>
              </div>
            </div>
          `).join('');
        }
        localStorage.setItem('ballqish_favs', JSON.stringify(favorites));
      }

      function updateCartUI() {
        const cartCountEl = document.getElementById('cart-count');
        const cartTotalEl = document.getElementById('cart-total');
        const cartItemsEl = document.getElementById('cart-items');
        
        const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
        const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        
        if(totalItems > 0 && cartCountEl) {
          cartCountEl.textContent = totalItems.toString();
          cartCountEl.classList.remove('hidden');
        } else if (cartCountEl) {
          cartCountEl.classList.add('hidden');
        }
        
        if (cartTotalEl) cartTotalEl.textContent = `Rp ${totalPrice.toLocaleString('id-ID')}`;
        
        if (cartItemsEl) {
          if (cart.length === 0) {
            cartItemsEl.innerHTML = '<div class="flex flex-col items-center justify-center h-full text-gray-400 mt-20"><svg class="w-16 h-16 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg><p class="font-normal text-sm">Keranjang masih kosong</p></div>';
          } else {
            cartItemsEl.innerHTML = cart.map(item => `
              <div class="flex items-center gap-4 bg-white border border-gray-100 p-3 shadow-xs font-serif">
                <img src="${item.image}" class="w-16 h-16 object-cover bg-gray-50 mix-blend-multiply" />
                <div class="flex-1">
                  <h4 class="text-sm font-serif font-semibold text-black line-clamp-1 mb-1">${item.name}</h4>
                  <div class="flex justify-between items-center mb-1 flex-wrap gap-1">
                    <span class="text-xs text-gray-700 bg-gray-100 px-1.5 py-0.5 font-serif">Ukuran: ${item.size}</span>
                    <span class="text-xs text-gray-700 bg-gray-100 px-1.5 py-0.5 font-serif">Qty: ${item.quantity}</span>
                  </div>
                  <p class="text-sm font-serif font-bold text-black mt-1">Rp ${(item.price * item.quantity).toLocaleString('id-ID')}</p>
                </div>
              </div>
            `).join('');
          }
        }
        
        localStorage.setItem('ballqish_cart', JSON.stringify(cart));
      }

      addToCartBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const b = e.currentTarget as HTMLButtonElement;
          const id = b.dataset.productId;
          window.location.href = `/product/${id}`;
        });
      });

      favBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const b = e.currentTarget as HTMLButtonElement;
          const id = b.dataset.productId;
          const name = b.dataset.productName;
          const price = parseInt(b.dataset.productPrice || "0");
          const image = b.dataset.productImage;
          
          const existingIndex = favorites.findIndex(f => f.id === id);
          if (existingIndex > -1) {
            favorites.splice(existingIndex, 1);
          } else {
            favorites.push({ id, name, price, image });
          }
          updateFavUI();
          
          b.classList.add('scale-125');
          setTimeout(() => b.classList.remove('scale-125'), 200);
        });
      });

      function openModal(modalEl) {
        overlay.classList.remove('hidden');
        setTimeout(() => overlay.classList.remove('opacity-0'), 10);
        modalEl.classList.remove('translate-x-full');
      }
      
      function closeAllModals() {
        overlay.classList.add('opacity-0');
        cartModal.classList.add('translate-x-full');
        favModal.classList.add('translate-x-full');
        orderModal.classList.add('translate-x-full');
        setTimeout(() => overlay.classList.add('hidden'), 300);
      }

      triggerCart?.addEventListener('click', () => openModal(cartModal));
      triggerFav?.addEventListener('click', () => openModal(favModal));
      triggerOrder?.addEventListener('click', () => openModal(orderModal));
      
      closeBtns.forEach(btn => btn.addEventListener('click', closeAllModals));
      overlay.addEventListener('click', closeAllModals);

      const checkoutBtn = document.getElementById('btn-checkout-wa');
      checkoutBtn?.addEventListener('click', async () => {
        if (cart.length === 0) {
          if (window.showToast) window.showToast('Keranjang masih kosong!', 'error');
          return;
        }

        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          if (window.showToast) window.showToast('Silakan Masuk/Daftar terlebih dahulu untuk Checkout', 'error');
          setTimeout(() => window.location.href = '/login', 2000);
          return;
        }
        
        window.location.href = '/checkout';
      });
      
      async function loadOrders() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;
        
        const { data: orders, error } = await supabase
          .from('orders')
          .select('*, order_items(*)')
          .eq('user_id', session.user.id)
          .order('created_at', { ascending: false });

        const ordersContainer = document.getElementById('orders-items');
        if (!ordersContainer || error) return;
        
        if (orders.length === 0) {
          ordersContainer.innerHTML = `
            <div class="flex flex-col items-center justify-center h-full text-gray-400 mt-20 font-serif">
              <svg class="w-16 h-16 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <p class="font-normal text-sm">Belum ada riwayat pesanan</p>
            </div>
          `;
          return;
        }

        ordersContainer.innerHTML = orders.map(order => {
          let statusColor = 'bg-gray-100 text-gray-700 border-gray-200';
          if (order.status === 'Menunggu Pembayaran') statusColor = 'bg-yellow-50 text-yellow-700 border-yellow-200';
          if (order.status === 'Diproses') statusColor = 'bg-blue-50 text-blue-700 border-blue-200';
          if (order.status === 'Dikirim') statusColor = 'bg-purple-50 text-purple-700 border-purple-200';
          if (order.status === 'Selesai') statusColor = 'bg-green-50 text-green-700 border-green-200';
          if (order.status === 'Dibatalkan') statusColor = 'bg-red-50 text-red-700 border-red-200';

          return `
            <div class="bg-white border border-gray-200 p-4 shadow-xs font-serif">
              <div class="flex justify-between items-start mb-3">
                <div>
                  <span class="text-xs text-gray-600 font-serif">Order #${order.id.slice(0,8)}</span>
                  <h4 class="font-semibold text-sm text-black font-serif mt-0.5">${new Date(order.created_at).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year:'numeric'})}</h4>
                </div>
                <span class="${statusColor} border text-xs font-semibold px-2 py-0.5 font-serif">${order.status}</span>
              </div>
              
              <div class="space-y-2 mt-3 font-serif">
                ${order.order_items.map(item => `
                  <div class="flex gap-3">
                    <img src="${item.product_image}" class="w-10 h-10 object-cover bg-gray-50" />
                    <div class="flex-1">
                      <p class="text-xs font-semibold text-black line-clamp-1">${item.product_name}</p>
                      <p class="text-xs text-gray-600">Size ${item.size} | ${item.outsole_model || ''}</p>
                      <p class="text-xs text-gray-600">Qty: ${item.quantity} x Rp ${item.price.toLocaleString('id-ID')}</p>
                    </div>
                  </div>
                `).join('')}
              </div>

              <div class="flex justify-between items-center pt-3 mt-3 border-t border-gray-100 font-serif">
                <p class="text-xs text-gray-600">Total Belanja</p>
                <p class="text-sm font-bold text-black">Rp ${order.total_amount.toLocaleString('id-ID')}</p>
              </div>
            </div>
          `;
        }).join('');
      }

      updateFavUI();
      updateCartUI();
      loadOrders();

      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('openCart') === 'true') {
        openModal(cartModal);
        window.history.replaceState({}, document.title, window.location.pathname);
      } else if (urlParams.get('openFav') === 'true') {
        openModal(favModal);
        window.history.replaceState({}, document.title, window.location.pathname);
      } else if (urlParams.get('openOrders') === 'true') {
        openModal(orderModal);
        window.history.replaceState({}, document.title, window.location.pathname);
      } else if (urlParams.get('openAddress') === 'true') {
        if ((window as any).openAddressModal) (window as any).openAddressModal();
        window.history.replaceState({}, document.title, window.location.pathname);
      } else if (urlParams.get('success') === 'true') {
        if (window.showToast) window.showToast('Pembayaran Sukses! Pesanan Anda sedang diproses.', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
      }
    });
  </script>
</Layout>
