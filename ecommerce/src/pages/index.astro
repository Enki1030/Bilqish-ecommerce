---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';
import Footer from '../components/Footer.astro';
import AddressModal from '../components/AddressModal.astro';
import { supabase } from '../lib/supabase';
import { products as defaultProducts } from '../data/products';
import bgPantofel from '../assets/backgroundpantofel.jpg';
import imgHero from '../assets/Pantofel_heroSection.jpg';
import imgBertali from '../assets/Pantofel_bertali.jpg';
import imgNontali from '../assets/Pantofel_nontali.jpg';
import imgCraft1 from '../assets/pantofel_1.jpg';
import imgCraft2 from '../assets/Pantofel_2.jpg';
import imgCraft3 from '../assets/Pantofel_3.jpg';
import imgB2B from '../assets/b2b_pantofel.jpg';

let productsData = null;
let latestArticles = [];

try {
  const [prodRes, artRes] = await Promise.all([
    supabase.from('products').select('*').order('created_at', { ascending: false }),
    supabase.from('articles').select('id, title, slug, excerpt, cover_image, created_at').order('created_at', { ascending: false }).limit(3)
  ]);
  productsData = prodRes.data;
  latestArticles = artRes.data || [];
} catch (err) {
  console.error('Error fetching from Supabase:', err);
}

const allProducts = (productsData && productsData.length > 0)
  ? productsData.map(p => ({
      ...p,
      image: p.image_url || p.image
    }))
  : defaultProducts;

// Hero CTA sekunder: arahkan ke detail produk pertama yang valid (uuid dari database),
// fallback ke katalog bila belum ada produk dari database.
const heroDetailProduct = allProducts.find((p: any) => typeof p?.id === 'string' && p.id.length === 36);
const heroDetailHref = heroDetailProduct ? `/product/${heroDetailProduct.id}` : '#collection';

// Fallback articles if Supabase is empty
const fallbackArticles = [
  {
    id: '1',
    title: 'Cara Memilih Sepatu Pantofel yang Nyaman untuk Kerja Seharian',
    slug: 'cara-memilih-sepatu-pantofel-nyaman',
    excerpt: 'Panduan lengkap memilih sol dan insole empuk agar kaki tidak pegal saat dipakai bertugas sepanjang hari.',
    cover_image: 'https://images.unsplash.com/photo-1614252209825-96144e1c25fc?q=80&w=600&auto=format&fit=crop',
    created_at: new Date().toISOString()
  },
  {
    id: '2',
    title: 'Perbedaan Sepatu Pantofel Tali vs Tanpa Tali (Loafers)',
    slug: 'perbedaan-pantofel-tali-vs-tanpa-tali',
    excerpt: 'Ketahui kelebihan dan use-case masing-masing model agar sesuai dengan etika busana instansi dan acara Anda.',
    cover_image: 'https://images.unsplash.com/photo-1549298916-b41d501d3772?q=80&w=600&auto=format&fit=crop',
    created_at: new Date().toISOString()
  },
  {
    id: '3',
    title: 'Tips Merawat Sepatu Pantofel Kulit Sintetis PU Agar Awet & Mengkilap',
    slug: 'tips-merawat-sepatu-pantofel-kulit-pu',
    excerpt: 'Langkah praktis pembersihan harian tanpa merusak permukaan sepatu buatan pengrajin Sidoarjo.',
    cover_image: 'https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?q=80&w=600&auto=format&fit=crop',
    created_at: new Date().toISOString()
  }
];

const articlesToShow = latestArticles.length > 0 ? latestArticles : fallbackArticles;
---

<Layout title="Ballqish - Sepatu Pantofel Pria & Wanita Handmade Sidoarjo | Grosir & Eceran">
  <Header transparent={true} />

  <main data-theme="editorial" class="flex-1 bg-ivory text-ink">
    
    {/* SECTION 2: HERO SECTION — Editorial Luxury */}
    <section id="hero" data-theme="editorial" class="relative w-full bg-ivory overflow-hidden">
      {/* Spacer untuk Header fixed (tinggi 80px) */}
      <div class="h-20"></div>

      <div class="mx-auto max-w-[1400px] px-6 md:px-10 pt-12 pb-20 md:pb-24">
        <div class="grid md:grid-cols-12 gap-6 md:gap-8 items-center">

          {/* ---------------- TEXT COLUMN (5 dari 12) ---------------- */}
          <div class="md:col-span-5">
            {/* Eyebrow / Label Kategori */}
            <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-6">
              Musim Gugur / Dingin 2026
            </span>

            {/* Judul Hero — Bodoni Moda 400, line-height 0.92 */}
            <h1 class="font-serif text-6xl md:text-8xl leading-[0.92] text-ink">
              Wibawa
              <span class="block italic text-oxblood">yang tenang</span>
              <span class="block">sebuah pantofel.</span>
            </h1>

            {/* Body — Manrope 400, 16px, line-height 1.625, ink 70% */}
            <p class="hero-bodycopy mt-8">
              Dua ratus delapan belas proses buatan tangan. Tujuh minggu di atas last. Sepatu formal dari atelier kami di Milan, dibuat untuk diganti solnya, bukan diganti sepatunya.
            </p>

            {/* CTA */}
            <div class="mt-10 flex flex-wrap items-center gap-6">
              <a
                href="#collection"
                class="inline-flex items-center justify-center bg-ink text-ivory px-8 py-4 text-[11px] uppercase tracking-[0.3em] transition-colors duration-300 hover:bg-oxblood"
              >
                Jelajahi Koleksi
              </a>
              <a
                href={heroDetailHref}
                class="inline-flex items-center gap-2 px-1 pt-4 pb-1 border-b border-ink text-[11px] uppercase tracking-[0.3em] text-ink transition-colors duration-300 hover:text-oxblood hover:border-oxblood"
              >
                Lihat Detail
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </a>
            </div>
          </div>

          {/* ---------------- VISUAL COLUMN (7 dari 12) ---------------- */}
          <div class="md:col-span-7 relative">
            <div class="w-full max-w-[750px] ml-auto aspect-[4/5] md:aspect-[5/7] bg-bone overflow-hidden">
              <img
                src={imgHero.src}
                alt="Sepatu Pantofel Ballqish Sidoarjo"
                class="w-full h-full object-cover"
              />
            </div>

            {/* Kotak statistik (desktop only) */}
            <div class="hidden lg:flex absolute -left-6 bottom-12 w-[224px] p-6 bg-ivory flex-col justify-center">
              <span class="font-serif block text-[48px] leading-none text-oxblood">218</span>
              <span class="block text-[10px] uppercase tracking-[0.3em] text-ink/50 mt-3">
                Pasang Dirakit
              </span>
            </div>
          </div>

        </div>
      </div>
    </section>

    {/* SECTION 3: TRUST SIGNAL BAR (tanpa garis pemisah, background ivory) */}
    <section class="w-full bg-ivory py-10 px-6 lg:px-10">
      <div class="max-w-[1400px] mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center">

        <div class="py-2">
          <h3 class="display-font text-[19px] font-normal text-ink">Pengrajin Asli Sidoarjo</h3>
          <p class="text-[13px] text-ink/60 mt-1.5">Desa Sruni, Gedangan</p>
        </div>

        <div class="py-2">
          <h3 class="display-font text-[19px] font-normal text-ink">Ribuan Pasang Terjual</h3>
          <p class="text-[13px] text-ink/60 mt-1.5">Teruji Awet oleh Guru &amp; PNS</p>
        </div>

        <div class="py-2">
          <h3 class="display-font text-[19px] font-normal text-ink">Garansi Tukar Ukuran</h3>
          <p class="text-[13px] text-ink/60 mt-1.5">3 Hari Pasca Barang Sampai</p>
        </div>

        <div class="py-2">
          <h3 class="display-font text-[19px] font-normal text-ink">Grosir &amp; Custom B2B</h3>
          <p class="text-[13px] text-ink/60 mt-1.5">Seragam Instansi &amp; Reseller</p>
        </div>

      </div>
    </section>

    {/* SECTION 4: KOLEKSI FORMAL — judul persis di atas kumpulan produk */}
    <section id="collection" class="pt-16 pb-24 max-w-[1400px] mx-auto px-6 md:px-10">

      {/* Judul rata kiri, filter tabs di kanan baris yang sama */}
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-12 pb-6 border-b border-line">
        <div>
          <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-5">Karya Pilihan</span>
          <h2 class="display-font text-4xl md:text-5xl font-normal text-ink leading-[1.25]">Koleksi Formal</h2>
        </div>

        {/* Catalog Filter Tabs */}
        <div class="flex gap-8 overflow-x-auto hide-scrollbar pb-1">
          <button
            type="button"
            class="catalog-tab text-[11px] uppercase tracking-[0.25em] text-ink border-b pb-2 cursor-pointer transition-colors border-ink"
            data-tab="all"
          >
            Semua ({allProducts.length})
          </button>
          <button
            type="button"
            class="catalog-tab text-[11px] uppercase tracking-[0.25em] text-ink/50 border-b-2 border-transparent pb-2 cursor-pointer transition-colors"
            data-tab="tanpa-tali"
          >
            Tanpa Tali
          </button>
          <button
            type="button"
            class="catalog-tab text-[11px] uppercase tracking-[0.25em] text-ink/50 border-b-2 border-transparent pb-2 cursor-pointer transition-colors"
            data-tab="dengan-tali"
          >
            Dengan Tali
          </button>
        </div>
      </div>

      {/* GRID PRODUK — pembungkus .catalog-product-item + data-category wajib dipertahankan */}
      <div id="product-grid" class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-14">
        {allProducts.map((product) => {
          // model_type: 'G' = Tanpa Tali, 'T' = Dengan Tali (dari kolom Supabase)
          // Fallback: ambil huruf pertama dari field model (G21 -> G, T02 -> T)
          const modelType =
            product.model_type ||
            (product.model ? product.model[0].toUpperCase() : 'G');
          const categoryTag = modelType === 'T' ? 'dengan-tali' : 'tanpa-tali';
          return (
            <div class="catalog-product-item" data-category={categoryTag}>
              <ProductCard product={product} />
            </div>
          );
        })}
      </div>

    </section>

    {/* SECTION 4B: JENIS SEPATU — dua siluet */}
    <section class="pt-24 pb-8 max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="mb-12">
        <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-5">Jenis Sepatu</span>
        <h2 class="display-font text-4xl md:text-5xl font-normal text-ink leading-[1.25]">Dua Siluet</h2>
      </div>

      {/* Dua kartu kategori editorial */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">

        <div class="group flex flex-col">
          <div class="w-full aspect-[16/9] bg-bone overflow-hidden relative">
            <img src={imgNontali.src} alt="Pantofel Tanpa Tali" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1200ms] ease-out" />
          </div>
          <div class="pt-6">
            <span class="block text-[10px] uppercase tracking-[0.3em] text-brass mb-3">Tanpa Tali</span>
            <h3 class="display-font text-3xl font-normal text-ink mb-3 group-hover:underline">Loafers / Slip-On</h3>
            <p class="text-sm text-ink/60 leading-relaxed mb-4">
              Praktis dilepas-pasang, sol empuk ringan, ideal untuk guru &amp; PNS bertugas harian.
            </p>
            <button data-filter-category="tanpa-tali" class="category-filter-shortcut text-[11px] uppercase tracking-[0.25em] text-ink border-b border-ink pb-1 transition-colors hover:text-oxblood hover:border-oxblood">
              Lihat Model
            </button>
          </div>
        </div>

        <div class="group flex flex-col">
          <div class="w-full aspect-[16/9] bg-bone overflow-hidden relative">
            <img src={imgBertali.src} alt="Pantofel Dengan Tali" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1200ms] ease-out" />
          </div>
          <div class="pt-6">
            <span class="block text-[10px] uppercase tracking-[0.3em] text-brass mb-3">Dengan Tali</span>
            <h3 class="display-font text-3xl font-normal text-ink mb-3 group-hover:underline">Lace-Up Classic</h3>
            <p class="text-sm text-ink/60 leading-relaxed mb-4">
              Klasik, rapi, dan gagah. Cocok untuk wisuda, sidang skripsi, dan acara formal instansi.
            </p>
            <button data-filter-category="dengan-tali" class="category-filter-shortcut text-[11px] uppercase tracking-[0.25em] text-ink border-b border-ink pb-1 transition-colors hover:text-oxblood hover:border-oxblood">
              Lihat Model
            </button>
          </div>
        </div>

      </div>
    </section>

    {/* SECTION 5: CRAFTMANSHIP — section merah (Oxblood) */}
    <section class="py-24">
      <div class="max-w-[1400px] mx-auto px-6 md:px-10">

        {/* Section Header */}
        <div class="mb-14">
          <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-5">Keunggulan &amp; Nilai Ballqish</span>
          <h2 class="display-font text-4xl md:text-5xl font-normal leading-[1.25]">Kenapa Memilih Ballqish?</h2>
        </div>

        {/* 3 gambar portrait dempet — celah tipis ala kolase editorial */}
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-1.5 sm:gap-2 mb-12">
          <div class="group relative aspect-[3/4] overflow-hidden">
            <img
              src={imgCraft1.src}
              alt="Detail sol dan insole Ballqish"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1200ms] ease-out"
            />
          </div>
          <div class="group relative aspect-[3/4] overflow-hidden">
            <img
              src={imgCraft2.src}
              alt="Workshop pengrajin Desa Sruni Sidoarjo"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1200ms] ease-out"
            />
          </div>
          <div class="group relative aspect-[3/4] overflow-hidden">
            <img
              src={imgCraft3.src}
              alt="Pemakaian di berbagai kesempatan"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1200ms] ease-out"
            />
          </div>
        </div>

        {/* Penjelasan di atas background — padding kanan supaya tidak nyatu dengan tepi gambar */}
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-10 sm:gap-y-0">

          <div class="sm:pr-10 lg:pr-14">
            <span class="block text-[10px] uppercase tracking-[0.3em] text-brass mb-4">01 — Nyamanan</span>
            <h3 class="display-font text-2xl md:text-3xl font-normal leading-snug">Sol empuk &amp; anti-licin</h3>
            <p class="text-[15px] text-ink/70 leading-relaxed mt-4">
              Outsole TPR fleksibel dan insole berpori penyerap tekanan, nyaman dipakai berdiri dan berjalan seharian penuh.
            </p>
          </div>

          <div class="sm:pr-10 lg:pr-14">
            <span class="block text-[10px] uppercase tracking-[0.3em] text-brass mb-4">02 — Harga</span>
            <h3 class="display-font text-2xl md:text-3xl font-normal leading-snug">Harga langsung pengrajin</h3>
            <p class="text-[15px] text-ink/70 leading-relaxed mt-4">
              Produksi langsung dari tangan pengrajin Desa Sruni, Sidoarjo — tanpa perantara distributor, harga lebih terjangkau.
            </p>
          </div>

          <div class="sm:pr-6">
            <span class="block text-[10px] uppercase tracking-[0.3em] text-brass mb-4">03 — Fleksibel</span>
            <h3 class="display-font text-2xl md:text-3xl font-normal leading-snug">Fleksibel untuk berbagai acara</h3>
            <p class="text-[15px] text-ink/70 leading-relaxed mt-4">
              Dari ruang kelas, kantor dinas, sidang skripsi, hingga acara keagamaan — satu sepatu untuk semua momen penting.
            </p>
          </div>

        </div>

      </div>
    </section>

    {/* SECTION 6: B2B GROSIR & RESELLER — full-bleed image kiri, teks kanan */}
    <section id="b2b" class="bg-oxblood text-ivory relative overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2">

        {/* Kiri: gambar penuh, mentok ke tepi layar */}
        <div class="relative min-h-[300px] lg:min-h-[620px] bg-ink/30 order-1">
          <img
            src={imgB2B.src}
            alt="Workshop produksi grosir Ballqish"
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-oxblood/50 via-transparent to-transparent"></div>
          <span class="absolute bottom-6 left-6 md:left-10 text-[10px] uppercase tracking-[0.3em] text-ivory/80">
            Pengiriman Terpercaya ke Seluruh Indonesia
          </span>
        </div>

        {/* Kanan: seluruh teks, flush ke background tanpa kotak */}
        <div class="order-2 px-6 md:px-12 lg:px-16 xl:px-20 py-20 lg:py-24 lg:max-w-[640px]">

          <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-6">
            Fasilitas Grosir &amp; Pengadaan Instansi
          </span>

          <h2 class="display-font text-4xl md:text-5xl font-normal leading-[1.2]">
            Kerja Sama Grosir, Reseller &amp; Seragam Instansi
          </h2>

          <p class="text-base leading-relaxed text-ivory/75 mt-7">
            Ballqish melayani pemesanan sepatu pantofel partai besar langsung dari workshop pengrajin Sidoarjo untuk toko sepatu, instansi pemerintah, sekolah, dan perusahaan.
          </p>

          {/* Dua fitur — 2 kolom, tanpa kotak dan tanpa garis pemisah */}
          <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-9">
            <div>
              <h3 class="display-font text-2xl font-normal mb-2.5">Diskon Grosir Khusus</h3>
              <p class="text-[15px] text-ivory/70 leading-relaxed">
                Minimal order 12 pasang dengan harga langsung pabrik.
              </p>
            </div>
            <div>
              <h3 class="display-font text-2xl font-normal mb-2.5">Custom Logo &amp; Size</h3>
              <p class="text-[15px] text-ivory/70 leading-relaxed">
                Bisa embossed logo perusahaan/instansi &amp; ukuran khusus.
              </p>
            </div>
          </div>

          {/* CTA — gaya tombol hero (solid, uppercase, tracking lebar) */}
          <div class="mt-12">
            <a
              href="https://wa.me/6281234567890?text=Halo%20Tim%20B2B%20Ballqish,%20saya%20tertarik%20untuk%20kerja%20sama%20grosir%2Fseragam%20instansi"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center bg-ink text-ivory px-8 py-4 text-[11px] uppercase tracking-[0.3em] transition-colors duration-300 hover:bg-ivory hover:text-ink"
            >
              Hubungi Tim B2B via WhatsApp
            </a>
          </div>

        </div>
      </div>
    </section>

    {/* SECTION 7: TESTIMONI — teks langsung di atas background, tanpa kotak */}
    <section class="py-24">
      <div class="max-w-[1400px] mx-auto px-6 md:px-10">

        <div class="text-center mb-16">
          <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-5">Pelanggan Eksklusif</span>
          <h2 class="display-font text-4xl md:text-5xl font-normal text-ink leading-[1.25]">Apa Kata Mereka?</h2>
          <div class="w-12 h-px bg-brass mx-auto mt-6"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-12 gap-y-14">

          <div>
            <p class="font-inter text-[22px] md:text-[26px] italic font-light leading-[1.55] text-ink">
              "Sebagai guru yang harus berdiri mengajar beberapa jam sehari, sol pantofel Ballqish ini empuk sekali. Kakiku tidak pegal lagi."
            </p>
            <div class="mt-7">
              <p class="text-sm font-semibold text-ink">Pak Rahmad S.</p>
              <p class="text-[12px] text-ink/50 mt-1.5">Guru Honorer • Mojokerto</p>
            </div>
          </div>

          <div>
            <p class="font-inter text-[22px] md:text-[26px] italic font-light leading-[1.55] text-ink">
              "Beli yang tipe tanpa tali buat sidang skripsi dan interview. Tampilannya kelihatan mewah padahal harganya pas di kantong mahasiswa."
            </p>
            <div class="mt-7">
              <p class="text-sm font-semibold text-ink">Dimas K.</p>
              <p class="text-[12px] text-ink/50 mt-1.5">Fresh Graduate • Malang</p>
            </div>
          </div>

          <div>
            <p class="font-inter text-[22px] md:text-[26px] italic font-light leading-[1.55] text-ink">
              "Sudah 2 kali order grosir 50 pasang untuk toko saya. Jahitannya rapi, konsumen puas, dan respon admin WA sangat cepat."
            </p>
            <div class="mt-7">
              <p class="text-sm font-semibold text-ink">Ibu Nita</p>
              <p class="text-[12px] text-ink/50 mt-1.5">Mitra Toko Sepatu • Sidoarjo</p>
            </div>
          </div>

        </div>

      </div>
    </section>

    {/* SECTION 8: JURNAL & CERITA — kartu foto dengan teks overlay */}
    <section class="pb-24">
      <div class="max-w-[1400px] mx-auto px-6 md:px-10">

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
          <div>
            <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-5">
              Artikel &amp; Tips
            </span>
            <h2 class="display-font text-4xl md:text-5xl font-normal text-ink leading-[1.25]">Jurnal &amp; Cerita</h2>
          </div>
          <a href="/blog" class="mt-4 md:mt-0 text-[11px] uppercase tracking-[0.25em] text-ink border-b border-ink pb-1 transition-colors hover:text-oxblood hover:border-oxblood">
            Lihat Semua Artikel
          </a>
        </div>

        {/* Kartu: foto di atas, teks judul menumpuk di bagian bawah foto di atas
            gradien gelap agar teks ivory tetap terbaca. Judul dipotong (line-clamp)
            dansisanya dilanjutkan lewat "Lihat Selengkapnya". */}
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-10">
          {articlesToShow.map((article) => (
            <a href={`/blog/${article.slug}`} class="group relative block overflow-hidden bg-bone aspect-[4/5]">
              {article.cover_image ? (
                <img
                  src={article.cover_image}
                  alt={article.title}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105"
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="text-[10px] uppercase tracking-[0.25em] text-ink/40">Visual Cover</span>
                </div>
              )}

              {/* Gradien gelap di bagian bawah foto */}
              <div class="absolute inset-0 bg-gradient-to-t from-ink/92 via-ink/45 to-transparent"></div>

              {/* Teks overlay */}
              <div class="absolute inset-x-0 bottom-0 p-6">
                <span class="block text-[10px] uppercase tracking-[0.25em] text-brass mb-3">
                  {new Date(article.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
                </span>
                <h3 class="display-font text-[22px] md:text-[24px] font-normal text-ivory leading-snug line-clamp-2">
                  {article.title}
                </h3>
                <span class="inline-flex items-center gap-2 mt-4 text-[10px] uppercase tracking-[0.25em] text-ivory/80 transition-colors duration-300 group-hover:text-ivory">
                  Lihat Selengkapnya
                  <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </span>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>
