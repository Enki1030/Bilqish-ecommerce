---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';
import Footer from '../components/Footer.astro';
import AddressModal from '../components/AddressModal.astro';
import { supabase } from '../lib/supabase';
import { products as defaultProducts } from '../data/products';
import bgPantofel from '../assets/backgroundpantofel.jpg';

let productsData = null;
let latestArticles = [];

try {
  const [prodRes, artRes] = await Promise.all([
    supabase.from('products').select('*').order('created_at', { ascending: false }),
    supabase.from('articles').select('id, title, slug, excerpt, cover_image, created_at').order('created_at', { ascending: false }).limit(3)
  ]);
  productsData = prodRes.data;
  latestArticles = artRes.data || [];
} catch (err) {
  console.error('Error fetching from Supabase:', err);
}

const allProducts = (productsData && productsData.length > 0)
  ? productsData.map(p => ({
      ...p,
      image: p.image_url || p.image
    }))
  : defaultProducts;

// Fallback articles if Supabase is empty
const fallbackArticles = [
  {
    id: '1',
    title: 'Cara Memilih Sepatu Pantofel yang Nyaman untuk Kerja Seharian',
    slug: 'cara-memilih-sepatu-pantofel-nyaman',
    excerpt: 'Panduan lengkap memilih sol dan insole empuk agar kaki tidak pegal saat dipakai bertugas sepanjang hari.',
    cover_image: 'https://images.unsplash.com/photo-1614252209825-96144e1c25fc?q=80&w=600&auto=format&fit=crop',
    created_at: new Date().toISOString()
  },
  {
    id: '2',
    title: 'Perbedaan Sepatu Pantofel Tali vs Tanpa Tali (Loafers)',
    slug: 'perbedaan-pantofel-tali-vs-tanpa-tali',
    excerpt: 'Ketahui kelebihan dan use-case masing-masing model agar sesuai dengan etika busana instansi dan acara Anda.',
    cover_image: 'https://images.unsplash.com/photo-1549298916-b41d501d3772?q=80&w=600&auto=format&fit=crop',
    created_at: new Date().toISOString()
  },
  {
    id: '3',
    title: 'Tips Merawat Sepatu Pantofel Kulit Sintetis PU Agar Awet & Mengkilap',
    slug: 'tips-merawat-sepatu-pantofel-kulit-pu',
    excerpt: 'Langkah praktis pembersihan harian tanpa merusak permukaan sepatu buatan pengrajin Sidoarjo.',
    cover_image: 'https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?q=80&w=600&auto=format&fit=crop',
    created_at: new Date().toISOString()
  }
];

const articlesToShow = latestArticles.length > 0 ? latestArticles : fallbackArticles;
---

<Layout title="Ballqish - Sepatu Pantofel Pria & Wanita Handmade Sidoarjo | Grosir & Eceran">
  <Header />

  <main class="flex-1 bg-[#FAF9F6] text-gray-800 font-body">
    
    {/* SECTION 2: HERO SECTION (Dual Funnel B2C & B2B) */}
    <section class="relative w-full bg-gradient-to-b from-[#EFEBE9] via-[#FAF9F6] to-white pt-12 pb-20 px-4 sm:px-6 lg:px-8 border-b border-gray-100 overflow-hidden">
      <div class="max-w-[1400px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        {/* Left Column: Headline & Dual CTA */}
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left z-10">
          <div class="inline-flex items-center gap-2 bg-[#5c1616]/10 border border-[#5c1616]/20 px-3.5 py-1.5 rounded-full">
            <span class="w-2 h-2 rounded-full bg-[#5c1616] animate-pulse"></span>
            <span class="text-xs font-medium text-[#5c1616] uppercase tracking-wider">Pengrajin Asli Sruni, Sidoarjo</span>
          </div>

          {/* SINGLE H1 FOR SEO */}
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-medium text-gray-900 leading-tight tracking-tight">
            Sepatu Pantofel Handmade Nyaman & Terjangkau — Langsung dari Pengrajin Sidoarjo
          </h1>

          <p class="text-base sm:text-lg text-gray-600 font-normal leading-relaxed max-w-2xl mx-auto lg:mx-0">
            Kombinasi presisi buatan tangan, sol empuk anti-licin, dan desain elegan. Diciptakan untuk mendukung kenyamanan kerja seharian para guru, PNS, karyawan, mahasiswa, hingga kebutuhan seragam grosir instansi.
          </p>

          {/* DUAL CTA BUTTONS */}
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
            <a 
              href="#collection" 
              class="w-full sm:w-auto inline-flex items-center justify-center bg-[#5c1616] text-white font-medium text-sm tracking-wider uppercase px-8 py-4 rounded-xl shadow-lg hover:bg-gray-900 transition-all duration-300 transform hover:-translate-y-0.5"
            >
              Belanja Eceran (B2C)
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>

            <a 
              href="#b2b" 
              class="w-full sm:w-auto inline-flex items-center justify-center bg-white text-amber-900 border-2 border-amber-700/40 font-medium text-sm tracking-wider uppercase px-8 py-4 rounded-xl hover:bg-amber-50 hover:border-amber-700 transition-all duration-300"
            >
              Kerja Sama Grosir / Instansi
              <svg class="w-4 h-4 ml-2 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0a2 2 0 012-2v-4a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 012 2m-6 0h6"></path></svg>
            </a>
          </div>

          <div class="pt-4 flex items-center justify-center lg:justify-start gap-6 text-xs text-gray-500 font-normal">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Siap Kirim Seluruh Indonesia
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Garansi Tukar Size 3 Hari
            </span>
          </div>
        </div>

        {/* Right Column: Featured Image */}
        <div class="lg:col-span-5 relative flex justify-center">
          <div class="relative w-full max-w-md aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-gray-100 group">
            <img 
              src={bgPantofel.src} 
              alt="Sepatu Pantofel Pria dan Wanita Handmade Pengrajin Sidoarjo - Ballqish" 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 bg-white/90 backdrop-blur-md p-3.5 rounded-2xl border border-white/50 shadow-sm flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-gray-900">Koleksi Pantofel Ballqish</p>
                <p class="text-[11px] text-gray-500">Harga Eceran mulai Rp 150rb-an</p>
              </div>
              <span class="text-xs font-medium text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">Stok Ready</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    {/* SECTION 3: TRUST SIGNAL BAR */}
    <section class="w-full bg-white border-b border-gray-200 py-6 px-4 sm:px-6 lg:px-8 shadow-2xs">
      <div class="max-w-[1400px] mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        
        <div class="flex flex-col items-center p-3">
          <div class="w-10 h-10 rounded-full bg-rose-50 text-[#5c1616] flex items-center justify-center mb-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
          </div>
          <h3 class="text-xs font-medium text-gray-900 uppercase tracking-wide">Pengrajin Asli Sidoarjo</h3>
          <p class="text-xs text-gray-500 font-normal mt-0.5">Dibuat tangan di Desa Sruni</p>
        </div>

        <div class="flex flex-col items-center p-3">
          <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-800 flex items-center justify-center mb-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
          </div>
          <h3 class="text-xs font-medium text-gray-900 uppercase tracking-wide">Ribuan Pasang Terjual</h3>
          <p class="text-xs text-gray-500 font-normal mt-0.5">Teruji awet oleh Guru & PNS</p>
        </div>

        <div class="flex flex-col items-center p-3">
          <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-800 flex items-center justify-center mb-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-xs font-medium text-gray-900 uppercase tracking-wide">Garansi Tukar Ukuran</h3>
          <p class="text-xs text-gray-500 font-normal mt-0.5">3 Hari pasca barang sampai</p>
        </div>

        <div class="flex flex-col items-center p-3">
          <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-800 flex items-center justify-center mb-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h3 class="text-xs font-medium text-gray-900 uppercase tracking-wide">Layanan Grosir B2B</h3>
          <p class="text-xs text-gray-500 font-normal mt-0.5">Bisa custom logo & seragam</p>
        </div>

      </div>
    </section>

    {/* SECTION 4: PRODUCT CATEGORIES & CATALOG GRID */}
    <section id="collection" class="py-20 max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Section Header */}
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-medium text-gray-900 tracking-tight uppercase mb-3">Koleksi Etalase Sepatu Pantofel</h2>
        <p class="text-sm text-gray-500 max-w-xl mx-auto font-normal">Pilih model yang paling sesuai dengan aktivitas harian Anda, mulai dari tipe tanpa tali (slip-on) hingga tipe bertali elegan.</p>
      </div>

      {/* 2 Big Category Showcase Cards */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        
        {/* Card 1: Tanpa Tali */}
        <div class="relative bg-white border border-gray-200 rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between overflow-hidden group">
          <div class="z-10">
            <span class="inline-block text-[11px] font-semibold text-rose-800 bg-rose-50 px-3 py-1 rounded-full uppercase tracking-wider mb-4 border border-rose-200">Kategori Praktis</span>
            <h3 class="text-xl font-medium text-gray-900 mb-2">Sepatu Pantofel Tanpa Tali (Loafers / Slip-On)</h3>
            <p class="text-sm text-gray-500 font-normal mb-6 leading-relaxed">Sangat disukai oleh guru, pegawai kantor, dan PNS karena praktis dilepas-pasang, sol ringan, dan nyaman dipakai bergerak sepanjang hari.</p>
            <button data-filter-category="tanpa-tali" class="category-filter-shortcut inline-flex items-center text-xs font-medium text-[#5c1616] hover:text-gray-900 uppercase tracking-widest cursor-pointer">
              Lihat Model Tanpa Tali →
            </button>
          </div>
        </div>

        {/* Card 2: Dengan Tali */}
        <div class="relative bg-white border border-gray-200 rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between overflow-hidden group">
          <div class="z-10">
            <span class="inline-block text-[11px] font-semibold text-amber-800 bg-amber-50 px-3 py-1 rounded-full uppercase tracking-wider mb-4 border border-amber-200">Kategori Formal</span>
            <h3 class="text-xl font-medium text-gray-900 mb-2">Sepatu Pantofel Bertali (Lace-Up Classic)</h3>
            <p class="text-sm text-gray-500 font-normal mb-6 leading-relaxed">Memberikan kesan gagah, rapi, dan profesional. Pilihan utama untuk wisuda, sidang skripsi, interview kerja, hingga pengadaan seragam instansi.</p>
            <button data-filter-category="dengan-tali" class="category-filter-shortcut inline-flex items-center text-xs font-medium text-[#5c1616] hover:text-gray-900 uppercase tracking-widest cursor-pointer">
              Lihat Model Bertali →
            </button>
          </div>
        </div>

      </div>

      {/* Catalog Filter Tabs */}
      <div class="flex justify-center gap-2 sm:gap-4 mb-10 overflow-x-auto pb-2 hide-scrollbar">
        <button
          type="button"
          class="catalog-tab px-6 py-3 border text-xs font-medium uppercase tracking-widest transition-colors border-gray-900 bg-gray-900 text-white rounded-xl cursor-pointer"
          data-tab="all"
        >
          Semua Produk ({allProducts.length})
        </button>
        <button
          type="button"
          class="catalog-tab px-6 py-3 border text-xs font-medium uppercase tracking-widest transition-colors border-gray-200 bg-white text-gray-600 hover:border-gray-900 hover:text-gray-900 rounded-xl cursor-pointer"
          data-tab="tanpa-tali"
        >
          Tanpa Tali (Slip-on)
        </button>
        <button
          type="button"
          class="catalog-tab px-6 py-3 border text-xs font-medium uppercase tracking-widest transition-colors border-gray-200 bg-white text-gray-600 hover:border-gray-900 hover:text-gray-900 rounded-xl cursor-pointer"
          data-tab="dengan-tali"
        >
          Dengan Tali (Lace-up)
        </button>
      </div>

      {/* Product Cards Grid */}
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {allProducts.map((product) => {
          const isNoLace = product.type === 'Tanpa Tali' || product.model?.toLowerCase().includes('tanpa tali') || product.name?.toLowerCase().includes('slip');
          const categoryTag = isNoLace ? 'tanpa-tali' : 'dengan-tali';
          return (
            <div class="catalog-product-item" data-category={categoryTag}>
              <ProductCard product={product} />
            </div>
          );
        })}
      </div>

    </section>

    {/* SECTION 5: KENAPA PILIH BALLQISH? (VALUE PROPOSITION) */}
    <section class="py-20 bg-white border-y border-gray-100">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-16">
          <h2 class="text-2xl sm:text-3xl font-medium text-gray-900 tracking-tight uppercase mb-3">Kenapa Memilih Sepatu Pantofel Ballqish?</h2>
          <p class="text-sm text-gray-500 font-normal max-w-xl mx-auto">Kami menggabungkan kenyamanan sol modern dengan ketelitian pengrajin lokal untuk menghasilkan sepatu yang siap menemani setiap aktivitas profesional Anda.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          
          <div class="p-6 bg-[#FAF9F6] border border-gray-200/80 rounded-2xl">
            <div class="w-12 h-12 rounded-xl bg-rose-100/60 text-[#5c1616] flex items-center justify-center mb-4 text-xl">
              👞
            </div>
            <h3 class="text-base font-medium text-gray-900 mb-2">Sol Empuk & Anti-Licin</h3>
            <p class="text-xs text-gray-500 font-normal leading-relaxed">Menggunakan pilihan outsole TPR & Karet fleksibel yang tidak licin di ubin basah serta insole berpori untuk mencegah kaki lelah saat berdiri lama.</p>
          </div>

          <div class="p-6 bg-[#FAF9F6] border border-gray-200/80 rounded-2xl">
            <div class="w-12 h-12 rounded-xl bg-amber-100/60 text-amber-800 flex items-center justify-center mb-4 text-xl">
              🔨
            </div>
            <h3 class="text-base font-medium text-gray-900 mb-2">Handmade Pengrajin Sidoarjo</h3>
            <p class="text-xs text-gray-500 font-normal leading-relaxed">Setiap pasang sepatu dijahit dan dibentuk langsung oleh pengrajin berpengalaman di sentra sepatu Desa Sruni, Gedangan, Sidoarjo.</p>
          </div>

          <div class="p-6 bg-[#FAF9F6] border border-gray-200/80 rounded-2xl">
            <div class="w-12 h-12 rounded-xl bg-emerald-100/60 text-emerald-800 flex items-center justify-center mb-4 text-xl">
              🏷️
            </div>
            <h3 class="text-base font-medium text-gray-900 mb-2">Harga Tangan Pertama</h3>
            <p class="text-xs text-gray-500 font-normal leading-relaxed">Karena diproduksi sendiri tanpa rantai perantara panjang, Anda mendapatkan harga yang sangat terjangkau dengan kualitas jahitan terjamin.</p>
          </div>

          <div class="p-6 bg-[#FAF9F6] border border-gray-200/80 rounded-2xl">
            <div class="w-12 h-12 rounded-xl bg-blue-100/60 text-blue-800 flex items-center justify-center mb-4 text-xl">
              💼
            </div>
            <h3 class="text-base font-medium text-gray-900 mb-2">Serbaguna untuk Segala Acara</h3>
            <p class="text-xs text-gray-500 font-normal leading-relaxed">Desain netral dan elegan yang serasi dipakai untuk mengajar di sekolah, bertugas di kantor dinas, sidang skripsi, hingga acara keagamaan.</p>
          </div>

        </div>

      </div>
    </section>

    {/* SECTION 6: SECTION KHUSUS B2B (GROSIR & INSTANSI) */}
    <section id="b2b" class="py-20 bg-gradient-to-br from-amber-950 via-[#3a0e0e] to-gray-900 text-white relative overflow-hidden">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-7 space-y-6">
            <span class="inline-block bg-amber-400/20 text-amber-300 border border-amber-400/30 text-xs font-semibold px-3.5 py-1 rounded-full uppercase tracking-widest">
              Fasilitas B2B & Kerja Sama Grosir
            </span>

            <h2 class="text-3xl sm:text-4xl font-medium leading-tight tracking-tight">
              Kerja Sama Grosir, Reseller & Pengadaan Seragam Instansi
            </h2>

            <p class="text-sm sm:text-base text-gray-300 font-normal leading-relaxed">
              Ballqish melayani pemesanan sepatu pantofel partai besar langsung dari workshop pengrajin Sidoarjo. Sangat cocok untuk mitra reseller, toko sepatu daerah, pengadaan instansi pemerintah/PNS, perusahaan swasta, maupun sekolah.
            </p>

            <ul class="space-y-3 text-xs sm:text-sm text-gray-200 font-normal">
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0 mt-0.5">✓</span>
                <span><strong>Harga Grosir Khusus:</strong> Diskon kuantitas menarik untuk pemesanan mulai dari 12 pasang hingga ribuan pasang.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0 mt-0.5">✓</span>
                <span><strong>Custom Ukuran & Logo:</strong> Bisa request embossed logo instansi/perusahaan dan penyesuaian spesifikasi sol.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0 mt-0.5">✓</span>
                <span><strong>Dokumen & Invoice Resmi:</strong> Mendukung pengadaan formal instansi dengan nota dan faktur lengkap.</span>
              </li>
            </ul>

            <div class="pt-4">
              <a 
                href="https://wa.me/6281234567890?text=Halo%20Tim%20B2B%20Ballqish,%20saya%20tertarik%20untuk%20kerja%20sama%20grosir%2Fseragam%20instansi" 
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-xs sm:text-sm uppercase tracking-wider px-8 py-4 rounded-xl shadow-xl transition-all duration-300 transform hover:scale-105"
              >
