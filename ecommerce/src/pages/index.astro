      </div>
      <button class="close-modal text-ink/40 hover:text-oxblood transition-colors p-1" aria-label="Tutup">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div id="cart-items" class="flex-1 overflow-y-auto p-6 space-y-4 bg-ivory">
    </div>
    <div class="border-t border-line p-6 bg-ivory">
      <div class="flex justify-between items-center mb-6">
        <span class="text-[11px] uppercase tracking-[0.25em] text-ink/50">Total Pembayaran</span>
        <span id="cart-total" class="text-[20px] font-semibold text-ink">Rp 0</span>
      </div>
      <button id="btn-checkout-wa" class="w-full bg-ink text-ivory text-[11px] uppercase tracking-[0.3em] py-4 hover:bg-oxblood transition-colors cursor-pointer">
        Lanjut ke Pembayaran
