    <section id="faq" class="pb-24">
      <div class="max-w-3xl mx-auto px-6 md:px-10">

        <div class="text-center mb-12">
          <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-5">Pertanyaan Umum</span>
          <h2 class="display-font text-4xl md:text-5xl font-normal text-ink leading-[1.25]">Pertanyaan Sering Diajukan</h2>
          <div class="w-12 h-px bg-brass mx-auto mt-6"></div>
        </div>

        <div>

          <details class="group border-t border-line cursor-pointer">
            <summary class="flex justify-between items-start gap-6 py-6 text-[17px] text-ink list-none transition-colors hover:text-oxblood">
              Apakah sepatu pantofel Ballqish nyaman dipakai berdiri seharian?
              <span class="shrink-0 text-ink/40 transition-transform duration-300 group-open:rotate-180">↓</span>
