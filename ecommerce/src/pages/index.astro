  <AddressModal />
  <Footer />

  <style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* Hero body copy — perlu CSS eksplisit karena aturan global
       `p { font-size: 1.2rem }` berada di luar @layer sehingga mengalahkan
       utility class dari Tailwind. */
    .hero-bodycopy {
      font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.625;
      color: rgba(26, 21, 18, 0.7);
      max-width: 420px;
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase';
    
    document.addEventListener('DOMContentLoaded', () => {
      let cart = [];
      let favorites = [];

      const catalogTabs = document.querySelectorAll('.catalog-tab');
      const catalogProducts = document.querySelectorAll('.catalog-product-item');
      const shortcutCategoryBtns = document.querySelectorAll('.category-filter-shortcut');
      
      const addToCartBtns = document.querySelectorAll('.add-to-cart');
      const favBtns = document.querySelectorAll('.favorite-btn');
      
      const overlay = document.getElementById('modal-overlay');
      const cartModal = document.getElementById('cart-modal');
      const favModal = document.getElementById('favorites-modal');
      const orderModal = document.getElementById('orders-modal');

      // FIX: variabel ini dideklarasikan di Header.astro (scope modul terpisah),
      // sehingga sebelumnya ReferenceError menghentikan seluruh script ini.
      const triggerCart = document.getElementById('cart-button');
      const triggerFav = document.getElementById('favorites-btn');
      const triggerOrder = document.getElementById('orders-btn');
      const closeBtns = document.querySelectorAll('.close-modal');
      
      try {
        const c = localStorage.getItem('ballqish_cart');
        const f = localStorage.getItem('ballqish_favs');
        if (c) {
          cart = JSON.parse(c);
          cart = cart.filter(item => item.id && item.id.length === 36);
          localStorage.setItem('ballqish_cart', JSON.stringify(cart));
        }
        if (f) {
          favorites = JSON.parse(f);
          favorites = favorites.filter(item => item.id && item.id.length === 36);
          localStorage.setItem('ballqish_favs', JSON.stringify(favorites));
        }
      } catch(e) {}

      // Tab Switcher with Underline Indicator Active State
      function filterProducts(categoryTab) {
        catalogTabs.forEach(tab => {
          const isActive = (tab as HTMLButtonElement).dataset.tab === categoryTab;
          if (isActive) {
            tab.classList.add('border-black', 'text-ink', 'font-semibold');
            tab.classList.remove('border-transparent', 'text-ink/60', 'font-normal');
          } else {
            tab.classList.remove('border-black', 'text-ink', 'font-semibold');
            tab.classList.add('border-transparent', 'text-ink/60', 'font-normal');
          }
        });

        catalogProducts.forEach(product => {
          const pCat = product.getAttribute('data-category');
          if (categoryTab === 'all' || pCat === categoryTab) {
            product.classList.remove('hidden');
          } else {
            product.classList.add('hidden');
          }
        });
      }

      catalogTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const categoryTab = (tab as HTMLButtonElement).dataset.tab || 'all';
          filterProducts(categoryTab);
        });
      });

      shortcutCategoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = (btn as HTMLButtonElement).dataset.filterCategory || 'all';
          filterProducts(cat);
          const grid = document.getElementById('product-grid');
          if (grid) grid.scrollIntoView({ behavior: 'smooth' });
        });
      });

      function updateFavUI() {
        favBtns.forEach(btn => {
          const b = btn as HTMLButtonElement;
          const id = b.dataset.productId;
          const icon = b.querySelector('.heart-icon');
          if (favorites.some(f => f.id === id)) {
            icon.classList.add('text-red-500', 'fill-red-500');
            icon.classList.remove('text-gray-300', 'fill-current');
          } else {
            icon.classList.remove('text-red-500', 'fill-red-500');
            icon.classList.add('text-gray-300', 'fill-current');
          }
        });
        
        const favContainer = document.getElementById('favorites-items');
        if (favorites.length === 0) {
          favContainer.innerHTML = '<div class="flex flex-col items-center justify-center h-full text-ink/35 mt-20"><svg class="w-14 h-14 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg><p class="text-[11px] uppercase tracking-[0.25em]">Belum ada favorit</p></div>';
        } else {
          favContainer.innerHTML = favorites.map(item => `
            <div class="flex items-center gap-4 bg-white border border-line p-3">
              <img src="${item.image}" class="w-20 h-24 object-cover" />
              <div class="flex-1 min-w-0">
                <h4 class="display-font text-[18px] font-normal text-ink line-clamp-2 leading-snug">${item.name}</h4>
                <p class="text-[14px] font-semibold text-ink mt-1.5">Rp ${item.price.toLocaleString('id-ID')}</p>
              </div>
            </div>
          `).join('');
        }
        localStorage.setItem('ballqish_favs', JSON.stringify(favorites));
        // Update count di header langsung juga
        const favCountEl = document.getElementById('favorites-count');
        if (favCountEl) {
          if (favorites.length > 0) {
            favCountEl.textContent = favorites.length.toString();
            favCountEl.classList.remove('hidden');
          } else {
            favCountEl.classList.add('hidden');
          }
        }
        window.dispatchEvent(new Event('favoritesUpdated'));
      }

      function updateCartUI() {
        const cartCountEl = document.getElementById('cart-count');
        const cartTotalEl = document.getElementById('cart-total');
        const cartItemsEl = document.getElementById('cart-items');
        
        const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
        const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        
        if(totalItems > 0 && cartCountEl) {
          cartCountEl.textContent = totalItems.toString();
          cartCountEl.classList.remove('hidden');
        } else if (cartCountEl) {
          cartCountEl.classList.add('hidden');
        }
        
        if (cartTotalEl) cartTotalEl.textContent = `Rp ${totalPrice.toLocaleString('id-ID')}`;
        
        if (cartItemsEl) {
          if (cart.length === 0) {
            cartItemsEl.innerHTML = '<div class="flex flex-col items-center justify-center h-full text-ink/35 mt-20"><svg class="w-14 h-14 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg><p class="text-[11px] uppercase tracking-[0.25em]">Keranjang masih kosong</p></div>';
          } else {
            cartItemsEl.innerHTML = cart.map(item => `
              <div class="flex items-center gap-4 bg-white border border-line p-3">
                <img src="${item.image}" class="w-20 h-24 object-cover" />
                <div class="flex-1 min-w-0">
                  <h4 class="display-font text-[18px] font-normal text-ink line-clamp-2 leading-snug">${item.name}</h4>
                  <div class="flex flex-wrap gap-1.5 mt-2">
                    <span class="text-[10px] uppercase tracking-[0.15em] text-ink/60 bg-bone px-2 py-1">Ukuran ${item.size}</span>
                    <span class="text-[10px] uppercase tracking-[0.15em] text-ink/60 bg-bone px-2 py-1">Qty ${item.quantity}</span>
                  </div>
                  <p class="text-[14px] font-semibold text-ink mt-2">Rp ${(item.price * item.quantity).toLocaleString('id-ID')}</p>
                </div>
              </div>
            `).join('');
          }
        }
        
        localStorage.setItem('ballqish_cart', JSON.stringify(cart));
      }

      addToCartBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const b = e.currentTarget as HTMLButtonElement;
          const id = b.dataset.productId;
          window.location.href = `/product/${id}`;
        });
      });

      favBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const b = e.currentTarget as HTMLButtonElement;
          const id = b.dataset.productId;
          const name = b.dataset.productName;
          const price = parseInt(b.dataset.productPrice || "0");
          const image = b.dataset.productImage;
          
          const existingIndex = favorites.findIndex(f => f.id === id);
          if (existingIndex > -1) {
            favorites.splice(existingIndex, 1);
          } else {
            favorites.push({ id, name, price, image });
          }
          updateFavUI();
          
          b.classList.add('scale-125');
          setTimeout(() => b.classList.remove('scale-125'), 200);
        });
      });

      function openModal(modalEl) {
        overlay.classList.remove('hidden');
        setTimeout(() => overlay.classList.remove('opacity-0'), 10);
        modalEl.classList.remove('translate-x-full');
      }
      
      function closeAllModals() {
        overlay.classList.add('opacity-0');
        cartModal.classList.add('translate-x-full');
        favModal.classList.add('translate-x-full');
        orderModal.classList.add('translate-x-full');
        setTimeout(() => overlay.classList.add('hidden'), 300);
      }

      triggerCart?.addEventListener('click', () => openModal(cartModal));
      triggerFav?.addEventListener('click', () => openModal(favModal));
      triggerOrder?.addEventListener('click', () => openModal(orderModal));
      
      closeBtns.forEach(btn => btn.addEventListener('click', closeAllModals));
      overlay.addEventListener('click', closeAllModals);

      const checkoutBtn = document.getElementById('btn-checkout-wa');
      checkoutBtn?.addEventListener('click', async () => {
        if (cart.length === 0) {
          if (window.showToast) window.showToast('Keranjang masih kosong!', 'error');
          return;
        }

        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          if (window.showToast) window.showToast('Silakan Masuk/Daftar terlebih dahulu untuk Checkout', 'error');
          setTimeout(() => window.location.href = '/login', 2000);
          return;
        }
        
        window.location.href = '/checkout';
      });
      
      async function loadOrders() {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;
        
        const { data: orders, error } = await supabase
          .from('orders')
          .select('*, order_items(*)')
          .eq('user_id', session.user.id)
          .order('created_at', { ascending: false });

        const ordersContainer = document.getElementById('orders-items');
        if (!ordersContainer || error) return;
        
        if (orders.length === 0) {
          ordersContainer.innerHTML = `
            <div class="flex flex-col items-center justify-center h-full text-ink/35 mt-20">
              <svg class="w-14 h-14 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <p class="text-[11px] uppercase tracking-[0.25em]">Belum ada riwayat pesanan</p>
            </div>
          `;
          return;
        }

        ordersContainer.innerHTML = orders.map(order => {
          let statusColor = 'bg-bone text-ink/70 border-line';
          if (order.status === 'Menunggu Pembayaran') statusColor = 'bg-brass/15 text-[#7a5c2e] border-brass/40';
          if (order.status === 'Diproses') statusColor = 'bg-ink/5 text-ink border-ink/20';
          if (order.status === 'Dikirim') statusColor = 'bg-oxblood/10 text-oxblood border-oxblood/30';
          if (order.status === 'Selesai') statusColor = 'bg-bone text-ink border-line';
          if (order.status === 'Dibatalkan') statusColor = 'bg-oxblood/5 text-ink/50 border-line';

          return `
            <div class="bg-white border border-line p-5">
              <div class="flex justify-between items-start mb-4 gap-3">
                <div>
                  <span class="block text-[10px] uppercase tracking-[0.25em] text-ink/45">Order #${order.id.slice(0,8)}</span>
                  <h4 class="display-font text-[18px] font-normal text-ink mt-1.5 leading-tight">${new Date(order.created_at).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year:'numeric'})}</h4>
                </div>
                <span class="${statusColor} border text-[10px] uppercase tracking-[0.15em] px-2 py-1 whitespace-nowrap">${order.status}</span>
              </div>
              
              <div class="space-y-3 mt-4 pt-4 border-t border-line">
                ${order.order_items.map(item => `
                  <div class="flex gap-3">
                    <img src="${item.product_image}" class="w-14 h-14 object-cover" />
                    <div class="flex-1 min-w-0">
                      <p class="text-[13px] font-semibold text-ink line-clamp-1">${item.product_name}</p>
                      <p class="text-[11px] text-ink/50 mt-1">Size ${item.size} | ${item.outsole_model || ''}</p>
                      <p class="text-[11px] text-ink/50">Qty: ${item.quantity} x Rp ${item.price.toLocaleString('id-ID')}</p>
                    </div>
                  </div>
                `).join('')}
              </div>

              <div class="flex justify-between items-center pt-4 mt-4 border-t border-line">
                <span class="text-[10px] uppercase tracking-[0.25em] text-ink/45">Total</span>
                <span class="text-[15px] font-semibold text-ink">Rp ${order.total_amount.toLocaleString('id-ID')}</span>
              </div>
            </div>
          `;
        }).join('');
      }

      updateFavUI();
      updateCartUI();
      loadOrders();

      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('openCart') === 'true') {
        openModal(cartModal);
        window.history.replaceState({}, document.title, window.location.pathname);
      } else if (urlParams.get('openFav') === 'true') {
        openModal(favModal);
        window.history.replaceState({}, document.title, window.location.pathname);
      } else if (urlParams.get('openOrders') === 'true') {
        openModal(orderModal);
        window.history.replaceState({}, document.title, window.location.pathname);
      } else if (urlParams.get('openAddress') === 'true') {
        if ((window as any).openAddressModal) (window as any).openAddressModal();
        window.history.replaceState({}, document.title, window.location.pathname);
      } else if (urlParams.get('success') === 'true') {
        if (window.showToast) window.showToast('Pembayaran Sukses! Pesanan Anda sedang diproses.', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
      }
    });
  </script>
</Layout>
