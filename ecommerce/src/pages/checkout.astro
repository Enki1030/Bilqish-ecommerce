---
import Layout from '../layouts/Layout.astro';
import AddressModal from '../components/AddressModal.astro';
---

<Layout title="Checkout & Pembayaran - Ballqish Shoes">
  <div class="bg-[#FAF9F6] min-h-screen py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header / Back Button -->
      <div class="mb-8 border-b border-gray-200 pb-4">
        <a href="/?openCart=true" class="inline-flex items-center text-xs font-heading font-semibold tracking-widest uppercase text-gray-500 hover:text-primary transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Kembali ke Keranjang
        </a>
      </div>

      <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
        
        <!-- LEFT: Payment & Shipping Details -->
        <div class="flex-1 space-y-6">
          
          <!-- Informasi Pengiriman -->
          <div class="bg-white p-4 sm:p-8 border border-gray-200 rounded-xl sm:rounded-none space-y-5">
            <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 border-b border-gray-100 pb-4">
              <div>
                <h2 class="text-xs font-heading font-bold text-gray-900 uppercase tracking-widest">
                  Informasi Pengiriman
                </h2>
                <p class="text-[11px] text-gray-500 font-body mt-0.5">Cari nama daerah, gunakan GPS, atau pilih alamat tersimpan</p>
              </div>
              <div class="flex items-center gap-2">
                <button 
                  id="btn-checkout-gps" 
                  type="button" 
                  class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 px-3 py-1.5 rounded-lg transition-colors cursor-pointer active:scale-95 shadow-2xs"
                >
                  <svg class="w-3.5 h-3.5 animate-spin hidden" id="checkout-gps-spinner" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                  <svg class="w-3.5 h-3.5 text-emerald-700" id="checkout-gps-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <span>🎯 Deteksi GPS Saya</span>
                </button>
                <button 
                  id="btn-open-address-book" 
                  type="button" 
                  class="inline-flex items-center gap-1.5 text-xs font-heading font-bold text-[#5c1616] hover:text-[#400f0f] uppercase tracking-wider bg-rose-50 border border-rose-200 px-3 py-1.5 rounded-lg transition-colors cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                  Buku Alamat & Peta
                </button>
              </div>
            </div>

            <!-- Direct Address Search Bar (Desktop & Mobile) -->
            <div class="relative z-20">
              <label class="block text-[11px] font-heading font-bold text-gray-800 uppercase tracking-wide mb-1.5 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-[#5c1616]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                Pencarian Cepat Daerah / Alamat
              </label>
              <div class="flex items-center border-2 border-gray-900 rounded-xl overflow-hidden bg-white shadow-xs focus-within:ring-2 focus-within:ring-[#5c1616]">
                <div class="pl-3 text-gray-500">
                  <svg class="w-4 h-4 text-[#5c1616]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
                <input 
                  type="text" 
                  id="checkout-search-input" 
                  class="w-full bg-white px-3 py-2.5 text-xs font-body focus:outline-none placeholder-gray-400" 
                  placeholder="Ketik nama daerah/kecamatan/jalan (contoh: Wonokromo, Cibaduyut, Kemang...)" 
                />
                <button id="btn-clear-checkout-search" type="button" class="hidden pr-3 text-gray-400 hover:text-gray-900 text-xs cursor-pointer">✕</button>
              </div>

              <!-- Search Results Dropdown -->
              <div id="checkout-search-results" class="absolute left-0 right-0 top-full mt-1.5 bg-white border border-gray-200 rounded-xl shadow-2xl z-50 max-h-56 overflow-y-auto hidden text-xs font-body divide-y divide-gray-100"></div>

              <!-- Quick Search Chips -->
              <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pt-2 text-[11px]">
                <span class="text-gray-400 text-[10px] shrink-0 font-medium">Contoh:</span>
                {['Wonokromo, Surabaya', 'Cibaduyut, Bandung', 'Kemang, Jakarta', 'Malioboro, Jogja', 'Simpang Lima, Semarang'].map(chip => (
                  <button 
                    type="button" 
                    class="checkout-quick-chip shrink-0 bg-gray-100 hover:bg-rose-50 hover:border-rose-300 text-gray-800 px-2.5 py-1 rounded-full text-[10px] font-medium border border-gray-200 transition-colors cursor-pointer"
                    data-query={chip}
                  >
                    {chip}
                  </button>
                ))}
              </div>
            </div>

            <!-- Active Selected Address Banner -->
            <div id="selected-address-badge" class="hidden p-3.5 bg-rose-50/60 border border-rose-200/80 rounded-xl flex items-start gap-3">
              <div class="p-1.5 bg-white text-[#5c1616] rounded-lg shadow-2xs mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <div class="flex-1 text-xs">
                <div class="flex items-center gap-2">
                  <span id="badge-addr-label" class="font-heading font-bold uppercase tracking-wider text-gray-900">Alamat Terpilih</span>
                  <span class="text-[9px] bg-emerald-100 text-emerald-800 px-1.5 py-0.2 rounded font-semibold">Tersinkronisasi</span>
                </div>
                <p id="badge-addr-detail" class="text-gray-600 mt-1 font-body leading-snug"></p>
              </div>
            </div>

            <div class="space-y-4">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-heading font-semibold text-gray-900 mb-2 uppercase tracking-wide">Nama Penerima</label>
                  <input type="text" id="cust-name" class="w-full border border-gray-300 px-4 py-3 text-sm font-body focus:outline-none focus:border-gray-900 bg-transparent transition-colors rounded-lg sm:rounded-none" placeholder="John Doe">
                </div>
                <div>
                  <label class="block text-xs font-heading font-semibold text-gray-900 mb-2 uppercase tracking-wide">Nomor Telepon (WA)</label>
                  <input type="tel" id="cust-phone" class="w-full border border-gray-300 px-4 py-3 text-sm font-body focus:outline-none focus:border-gray-900 bg-transparent transition-colors rounded-lg sm:rounded-none" placeholder="081234567890">
                </div>
              </div>
              <div>
                <label class="block text-xs font-heading font-semibold text-gray-900 mb-2 uppercase tracking-wide">Alamat Lengkap</label>
                <textarea id="cust-address" rows="3" class="w-full border border-gray-300 px-4 py-3 text-sm font-body focus:outline-none focus:border-gray-900 bg-transparent transition-colors rounded-lg sm:rounded-none" placeholder="Jl. Sudirman No. 123..."></textarea>
              </div>
            </div>
          </div>

          <!-- Metode Pembayaran -->
          <div class="bg-white p-4 sm:p-8 border border-gray-200 rounded-xl sm:rounded-none">
            <h2 class="text-xs font-heading font-bold text-gray-900 mb-6 uppercase tracking-widest">
              Metode Pembayaran
            </h2>
            
            <div class="space-y-3">
              <!-- E-Wallet -->
              <label class="payment-method border border-gray-200 p-4 flex items-center cursor-pointer hover:border-gray-900 transition-colors bg-white rounded-lg sm:rounded-none">
                <input type="radio" name="payment" value="ewallet" class="text-primary focus:ring-primary mr-4 w-4 h-4">
                <div class="flex-1">
                  <span class="font-heading font-semibold text-gray-900 block text-sm tracking-wide">E-Wallet</span>
                  <span class="text-xs text-gray-500 font-body">GoPay, OVO, DANA, ShopeePay</span>
                </div>
              </label>

              <!-- Bank Transfer -->
              <label class="payment-method border border-gray-200 p-4 flex items-center cursor-pointer hover:border-gray-900 transition-colors bg-white rounded-lg sm:rounded-none">
                <input type="radio" name="payment" value="bank" class="text-primary focus:ring-primary mr-4 w-4 h-4">
                <div class="flex-1">
                  <span class="font-heading font-semibold text-gray-900 block text-sm tracking-wide">Transfer Bank (Virtual Account)</span>
                  <span class="text-xs text-gray-500 font-body">BCA, Mandiri, BNI, BRI</span>
                </div>
              </label>

              <!-- QRIS -->
              <label class="payment-method border border-gray-200 p-4 flex items-center cursor-pointer hover:border-gray-900 transition-colors bg-white rounded-lg sm:rounded-none">
                <input type="radio" name="payment" value="qris" class="text-primary focus:ring-primary mr-4 w-4 h-4">
                <div class="flex-1">
                  <span class="font-heading font-semibold text-gray-900 block text-sm tracking-wide">QRIS</span>
                  <span class="text-xs text-gray-500 font-body">Scan dengan aplikasi M-Banking atau E-Wallet</span>
                </div>
              </label>
            </div>

            <!-- QRIS Dummy Display -->
            <div id="qris-display" class="hidden mt-6 p-6 border border-gray-300 text-center bg-[#FAF9F6] rounded-xl sm:rounded-none">
              <p class="text-xs font-heading font-semibold text-gray-900 uppercase tracking-widest mb-4">Scan kode QR (DUMMY)</p>
              <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=DUMMY_PAYMENT_QRIS_BALLQISH" alt="QRIS Dummy" class="mx-auto border border-gray-200 mix-blend-multiply">
              <p class="text-xs text-gray-500 mt-4">Peringatan: Ini hanya demonstrasi e-commerce.</p>
            </div>
          </div>

        </div>

        <!-- RIGHT: Order Summary -->
        <div class="w-full lg:w-96 flex-shrink-0">
          <div class="bg-white p-4 sm:p-8 border border-gray-200 rounded-xl sm:rounded-none sticky top-28">
            <h3 class="text-xs font-heading font-bold text-gray-900 uppercase tracking-widest mb-6">Ringkasan Pesanan</h3>
            
            <!-- Items Container -->
            <div id="checkout-items" class="space-y-4 mb-8 max-h-80 overflow-y-auto pr-2 hide-scrollbar">
              <!-- Diisi via JS -->
            </div>

            <!-- Voucher (Flush aligned & Responsive) -->
            <div class="mb-8 pt-8 border-t border-gray-200">
              <label class="block text-xs font-heading font-semibold text-gray-900 mb-3 uppercase tracking-wide">Kode Voucher</label>
              <div class="flex w-full border border-gray-300 rounded-lg focus-within:border-gray-900 overflow-hidden transition-colors">
                <input 
                  type="text" 
                  id="voucher-code" 
                  class="flex-1 min-w-0 border-none px-3.5 py-3 text-sm font-body focus:outline-none focus:ring-0 bg-transparent uppercase" 
                  placeholder="BQL2026"
                >
                <button 
                  id="apply-voucher" 
                  type="button"
                  class="bg-gray-900 text-white px-5 sm:px-6 py-3 text-xs font-heading font-semibold uppercase tracking-widest hover:bg-primary transition-colors shrink-0 cursor-pointer"
                >
                  Apply
                </button>
              </div>
            </div>

            <!-- Totals -->
            <div class="space-y-4 pt-8 border-t border-gray-200 mb-8 font-body">
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Subtotal</span>
                <span id="summary-subtotal" class="font-bold text-gray-900">Rp 0</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Ongkos Kirim (Flat)</span>
                <span id="summary-shipping" class="font-bold text-gray-900">Rp 7.000</span>
              </div>
              <div id="discount-row" class="flex justify-between text-sm hidden text-gray-900">
                <span class="text-gray-500">Diskon</span>
                <span id="summary-discount" class="font-bold">- Rp 0</span>
              </div>
              <div class="flex justify-between items-center pt-4 mt-4 border-t border-gray-200">
                <span class="text-xs font-heading font-bold text-gray-900 uppercase tracking-widest">Total Tagihan</span>
                <span id="summary-total" class="text-xl font-heading font-bold text-gray-900">Rp 0</span>
              </div>
            </div>

            <button id="btn-pay-now" class="w-full bg-primary border border-primary text-white font-heading font-semibold text-xs uppercase tracking-widest px-4 py-4 hover:bg-gray-900 hover:border-gray-900 transition-colors flex justify-center items-center rounded-lg sm:rounded-none cursor-pointer">
              Bayar Sekarang
            </button>
            <p class="text-[10px] text-gray-400 text-center mt-4 flex items-center justify-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              Pembayaran Anda aman dan terenkripsi.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    document.addEventListener('DOMContentLoaded', async () => {
      let cart = [];
      try {
        const c = localStorage.getItem('ballqish_cart');
        if (c) {
          cart = JSON.parse(c);
          cart = cart.filter((item: any) => item.id && item.id.length === 36);
          localStorage.setItem('ballqish_cart', JSON.stringify(cart));
        }
      } catch(e) {}

      if (cart.length === 0) {
        window.location.href = '/?openCart=true';
        return;
      }

      // Check Session & Pre-fill
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/login';
        return;
      }

      const custName = document.getElementById('cust-name') as HTMLInputElement;
      if (custName && session.user.user_metadata?.full_name) {
        custName.value = session.user.user_metadata.full_name;
      }

      const shippingCost = 7000;
      let discountAmount = 0;
      let finalTotal = 0;

      function renderSummary() {
        const itemsContainer = document.getElementById('checkout-items');
        if (itemsContainer) {
          itemsContainer.innerHTML = cart.map((item: any) => `
            <div class="flex gap-4">
              <img src="${item.image}" class="w-16 h-16 object-cover mix-blend-multiply bg-gray-50 border border-gray-200" />
              <div class="flex-1">
                <p class="text-xs font-heading font-semibold text-gray-900 tracking-wide uppercase line-clamp-1">${item.name}</p>
                <p class="text-[11px] font-body text-gray-500 mt-1">Size ${item.size} • ${item.outsole || 'Model 1'}</p>
                <div class="flex justify-between items-center mt-2">
                  <span class="text-[13px] font-body font-bold text-gray-900">${item.quantity} x Rp ${item.price.toLocaleString('id-ID')}</span>
                </div>
              </div>
            </div>
          `).join('');
        }

        const subtotal = cart.reduce((sum: number, item: any) => sum + (item.price * item.quantity), 0);
        finalTotal = subtotal + shippingCost - discountAmount;

        const elSubtotal = document.getElementById('summary-subtotal');
        const elTotal = document.getElementById('summary-total');
        const elDiscount = document.getElementById('summary-discount');
        const rowDiscount = document.getElementById('discount-row');

        if (elSubtotal) elSubtotal.textContent = `Rp ${subtotal.toLocaleString('id-ID')}`;
        if (elTotal) elTotal.textContent = `Rp ${finalTotal.toLocaleString('id-ID')}`;
        
        if (discountAmount > 0 && elDiscount && rowDiscount) {
          elDiscount.textContent = `- Rp ${discountAmount.toLocaleString('id-ID')}`;
          rowDiscount.classList.remove('hidden');
        }
      }

      renderSummary();

      // Voucher Logic
      const btnApplyVoucher = document.getElementById('apply-voucher');
      btnApplyVoucher?.addEventListener('click', () => {
        const code = (document.getElementById('voucher-code') as HTMLInputElement).value.toUpperCase();
        if (code === 'DISKON20') {
          discountAmount = 20000;
          if (window.showToast) window.showToast('Voucher berhasil digunakan!', 'success');
        } else if (code) {
          discountAmount = 0;
          if (window.showToast) window.showToast('Voucher tidak valid atau sudah kadaluarsa', 'error');
        }
        renderSummary();
      });

      // Payment Method UI
      const paymentRadios = document.querySelectorAll('input[name="payment"]');
      const qrisDisplay = document.getElementById('qris-display');
      
      paymentRadios.forEach(radio => {
        radio.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          document.querySelectorAll('.payment-method').forEach(el => {
            el.classList.remove('border-red-600', 'bg-red-50');
            el.classList.add('border-gray-200');
          });
          
          if (target.checked) {
            target.closest('.payment-method')?.classList.add('border-gray-900', 'bg-[#FAF9F6]');
            target.closest('.payment-method')?.classList.remove('border-gray-200');
            
            if (target.value === 'qris' && qrisDisplay) {
              qrisDisplay.classList.remove('hidden');
            } else if (qrisDisplay) {
              qrisDisplay.classList.add('hidden');
            }
          }
        });
      });

      // Address Book & Direct Search Integration
      const btnOpenAddress = document.getElementById('btn-open-address-book');
      const badgeContainer = document.getElementById('selected-address-badge');
      const badgeLabel = document.getElementById('badge-addr-label');
      const badgeDetail = document.getElementById('badge-addr-detail');
      const checkoutSearchInput = document.getElementById('checkout-search-input') as HTMLInputElement;
      const checkoutSearchResults = document.getElementById('checkout-search-results');
      const btnClearCheckoutSearch = document.getElementById('btn-clear-checkout-search');
      const btnCheckoutGps = document.getElementById('btn-checkout-gps');

      btnOpenAddress?.addEventListener('click', () => {
        if ((window as any).openAddressModal) {
          (window as any).openAddressModal();
        }
      });

      function applyAddressToForm(addr: any) {
        if (!addr) return;
        const nameEl = document.getElementById('cust-name') as HTMLInputElement;
        const phoneEl = document.getElementById('cust-phone') as HTMLInputElement;
        const addrEl = document.getElementById('cust-address') as HTMLTextAreaElement;

        if (nameEl && !nameEl.value.trim()) nameEl.value = addr.recipient_name || '';
        if (phoneEl && !phoneEl.value.trim()) phoneEl.value = addr.recipient_phone || '';
        
        const fullTxt = [
          addr.full_address,
          addr.benchmark_notes ? `(Patokan: ${addr.benchmark_notes})` : '',
          addr.city ? `${addr.city}, ${addr.province || ''}` : ''
        ].filter(Boolean).join(' - ');

        if (addrEl) addrEl.value = fullTxt;

        if (badgeContainer && badgeLabel && badgeDetail) {
          badgeLabel.textContent = `${addr.label_name || 'Lokasi Terpilih'} (${addr.recipient_name || 'Pelanggan'})`;
          badgeDetail.textContent = fullTxt;
          badgeContainer.classList.remove('hidden');
        }
      }

      // Direct Live Search on Checkout Page
      btnClearCheckoutSearch?.addEventListener('click', () => {
        if (checkoutSearchInput) checkoutSearchInput.value = '';
        btnClearCheckoutSearch.classList.add('hidden');
        checkoutSearchResults?.classList.add('hidden');
      });

      async function performCheckoutSearch(query: string) {
        if (!query || query.length < 2) {
          checkoutSearchResults?.classList.add('hidden');
          btnClearCheckoutSearch?.classList.add('hidden');
          return;
        }

        btnClearCheckoutSearch?.classList.remove('hidden');

        try {
          const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&countrycodes=id&limit=6&addressdetails=1`);
          const results = await res.json();
          if (results && results.length > 0 && checkoutSearchResults) {
            checkoutSearchResults.innerHTML = results.map((item: any) => `
              <button type="button" class="w-full text-left px-3.5 py-2.5 hover:bg-rose-50 border-b border-gray-100 last:border-0 cursor-pointer search-item flex items-start gap-2.5 transition-colors" data-display="${item.display_name}" data-lat="${item.lat}" data-lon="${item.lon}">
                <span class="text-rose-600 mt-0.5 shrink-0">📍</span>
                <div class="min-w-0 flex-1">
                  <p class="font-bold text-gray-900 text-xs truncate">${item.display_name.split(',')[0]}</p>
                  <p class="text-[10px] text-gray-500 line-clamp-1">${item.display_name}</p>
                </div>
              </button>
            `).join('');
            checkoutSearchResults.classList.remove('hidden');

            checkoutSearchResults.querySelectorAll('.search-item').forEach(item => {
              item.addEventListener('click', (e: any) => {
                const display = e.currentTarget.dataset.display;
                const addrEl = document.getElementById('cust-address') as HTMLTextAreaElement;
                if (addrEl) addrEl.value = display;
                if (badgeContainer && badgeLabel && badgeDetail) {
                  badgeLabel.textContent = `Lokasi Terpilih (${display.split(',')[0]})`;
                  badgeDetail.textContent = display;
                  badgeContainer.classList.remove('hidden');
                }
                checkoutSearchResults.classList.add('hidden');
                if (window.showToast) window.showToast('Alamat berhasil dipilih dari pencarian!', 'success');
              });
            });
          } else {
            if (checkoutSearchResults) {
              checkoutSearchResults.innerHTML = '<div class="p-3 text-center text-gray-400 text-xs">Lokasi tidak ditemukan. Coba kata kunci lain.</div>';
              checkoutSearchResults.classList.remove('hidden');
            }
          }
        } catch(e) {}
      }

      let checkoutSearchTimeout: any = null;
      checkoutSearchInput?.addEventListener('input', () => {
        clearTimeout(checkoutSearchTimeout);
        const query = checkoutSearchInput.value.trim();
        checkoutSearchTimeout = setTimeout(() => performCheckoutSearch(query), 350);
      });

      // Quick Search Chips Click Handlers
      document.querySelectorAll('.checkout-quick-chip').forEach(chip => {
        chip.addEventListener('click', (e: any) => {
          const q = e.currentTarget.dataset.query;
          if (checkoutSearchInput) checkoutSearchInput.value = q;
          performCheckoutSearch(q);
        });
      });

      // Direct GPS Detection on Checkout
      btnCheckoutGps?.addEventListener('click', () => {
        const spinner = document.getElementById('checkout-gps-spinner');
        const icon = document.getElementById('checkout-gps-icon');
        spinner?.classList.remove('hidden');
        icon?.classList.add('hidden');

        const fallback = async () => {
          try {
            const res = await fetch('https://ipwhois.app/json/');
            const data = await res.json();
            const addrEl = document.getElementById('cust-address') as HTMLTextAreaElement;
            if (addrEl && data.city) {
              addrEl.value = `${data.city}, ${data.region || ''}, Indonesia`;
              if (window.showToast) window.showToast(`Lokasi terdeteksi di sekitar ${data.city}!`, 'success');
            }
          } catch(e) {}
          finally {
            spinner?.classList.add('hidden');
            icon?.classList.remove('hidden');
          }
        };

        if (!navigator.geolocation) {
          fallback();
          return;
        }

        navigator.geolocation.getCurrentPosition(
          async (pos) => {
            const { latitude, longitude } = pos.coords;
            try {
              const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}&addressdetails=1`);
              const data = await res.json();
              if (data && data.display_name) {
                const addrEl = document.getElementById('cust-address') as HTMLTextAreaElement;
                if (addrEl) addrEl.value = data.display_name;
                if (badgeContainer && badgeLabel && badgeDetail) {
                  badgeLabel.textContent = `GPS Presisi (${data.display_name.split(',')[0]})`;
                  badgeDetail.textContent = data.display_name;
                  badgeContainer.classList.remove('hidden');
                }
                if (window.showToast) window.showToast('Lokasi GPS Anda berhasil diterapkan!', 'success');
              }
            } catch(e) {}
            finally {
              spinner?.classList.add('hidden');
              icon?.classList.remove('hidden');
            }
          },
          () => {
            fallback();
          },
          { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 }
        );
      });

      // Auto-load default address from Supabase
      try {
        const { data: defaultAddr } = await supabase
          .from('user_addresses')
          .select('*')
          .eq('user_id', session.user.id)
          .eq('is_default', true)
          .maybeSingle();

        if (defaultAddr) {
          applyAddressToForm(defaultAddr);
        } else {
          // If no default, check latest
          const { data: latestAddr } = await supabase
            .from('user_addresses')
            .select('*')
            .eq('user_id', session.user.id)
            .order('created_at', { ascending: false })
            .limit(1)
            .maybeSingle();
          if (latestAddr) applyAddressToForm(latestAddr);
        }
      } catch(e) {}

      // Listen for custom event from AddressModal
      window.addEventListener('addressSelected', (e: any) => {
        applyAddressToForm(e.detail);
        if (window.showToast) window.showToast('Alamat berhasil diterapkan!', 'success');
      });

      // Pay Now Logic
      const btnPayNow = document.getElementById('btn-pay-now');
      btnPayNow?.addEventListener('click', async () => {
        const selectedPayment = document.querySelector('input[name="payment"]:checked') as HTMLInputElement;
        
        const name = (document.getElementById('cust-name') as HTMLInputElement).value;
        const phone = (document.getElementById('cust-phone') as HTMLInputElement).value;
        const address = (document.getElementById('cust-address') as HTMLTextAreaElement).value;

        if (!name || !phone || !address) {
          if (window.showToast) window.showToast('Mohon lengkapi informasi pengiriman', 'error');
          return;
        }

        if (!selectedPayment) {
          if (window.showToast) window.showToast('Silakan pilih metode pembayaran', 'error');
          return;
        }

        // Simulate Loading
        const originalText = btnPayNow.innerHTML;
        btnPayNow.innerHTML = `<div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div> Memproses...`;
        btnPayNow.setAttribute('disabled', 'true');

        try {
          // CREATE ORDER (Status: Pesanan Baru)
          const { data: order, error: orderError } = await supabase.from('orders').insert({
            user_id: session.user.id,
            customer_name: name,
            customer_phone: phone,
            customer_address: address,
            total_amount: finalTotal,
            status: 'Pesanan Baru'
          }).select().single();

          if (orderError) throw orderError;

          // Insert items
          const orderItems = cart.map((item: any) => ({
            order_id: order.id,
            product_id: item.id,
            product_name: item.name,
            product_image: item.image,
            size: item.size,
            outsole_model: item.outsole || 'Model 1',
            quantity: item.quantity,
            price: item.price
          }));

          const { error: itemsError } = await supabase.from('order_items').insert(orderItems);
          if (itemsError) throw itemsError;

          // Trigger Cloudflare Pages auto-build in background so E-Commerce static catalog updates
          fetch('https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/984ad6b4-c842-44cb-a50e-855dbfb7d6d4', { method: 'POST' }).catch(console.error);

          // SUCCESS
          localStorage.removeItem('ballqish_cart');
          window.location.href = '/?success=true';

        } catch (err: any) {
          console.error('Payment/Checkout Error:', err);
          if (window.showToast) window.showToast(`Gagal: ${err.message || 'Terjadi kesalahan'}`, 'error');
          btnPayNow.innerHTML = originalText;
          btnPayNow.removeAttribute('disabled');
        }
      });
    });
  </script>

  <AddressModal />
</Layout>
