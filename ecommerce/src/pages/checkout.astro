---
import Layout from '../layouts/Layout.astro';
import AddressModal from '../components/AddressModal.astro';
---

<Layout title="Checkout - Ballqish Shoes">
  <div data-theme="editorial" class="bg-ivory min-h-screen py-10 sm:py-14">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">

      {/* Checkout Header */}
      <div class="flex items-end justify-between border-b border-line pb-6 mb-10 sm:mb-14">
        <div>
          <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-3">Langkah Terakhir</span>
          <h1 class="display-font text-4xl md:text-5xl font-normal text-ink leading-none">Checkout Pesanan</h1>
        </div>
        <a href="/" class="text-[11px] uppercase tracking-[0.25em] text-ink/50 hover:text-oxblood transition-colors pb-1">
          &larr; Kembali Belanja
        </a>
      </div>

      <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">

        {/* LEFT: Payment & Shipping Details */}
        <div class="flex-1 space-y-12">

          {/* Informasi Pengiriman */}
          <section>
            <header class="border-b border-line pb-4 mb-6">
              <h2 class="text-[11px] uppercase tracking-[0.3em] text-ink font-semibold">Informasi Pengiriman</h2>
              <p class="text-[13px] text-ink/50 mt-2">Lengkapi kontak penerima dan pilih alamat tujuan</p>
            </header>

            {/* Kontak Penerima */}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="cust-name" class="block text-[10px] uppercase tracking-[0.25em] text-ink/50 mb-2.5">Nama Penerima</label>
                <input
                  type="text"
                  id="cust-name"
                  class="w-full border border-line bg-white px-4 py-3.5 text-[14px] text-ink placeholder:text-ink/25 focus:outline-none focus:border-ink transition-colors"
                  placeholder="Contoh: Budi Santoso"
                />
              </div>
              <div>
                <label for="cust-phone" class="block text-[10px] uppercase tracking-[0.25em] text-ink/50 mb-2.5">Nomor Telepon (WA)</label>
                <input
                  type="tel"
                  id="cust-phone"
                  class="w-full border border-line bg-white px-4 py-3.5 text-[14px] text-ink placeholder:text-ink/25 focus:outline-none focus:border-ink transition-colors"
                  placeholder="081234567890"
                />
              </div>
            </div>

            {/* Alamat Pengiriman Picker */}
            <div class="pt-8 mt-8 border-t border-line">
              <label class="block text-[10px] uppercase tracking-[0.25em] text-ink/50 mb-2.5">Alamat Pengiriman</label>

              <div class="relative" id="address-picker-wrapper">

                {/* State 1: Alamat aktif */}
                <div id="selected-address-card" class="bg-white border border-line p-5 space-y-3 transition-colors">
                  <div class="flex items-center justify-between gap-3 border-b border-line pb-3">
                    <div class="flex items-center gap-2.5 flex-wrap">
                      <span id="card-addr-label" class="text-[10px] uppercase tracking-[0.3em] text-ink">
                        RUMAH
                      </span>
                      <span id="card-addr-badge" class="text-[9px] uppercase tracking-[0.15em] text-oxblood bg-oxblood/8 border border-oxblood/25 px-2 py-1 hidden">
                        Utama
                      </span>
                    </div>
                    <button
                      id="address-dropdown-trigger"
                      type="button"
                      class="text-[10px] uppercase tracking-[0.2em] text-ink/50 hover:text-oxblood transition-colors cursor-pointer flex items-center gap-1.5 shrink-0"
                    >
                      <span>Pilih Alamat Lain</span>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                  </div>

                  <div>
                    <p id="card-full-address" class="text-[13px] text-ink/65 leading-relaxed">
                      Memuat alamat...
                    </p>
                  </div>
                </div>

                {/* State 2: Belum ada alamat */}
                <div id="no-address-card" class="hidden border border-dashed border-line px-6 py-12 text-center space-y-4">
                  <p class="text-[13px] text-ink/65">Belum ada alamat pengiriman tersimpan</p>
                  <button
                    id="btn-add-first-address"
                    type="button"
                    class="inline-flex items-center gap-2 bg-ink text-ivory text-[11px] uppercase tracking-[0.25em] px-6 py-3.5 hover:bg-oxblood transition-colors cursor-pointer"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                    Buka Peta &amp; Tambah Alamat
                  </button>
                </div>

                {/* Dropdown */}
                <div
                  id="address-dropdown-menu"
                  class="absolute left-0 right-0 top-full mt-2 bg-white border border-line z-50 max-h-72 overflow-y-auto hidden divide-y divide-line"
                >
                  {/* Diisi via JavaScript */}
                </div>
              </div>
            </div>

            <input type="hidden" id="cust-address" value="" />
          </section>

          {/* Metode Pembayaran */}
          <section>
            <header class="border-b border-line pb-4 mb-6">
              <h2 class="text-[11px] uppercase tracking-[0.3em] text-ink font-semibold">Metode Pembayaran</h2>
            </header>

            <div class="space-y-3">
              <label class="payment-method border border-gray-200 bg-white p-5 flex items-center cursor-pointer hover:border-ink transition-colors">
                <input type="radio" name="payment" value="ewallet" class="mr-4 w-4 h-4 accent-[#5a1a1c]">
                <div class="flex-1">
                  <span class="block text-[14px] text-ink">E-Wallet</span>
                  <span class="block text-[12px] text-ink/45 mt-1">GoPay, OVO, DANA, ShopeePay</span>
                </div>
              </label>

              <label class="payment-method border border-gray-200 bg-white p-5 flex items-center cursor-pointer hover:border-ink transition-colors">
                <input type="radio" name="payment" value="bank" class="mr-4 w-4 h-4 accent-[#5a1a1c]">
                <div class="flex-1">
                  <span class="block text-[14px] text-ink">Transfer Bank (Virtual Account)</span>
                  <span class="block text-[12px] text-ink/45 mt-1">BCA, Mandiri, BNI, BRI</span>
                </div>
              </label>

              <label class="payment-method border border-gray-200 bg-white p-5 flex items-center cursor-pointer hover:border-ink transition-colors">
                <input type="radio" name="payment" value="qris" class="mr-4 w-4 h-4 accent-[#5a1a1c]">
                <div class="flex-1">
                  <span class="block text-[14px] text-ink">QRIS</span>
                  <span class="block text-[12px] text-ink/45 mt-1">Scan dengan aplikasi M-Banking atau E-Wallet</span>
                </div>
              </label>
            </div>

            <div id="qris-display" class="hidden mt-6 p-8 border border-line text-center bg-white">
              <p class="text-[10px] uppercase tracking-[0.3em] text-ink/50 mb-5">Scan kode QR (DUMMY)</p>
              <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=DUMMY_PAYMENT_QRIS_BALLQISH" alt="QRIS Dummy" class="mx-auto">
              <p class="text-[12px] text-ink/40 mt-5">Peringatan: Ini hanya demonstrasi e-commerce.</p>
            </div>
          </section>

        </div>

        {/* RIGHT: Ringkasan Pesanan */}
        <aside class="w-full lg:w-[360px] flex-shrink-0">
          <div class="lg:sticky lg:top-28">
            <div class="flex items-baseline justify-between border-b border-ink pb-4 mb-7">
              <h3 class="display-font text-2xl font-normal text-ink">Ringkasan Pesanan</h3>
            </div>

            <div id="checkout-items" class="space-y-5 mb-8 max-h-80 overflow-y-auto pr-2 hide-scrollbar">
              <!-- Diisi via JS -->
            </div>

            {/* Voucher */}
            <div class="mb-8 pt-7 border-t border-line">
              <label for="voucher-code" class="block text-[10px] uppercase tracking-[0.25em] text-ink/50 mb-3">Kode Voucher</label>
              <div class="flex w-full border border-line focus-within:border-ink overflow-hidden transition-colors bg-white">
                <input
                  type="text"
                  id="voucher-code"
                  class="flex-1 min-w-0 border-none px-4 py-3.5 text-[13px] tracking-[0.15em] text-ink placeholder:text-ink/25 focus:outline-none focus:ring-0 bg-transparent uppercase"
                  placeholder="BQL2026"
                />
                <button
                  id="apply-voucher"
                  class="bg-ink text-ivory px-5 text-[10px] uppercase tracking-[0.25em] hover:bg-oxblood transition-colors cursor-pointer"
                >
                  Pakai
                </button>
              </div>
            </div>

            {/* Total */}
            <div class="space-y-3 mb-8 pt-6 border-t border-line">
              <div class="flex justify-between text-[13px]">
                <span class="text-ink/50">Subtotal</span>
                <span id="summary-subtotal" class="font-semibold text-ink">Rp 0</span>
              </div>
              <div class="flex justify-between text-[13px]">
                <span class="text-ink/50">Ongkos Kirim (Flat)</span>
                <span id="summary-shipping" class="font-semibold text-ink">Rp 7.000</span>
              </div>
              <div id="discount-row" class="flex justify-between text-[13px] hidden text-oxblood">
                <span class="text-ink/50">Diskon</span>
                <span id="summary-discount" class="font-semibold">- Rp 0</span>
              </div>
              <div class="flex justify-between items-baseline pt-4 mt-4 border-t border-ink">
                <span class="text-[10px] uppercase tracking-[0.3em] text-ink/50">Total Tagihan</span>
                <span id="summary-total" class="display-font text-3xl font-normal text-ink">Rp 0</span>
              </div>
            </div>

            <button id="btn-pay-now" class="w-full bg-ink text-ivory text-[11px] uppercase tracking-[0.3em] px-4 py-4.5 hover:bg-oxblood transition-colors flex justify-center items-center cursor-pointer">
              Bayar Sekarang
            </button>
            <p class="text-[10px] uppercase tracking-[0.2em] text-ink/35 text-center mt-5 flex items-center justify-center gap-2">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              Pembayaran aman &amp; terenkripsi
            </p>
          </div>
        </aside>

      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    document.addEventListener('DOMContentLoaded', async () => {
      let cart = [];
      try {
        const c = localStorage.getItem('ballqish_cart');
        if (c) {
          cart = JSON.parse(c);
          cart = cart.filter((item: any) => item.id && item.id.length === 36);
          localStorage.setItem('ballqish_cart', JSON.stringify(cart));
        }
      } catch(e) {}

      if (cart.length === 0) {
        window.location.href = '/?openCart=true';
        return;
      }

      // Check Session & Pre-fill
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/login';
        return;
      }

      const custNameInput = document.getElementById('cust-name') as HTMLInputElement;
      const custPhoneInput = document.getElementById('cust-phone') as HTMLInputElement;
      const custAddressInput = document.getElementById('cust-address') as HTMLInputElement;

      if (custNameInput && session.user.user_metadata?.full_name && !custNameInput.value) {
        custNameInput.value = session.user.user_metadata.full_name;
      }

      const shippingCost = 7000;
      let discountAmount = 0;
      let finalTotal = 0;

      function renderSummary() {
        const itemsContainer = document.getElementById('checkout-items');
        if (itemsContainer) {
          itemsContainer.innerHTML = cart.map((item: any) => `
            <div class="flex gap-4 pb-5 border-b border-line">
              <img src="${item.image}" class="w-20 h-24 object-cover" />
              <div class="flex-1 min-w-0">
                <p class="display-font text-[16px] font-normal text-ink line-clamp-2 leading-snug">${item.name}</p>
                <p class="text-[10px] uppercase tracking-[0.2em] text-ink/45 mt-2">${item.mode === 'b2b' ? 'B2B' : 'Satuan'} &bull; Ukuran ${item.size}</p>
                <p class="text-[11px] text-ink/45 mt-1.5">${item.stitching || 'Jahitan 1'} &bull; ${item.outsole || 'Outsole 1'}${item.insole ? ` &bull; ${item.insole}` : ''}</p>
                <div class="flex justify-between items-baseline mt-2.5">
                  <span class="text-[13px] font-semibold text-ink">${item.quantity} &times; Rp ${item.price.toLocaleString('id-ID')}</span>
                </div>
              </div>
            </div>
          `).join('');
        }

        const subtotal = cart.reduce((sum: number, item: any) => sum + (item.price * item.quantity), 0);
        finalTotal = subtotal + shippingCost - discountAmount;

        const elSubtotal = document.getElementById('summary-subtotal');
        const elTotal = document.getElementById('summary-total');
        const elDiscount = document.getElementById('summary-discount');
        const rowDiscount = document.getElementById('discount-row');

        if (elSubtotal) elSubtotal.textContent = `Rp ${subtotal.toLocaleString('id-ID')}`;
        if (elTotal) elTotal.textContent = `Rp ${finalTotal.toLocaleString('id-ID')}`;
        
        if (discountAmount > 0 && elDiscount && rowDiscount) {
          elDiscount.textContent = `- Rp ${discountAmount.toLocaleString('id-ID')}`;
          rowDiscount.classList.remove('hidden');
        }
      }

      renderSummary();

      // Voucher Logic
      const btnApplyVoucher = document.getElementById('apply-voucher');
      btnApplyVoucher?.addEventListener('click', () => {
        const code = (document.getElementById('voucher-code') as HTMLInputElement).value.toUpperCase();
        if (code === 'DISKON20') {
          discountAmount = 20000;
          if ((window as any).showToast) (window as any).showToast('Voucher berhasil digunakan!', 'success');
        } else if (code) {
          discountAmount = 0;
          if ((window as any).showToast) (window as any).showToast('Voucher tidak valid atau sudah kadaluarsa', 'error');
        }
        renderSummary();
      });

      // Payment Method UI
      const paymentRadios = document.querySelectorAll('input[name="payment"]');
      const qrisDisplay = document.getElementById('qris-display');
      
      paymentRadios.forEach(radio => {
        radio.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          document.querySelectorAll('.payment-method').forEach(el => {
            el.classList.remove('border-red-600', 'bg-red-50');
            el.classList.add('border-gray-200');
          });
          
          if (target.checked) {
            target.closest('.payment-method')?.classList.add('border-gray-900', 'bg-[#FAF9F6]');
            target.closest('.payment-method')?.classList.remove('border-gray-200');
            
            if (target.value === 'qris' && qrisDisplay) {
              qrisDisplay.classList.remove('hidden');
            } else if (qrisDisplay) {
              qrisDisplay.classList.add('hidden');
            }
          }
        });
      });

      // Address Card & Dropdown Logic
      const btnAddFirstAddress = document.getElementById('btn-add-first-address');
      const selectedAddressCard = document.getElementById('selected-address-card');
      const noAddressCard = document.getElementById('no-address-card');
      const dropdownTrigger = document.getElementById('address-dropdown-trigger');
      const dropdownMenu = document.getElementById('address-dropdown-menu');
      
      const cardAddrLabel = document.getElementById('card-addr-label');
      const cardAddrBadge = document.getElementById('card-addr-badge');
      const cardFullAddress = document.getElementById('card-full-address');

      let userSavedAddresses: any[] = [];
      let currentSelectedAddressId: string | null = null;

      const triggerAddressModal = () => {
        if ((window as any).openAddressModal) {
          (window as any).openAddressModal();
        }
      };

      btnAddFirstAddress?.addEventListener('click', triggerAddressModal);

      // Toggle dropdown open / close
      dropdownTrigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdownMenu?.classList.toggle('hidden');
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e: any) => {
        if (!e.target.closest('#address-picker-wrapper')) {
          dropdownMenu?.classList.add('hidden');
        }
      });

      function applyAddressToCard(addr: any) {
        if (!addr) return;
        currentSelectedAddressId = addr.id;

        const recipient = addr.recipient_name || session.user.user_metadata?.full_name || '';
        const phone = addr.recipient_phone || '';
        
        const fullTxt = [
          addr.full_address,
          addr.benchmark_notes ? `(Patokan: ${addr.benchmark_notes})` : '',
          addr.city ? `${addr.city}, ${addr.province || ''}` : ''
        ].filter(Boolean).join(' - ');

        // Update inputs
        if (custNameInput && recipient && (!custNameInput.value || custNameInput.value === session.user.user_metadata?.full_name)) {
          custNameInput.value = recipient;
        }
        if (custPhoneInput && phone && !custPhoneInput.value) {
          custPhoneInput.value = phone;
        }
        if (custAddressInput) custAddressInput.value = fullTxt || addr.full_address || '';

        // Update Card UI
        if (cardAddrLabel) cardAddrLabel.textContent = (addr.label_name || 'Rumah').toUpperCase();
        if (cardFullAddress) cardFullAddress.textContent = fullTxt || addr.full_address || '';
        
        if (cardAddrBadge) {
          if (addr.is_default) {
            cardAddrBadge.classList.remove('hidden');
          } else {
            cardAddrBadge.classList.add('hidden');
          }
        }

        selectedAddressCard?.classList.remove('hidden');
        noAddressCard?.classList.add('hidden');
      }

      // Render Dropdown List of Addresses
      function renderDropdownMenu() {
        if (!dropdownMenu) return;

        dropdownMenu.innerHTML = `
          ${userSavedAddresses.map(addr => {
            const isSelected = addr.id === currentSelectedAddressId;
            const fullTxt = [
              addr.full_address,
              addr.benchmark_notes ? `Patokan: ${addr.benchmark_notes}` : '',
              addr.city ? `${addr.city}` : ''
            ].filter(Boolean).join(' • ');

            return `
              <div 
                class="address-dropdown-item p-4 hover:bg-bone/50 cursor-pointer transition-colors flex items-start justify-between gap-3 ${isSelected ? 'bg-bone/40' : ''}" 
                data-id="${addr.id}"
              >
                <div class="space-y-1.5 min-w-0 flex-1">
                  <div class="flex items-center gap-2.5 flex-wrap">
                    <span class="text-[10px] uppercase tracking-[0.25em] text-ink">
                      ${addr.label_name || 'Rumah'} (${addr.recipient_name})
                    </span>
                    ${addr.is_default ? '<span class="text-[9px] uppercase tracking-[0.15em] text-oxblood bg-oxblood/8 border border-oxblood/25 px-2 py-0.5">Utama</span>' : ''}
                  </div>
                  <p class="text-[12px] text-ink/50 line-clamp-1 leading-relaxed">
                    ${fullTxt || addr.full_address}
                  </p>
                </div>
                ${isSelected ? '<span class="text-[10px] uppercase tracking-[0.2em] text-oxblood shrink-0 mt-0.5">Terpilih</span>' : ''}
              </div>
            `;
          }).join('')}
          
          <button 
            type="button" 
            id="btn-dropdown-add-new" 
            class="w-full p-4 text-left bg-bone/40 hover:bg-bone text-[10px] uppercase tracking-[0.25em] text-oxblood flex items-center gap-2.5 transition-colors cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
            <span>Buka Peta &amp; Tambah Alamat Baru</span>
          </button>
        `;

        // Click on an address item
        dropdownMenu.querySelectorAll('.address-dropdown-item').forEach(item => {
          item.addEventListener('click', (e: any) => {
            const id = e.currentTarget.dataset.id;
            const chosen = userSavedAddresses.find(a => a.id === id);
            if (chosen) {
              applyAddressToCard(chosen);
              renderDropdownMenu();
              dropdownMenu.classList.add('hidden');
              if ((window as any).showToast) {
                (window as any).showToast(`Alamat "${chosen.label_name}" dipilih!`, 'info');
              }
            }
          });
        });

        // Click on Add New button in dropdown
        document.getElementById('btn-dropdown-add-new')?.addEventListener('click', () => {
          dropdownMenu.classList.add('hidden');
          triggerAddressModal();
        });
      }

      // Load Saved Addresses from Supabase
      async function loadSavedAddressesForCheckout(selectedIdToPick: string | null = null) {
        try {
          const { data: addresses, error } = await supabase
            .from('user_addresses')
            .select('*')
            .eq('user_id', session.user.id)
            .order('is_default', { ascending: false })
            .order('created_at', { ascending: false });

          if (error || !addresses || addresses.length === 0) {
            userSavedAddresses = [];
            selectedAddressCard?.classList.add('hidden');
            noAddressCard?.classList.remove('hidden');
            return;
          }

          userSavedAddresses = addresses;
          selectedAddressCard?.classList.remove('hidden');
          noAddressCard?.classList.add('hidden');

          // Pick requested ID or Default Address (which is guaranteed 1st element)
          const targetAddr = selectedIdToPick 
            ? addresses.find(a => a.id === selectedIdToPick) 
            : addresses[0];

          if (targetAddr) {
            applyAddressToCard(targetAddr);
          }
          renderDropdownMenu();
        } catch(e) {
          console.warn('Error loading addresses in checkout', e);
        }
      }

      // Initial Load
      await loadSavedAddressesForCheckout();

      // Listen for custom events from AddressModal
      window.addEventListener('addressSelected', (e: any) => {
        if (e.detail && e.detail.id) {
          loadSavedAddressesForCheckout(e.detail.id);
        } else {
          applyAddressToCard(e.detail);
        }
        if ((window as any).showToast) (window as any).showToast('Alamat berhasil diterapkan!', 'success');
      });

      window.addEventListener('addressBookUpdated', () => {
        loadSavedAddressesForCheckout();
      });

      // Pay Now Logic
      const btnPayNow = document.getElementById('btn-pay-now');
      btnPayNow?.addEventListener('click', async () => {
        const selectedPayment = document.querySelector('input[name="payment"]:checked') as HTMLInputElement;
        
        const name = custNameInput?.value?.trim();
        const phone = custPhoneInput?.value?.trim();
        const address = custAddressInput?.value?.trim();

        if (!name || !phone) {
          if ((window as any).showToast) (window as any).showToast('Mohon isi nama dan nomor telepon penerima', 'error');
          return;
        }

        if (!address) {
          if ((window as any).showToast) (window as any).showToast('Mohon pilih atau tambahkan alamat pengiriman terlebih dahulu', 'error');
          triggerAddressModal();
          return;
        }

        if (!selectedPayment) {
          if ((window as any).showToast) (window as any).showToast('Silakan pilih metode pembayaran', 'error');
          return;
        }

        // Simulate Loading
        const originalText = btnPayNow.innerHTML;
        btnPayNow.innerHTML = `<div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div> Memproses...`;
        btnPayNow.setAttribute('disabled', 'true');

        try {
          // CREATE ORDER (Status: Pesanan Baru)
          const { data: order, error: orderError } = await supabase.from('orders').insert({
            user_id: session.user.id,
            customer_name: name,
            customer_phone: phone,
            customer_address: address,
            total_amount: finalTotal,
            status: 'Pesanan Baru'
          }).select().single();

          if (orderError) throw orderError;

          // Insert items
          const orderItems = cart.map((item: any) => ({
            order_id: order.id,
            product_id: item.id,
            product_name: item.name,
            product_image: item.image,
            size: item.size,
            outsole_model: item.outsole || 'Model 1',
            quantity: item.quantity,
            price: item.price
          }));

          const { error: itemsError } = await supabase.from('order_items').insert(orderItems);
          if (itemsError) throw itemsError;

          // Trigger Cloudflare Pages auto-build in background so E-Commerce static catalog updates
          fetch('https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/984ad6b4-c842-44cb-a50e-855dbfb7d6d4', { method: 'POST' }).catch(console.error);

          // SUCCESS
          localStorage.removeItem('ballqish_cart');
          window.location.href = '/?success=true';

        } catch (err: any) {
          console.error('Payment/Checkout Error:', err);
          if ((window as any).showToast) (window as any).showToast(`Gagal: ${err.message || 'Terjadi kesalahan'}`, 'error');
          btnPayNow.innerHTML = originalText;
          btnPayNow.removeAttribute('disabled');
        }
      });
    });
  </script>

  <AddressModal />
</Layout>
