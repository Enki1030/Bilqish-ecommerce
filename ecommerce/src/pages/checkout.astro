---
import Layout from '../layouts/Layout.astro';
import AddressModal from '../components/AddressModal.astro';
---

<Layout title="Checkout - Ballqish Shoes">
  <div class="bg-[#FAF9F6] min-h-screen py-6 sm:py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Checkout Header -->
      <div class="flex items-center justify-between border-b border-gray-200 pb-4 mb-6 sm:mb-8">
        <h1 class="text-xl sm:text-2xl font-heading font-bold text-gray-900 tracking-wider uppercase">
          Checkout Pesanan
        </h1>
        <a href="/" class="text-xs font-semibold text-gray-500 hover:text-primary transition-colors">
          ← Kembali Belanja
        </a>
      </div>

      <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
        
        <!-- LEFT: Payment & Shipping Details -->
        <div class="flex-1 space-y-6">
          
          <!-- Informasi Pengiriman -->
          <div class="bg-white p-4 sm:p-8 border border-gray-200 rounded-xl sm:rounded-none space-y-5 font-sans">
            <div class="flex justify-between items-center border-b border-gray-100 pb-4">
              <div>
                <h2 class="text-xs font-sans font-medium text-gray-900 uppercase tracking-wider">
                  Informasi Pengiriman
                </h2>
                <p class="text-[11px] font-sans font-normal text-gray-400 mt-0.5">Pilih alamat tersimpan atau kelola titik GPS di Buku Alamat</p>
              </div>
              <button 
                id="btn-open-address-book" 
                type="button" 
                class="inline-flex items-center gap-1.5 text-xs font-sans font-medium text-[#5c1616] hover:text-[#400f0f] uppercase tracking-wider bg-rose-50 border border-rose-200 px-3 py-1.5 rounded-lg transition-colors cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                Buku Alamat & Peta
              </button>
            </div>

            <!-- Custom Interactive Saved Addresses Dropdown Card -->
            <div id="saved-address-dropdown-container" class="hidden space-y-2 font-sans">
              <label class="block text-[11px] font-sans font-medium text-gray-700 uppercase tracking-wide">
                Alamat Pengiriman
              </label>
              
              <div class="relative" id="address-picker-wrapper">
                <!-- Trigger Box (Current Selected Address) -->
                <button 
                  id="address-dropdown-trigger" 
                  type="button" 
                  class="w-full text-left bg-white hover:bg-rose-50/20 border border-gray-300 hover:border-[#5c1616] p-3.5 rounded-xl transition-all flex items-center justify-between gap-3 shadow-xs cursor-pointer"
                >
                  <div class="min-w-0 flex-1 space-y-1">
                    <div class="flex items-center gap-2">
                      <span id="selected-addr-label" class="text-xs font-sans font-medium uppercase tracking-wider text-gray-900">
                        Memuat Alamat...
                      </span>
                      <span id="selected-addr-badge" class="text-[9px] font-sans font-medium text-[#5c1616] bg-rose-50 border border-rose-200 px-1.5 py-0.2 rounded-full uppercase hidden">
                        Utama
                      </span>
                    </div>
                    <p id="selected-addr-detail" class="text-xs font-sans font-normal text-gray-500 line-clamp-1">
                      ...
                    </p>
                  </div>
                  <div class="text-gray-400 shrink-0 flex items-center gap-1 text-xs font-sans font-normal">
                    <span>Ganti</span>
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                  </div>
                </button>

                <!-- Expandable Dropdown List -->
                <div 
                  id="address-dropdown-menu" 
                  class="absolute left-0 right-0 top-full mt-2 bg-white border border-gray-200 rounded-xl shadow-xl z-50 max-h-72 overflow-y-auto hidden divide-y divide-gray-100 font-sans"
                >
                  <!-- Diisi via JavaScript dengan semua alamat tersimpan yang terstruktur rapi -->
                </div>
              </div>
            </div>

            <!-- Form Fields for Direct Edit / View -->
            <div class="space-y-4 pt-1">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-sans font-medium text-gray-700 mb-1.5 uppercase tracking-wide">Nama Penerima</label>
                  <input type="text" id="cust-name" class="w-full border border-gray-300 px-3.5 py-2.5 text-xs sm:text-sm font-sans font-normal text-gray-800 focus:outline-none focus:border-[#5c1616] bg-white rounded-lg transition-colors" placeholder="Contoh: Budi Santoso">
                </div>
                <div>
                  <label class="block text-xs font-sans font-medium text-gray-700 mb-1.5 uppercase tracking-wide">Nomor Telepon (WA)</label>
                  <input type="tel" id="cust-phone" class="w-full border border-gray-300 px-3.5 py-2.5 text-xs sm:text-sm font-sans font-normal text-gray-800 focus:outline-none focus:border-[#5c1616] bg-white rounded-lg transition-colors" placeholder="081234567890">
                </div>
              </div>
              <div>
                <label class="block text-xs font-sans font-medium text-gray-700 mb-1.5 uppercase tracking-wide">Alamat Lengkap</label>
                <textarea id="cust-address" rows="3" class="w-full border border-gray-300 px-3.5 py-2.5 text-xs sm:text-sm font-sans font-normal text-gray-800 focus:outline-none focus:border-[#5c1616] bg-white rounded-lg transition-colors" placeholder="Jl. Sudirman No. 123, RT 01/RW 02..."></textarea>
              </div>
            </div>
          </div>

          <!-- Metode Pembayaran -->
          <div class="bg-white p-4 sm:p-8 border border-gray-200 rounded-xl sm:rounded-none">
            <h2 class="text-xs font-sans font-medium text-gray-900 mb-6 uppercase tracking-widest">
              Metode Pembayaran
            </h2>
            
            <div class="space-y-3">
              <!-- E-Wallet -->
              <label class="payment-method border border-gray-200 p-4 flex items-center cursor-pointer hover:border-gray-900 transition-colors bg-white rounded-lg sm:rounded-none">
                <input type="radio" name="payment" value="ewallet" class="text-primary focus:ring-primary mr-4 w-4 h-4">
                <div class="flex-1">
                  <span class="font-sans font-medium text-gray-900 block text-sm tracking-wide">E-Wallet</span>
                  <span class="text-xs text-gray-400 font-sans font-normal">GoPay, OVO, DANA, ShopeePay</span>
                </div>
              </label>

              <!-- Bank Transfer -->
              <label class="payment-method border border-gray-200 p-4 flex items-center cursor-pointer hover:border-gray-900 transition-colors bg-white rounded-lg sm:rounded-none">
                <input type="radio" name="payment" value="bank" class="text-primary focus:ring-primary mr-4 w-4 h-4">
                <div class="flex-1">
                  <span class="font-sans font-medium text-gray-900 block text-sm tracking-wide">Transfer Bank (Virtual Account)</span>
                  <span class="text-xs text-gray-400 font-sans font-normal">BCA, Mandiri, BNI, BRI</span>
                </div>
              </label>

              <!-- QRIS -->
              <label class="payment-method border border-gray-200 p-4 flex items-center cursor-pointer hover:border-gray-900 transition-colors bg-white rounded-lg sm:rounded-none">
                <input type="radio" name="payment" value="qris" class="text-primary focus:ring-primary mr-4 w-4 h-4">
                <div class="flex-1">
                  <span class="font-sans font-medium text-gray-900 block text-sm tracking-wide">QRIS</span>
                  <span class="text-xs text-gray-400 font-sans font-normal">Scan dengan aplikasi M-Banking atau E-Wallet</span>
                </div>
              </label>
            </div>

            <!-- QRIS Dummy Display -->
            <div id="qris-display" class="hidden mt-6 p-6 border border-gray-300 text-center bg-[#FAF9F6] rounded-xl sm:rounded-none">
              <p class="text-xs font-sans font-medium text-gray-900 uppercase tracking-widest mb-4">Scan kode QR (DUMMY)</p>
              <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=DUMMY_PAYMENT_QRIS_BALLQISH" alt="QRIS Dummy" class="mx-auto border border-gray-200 mix-blend-multiply">
              <p class="text-xs text-gray-400 font-sans font-normal mt-4">Peringatan: Ini hanya demonstrasi e-commerce.</p>
            </div>
          </div>

        </div>

        <!-- RIGHT: Order Summary -->
        <div class="w-full lg:w-96 flex-shrink-0 font-sans">
          <div class="bg-white p-4 sm:p-8 border border-gray-200 rounded-xl sm:rounded-none sticky top-28">
            <h3 class="text-xs font-sans font-medium text-gray-900 uppercase tracking-widest mb-6">Ringkasan Pesanan</h3>
            
            <!-- Items Container -->
            <div id="checkout-items" class="space-y-4 mb-8 max-h-80 overflow-y-auto pr-2 hide-scrollbar">
              <!-- Diisi via JS -->
            </div>

            <!-- Voucher (Flush aligned & Responsive) -->
            <div class="mb-8 pt-8 border-t border-gray-200">
              <label class="block text-xs font-sans font-medium text-gray-700 mb-3 uppercase tracking-wide">Kode Voucher</label>
              <div class="flex w-full border border-gray-300 rounded-lg focus-within:border-gray-900 overflow-hidden transition-colors">
                <input 
                  type="text" 
                  id="voucher-code" 
                  class="flex-1 min-w-0 border-none px-3.5 py-3 text-sm font-sans font-normal focus:outline-none focus:ring-0 bg-transparent uppercase" 
                  placeholder="BQL2026" 
                />
                <button 
                  id="apply-voucher"
                  class="bg-gray-900 text-white px-5 py-3 text-xs font-heading font-semibold uppercase tracking-wider hover:bg-primary transition-colors cursor-pointer"
                >
                  Gunakan
                </button>
              </div>
            </div>

            <!-- Total Price Calculation -->
            <div class="space-y-3 mb-8 pt-4 border-t border-gray-200">
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Subtotal</span>
                <span id="summary-subtotal" class="font-bold text-gray-900">Rp 0</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Ongkos Kirim (Flat)</span>
                <span id="summary-shipping" class="font-bold text-gray-900">Rp 7.000</span>
              </div>
              <div id="discount-row" class="flex justify-between text-sm hidden text-gray-900">
                <span class="text-gray-500">Diskon</span>
                <span id="summary-discount" class="font-bold">- Rp 0</span>
              </div>
              <div class="flex justify-between items-center pt-4 mt-4 border-t border-gray-200">
                <span class="text-xs font-heading font-bold text-gray-900 uppercase tracking-widest">Total Tagihan</span>
                <span id="summary-total" class="text-xl font-heading font-bold text-gray-900">Rp 0</span>
              </div>
            </div>

            <button id="btn-pay-now" class="w-full bg-primary border border-primary text-white font-heading font-semibold text-xs uppercase tracking-widest px-4 py-4 hover:bg-gray-900 hover:border-gray-900 transition-colors flex justify-center items-center rounded-lg sm:rounded-none cursor-pointer">
              Bayar Sekarang
            </button>
            <p class="text-[10px] text-gray-400 text-center mt-4 flex items-center justify-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              Pembayaran Anda aman dan terenkripsi.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    document.addEventListener('DOMContentLoaded', async () => {
      let cart = [];
      try {
        const c = localStorage.getItem('ballqish_cart');
        if (c) {
          cart = JSON.parse(c);
          cart = cart.filter((item: any) => item.id && item.id.length === 36);
          localStorage.setItem('ballqish_cart', JSON.stringify(cart));
        }
      } catch(e) {}

      if (cart.length === 0) {
        window.location.href = '/?openCart=true';
        return;
      }

      // Check Session & Pre-fill
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/login';
        return;
      }

      const custName = document.getElementById('cust-name') as HTMLInputElement;
      if (custName && session.user.user_metadata?.full_name) {
        custName.value = session.user.user_metadata.full_name;
      }

      const shippingCost = 7000;
      let discountAmount = 0;
      let finalTotal = 0;

      function renderSummary() {
        const itemsContainer = document.getElementById('checkout-items');
        if (itemsContainer) {
          itemsContainer.innerHTML = cart.map((item: any) => `
            <div class="flex gap-4">
              <img src="${item.image}" class="w-16 h-16 object-cover mix-blend-multiply bg-gray-50 border border-gray-200" />
              <div class="flex-1">
                <p class="text-xs font-heading font-semibold text-gray-900 tracking-wide uppercase line-clamp-1">${item.name}</p>
                <p class="text-[11px] font-body text-gray-500 mt-1">Size ${item.size} • ${item.outsole || 'Model 1'}</p>
                <div class="flex justify-between items-center mt-2">
                  <span class="text-[13px] font-body font-bold text-gray-900">${item.quantity} x Rp ${item.price.toLocaleString('id-ID')}</span>
                </div>
              </div>
            </div>
          `).join('');
        }

        const subtotal = cart.reduce((sum: number, item: any) => sum + (item.price * item.quantity), 0);
        finalTotal = subtotal + shippingCost - discountAmount;

        const elSubtotal = document.getElementById('summary-subtotal');
        const elTotal = document.getElementById('summary-total');
        const elDiscount = document.getElementById('summary-discount');
        const rowDiscount = document.getElementById('discount-row');

        if (elSubtotal) elSubtotal.textContent = `Rp ${subtotal.toLocaleString('id-ID')}`;
        if (elTotal) elTotal.textContent = `Rp ${finalTotal.toLocaleString('id-ID')}`;
        
        if (discountAmount > 0 && elDiscount && rowDiscount) {
          elDiscount.textContent = `- Rp ${discountAmount.toLocaleString('id-ID')}`;
          rowDiscount.classList.remove('hidden');
        }
      }

      renderSummary();

      // Voucher Logic
      const btnApplyVoucher = document.getElementById('apply-voucher');
      btnApplyVoucher?.addEventListener('click', () => {
        const code = (document.getElementById('voucher-code') as HTMLInputElement).value.toUpperCase();
        if (code === 'DISKON20') {
          discountAmount = 20000;
          if ((window as any).showToast) (window as any).showToast('Voucher berhasil digunakan!', 'success');
        } else if (code) {
          discountAmount = 0;
          if ((window as any).showToast) (window as any).showToast('Voucher tidak valid atau sudah kadaluarsa', 'error');
        }
        renderSummary();
      });

      // Payment Method UI
      const paymentRadios = document.querySelectorAll('input[name="payment"]');
      const qrisDisplay = document.getElementById('qris-display');
      
      paymentRadios.forEach(radio => {
        radio.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          document.querySelectorAll('.payment-method').forEach(el => {
            el.classList.remove('border-red-600', 'bg-red-50');
            el.classList.add('border-gray-200');
          });
          
          if (target.checked) {
            target.closest('.payment-method')?.classList.add('border-gray-900', 'bg-[#FAF9F6]');
            target.closest('.payment-method')?.classList.remove('border-gray-200');
            
            if (target.value === 'qris' && qrisDisplay) {
              qrisDisplay.classList.remove('hidden');
            } else if (qrisDisplay) {
              qrisDisplay.classList.add('hidden');
            }
          }
        });
      });

      // Address Book & Interactive Dropdown Integration
      const btnOpenAddress = document.getElementById('btn-open-address-book');
      const savedDropdownContainer = document.getElementById('saved-address-dropdown-container');
      const dropdownTrigger = document.getElementById('address-dropdown-trigger');
      const dropdownMenu = document.getElementById('address-dropdown-menu');
      const selectedAddrLabel = document.getElementById('selected-addr-label');
      const selectedAddrBadge = document.getElementById('selected-addr-badge');
      const selectedAddrDetail = document.getElementById('selected-addr-detail');

      let userSavedAddresses: any[] = [];
      let currentSelectedAddressId: string | null = null;

      btnOpenAddress?.addEventListener('click', () => {
        if ((window as any).openAddressModal) {
          (window as any).openAddressModal();
        }
      });

      // Toggle dropdown open / close
      dropdownTrigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdownMenu?.classList.toggle('hidden');
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e: any) => {
        if (!e.target.closest('#address-picker-wrapper')) {
          dropdownMenu?.classList.add('hidden');
        }
      });

      function applyAddressToForm(addr: any) {
        if (!addr) return;
        currentSelectedAddressId = addr.id;

        const nameEl = document.getElementById('cust-name') as HTMLInputElement;
        const phoneEl = document.getElementById('cust-phone') as HTMLInputElement;
        const addrEl = document.getElementById('cust-address') as HTMLTextAreaElement;

        if (nameEl && addr.recipient_name) nameEl.value = addr.recipient_name;
        if (phoneEl && addr.recipient_phone) phoneEl.value = addr.recipient_phone;
        
        const fullTxt = [
          addr.full_address,
          addr.benchmark_notes ? `(Patokan: ${addr.benchmark_notes})` : '',
          addr.city ? `${addr.city}, ${addr.province || ''}` : ''
        ].filter(Boolean).join(' - ');

        if (addrEl && fullTxt) addrEl.value = fullTxt;

        // Update trigger display box
        if (selectedAddrLabel) {
          selectedAddrLabel.textContent = `${addr.label_name || 'Rumah'} (${addr.recipient_name || 'Pelanggan'})`;
        }

        if (selectedAddrBadge) {
          if (addr.is_default) {
            selectedAddrBadge.classList.remove('hidden');
          } else {
            selectedAddrBadge.classList.add('hidden');
          }
        }

        if (selectedAddrDetail) {
          selectedAddrDetail.textContent = fullTxt || addr.full_address || '';
        }
      }

      // Render Dropdown Items
      function renderDropdownMenu() {
        if (!dropdownMenu) return;

        dropdownMenu.innerHTML = `
          ${userSavedAddresses.map(addr => {
            const isSelected = addr.id === currentSelectedAddressId;
            const fullTxt = [
              addr.full_address,
              addr.benchmark_notes ? `Patokan: ${addr.benchmark_notes}` : '',
              addr.city ? `${addr.city}` : ''
            ].filter(Boolean).join(' • ');

            return `
              <div 
                class="address-dropdown-item p-3.5 hover:bg-rose-50/40 cursor-pointer transition-colors flex items-start justify-between gap-3 ${isSelected ? 'bg-rose-50/30' : ''}" 
                data-id="${addr.id}"
              >
                <div class="space-y-1 min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-sans font-medium uppercase tracking-wider text-gray-900">
                      ${addr.label_name || 'Rumah'} (${addr.recipient_name})
                    </span>
                    ${addr.is_default ? '<span class="text-[9px] font-sans font-medium text-[#5c1616] bg-rose-50 border border-rose-200 px-1.5 py-0.2 rounded-full uppercase">Utama</span>' : ''}
                  </div>
                  <p class="text-xs font-sans font-normal text-gray-500 line-clamp-1 leading-relaxed">
                    ${fullTxt || addr.full_address}
                  </p>
                </div>
                ${isSelected ? '<span class="text-[#5c1616] text-xs font-bold shrink-0 mt-0.5">Terpilih</span>' : ''}
              </div>
            `;
          }).join('')}
          
          <button 
            type="button" 
            id="btn-dropdown-add-new" 
            class="w-full p-3 text-left bg-gray-50 hover:bg-gray-100 text-[#5c1616] font-sans font-medium text-xs flex items-center gap-2 transition-colors cursor-pointer border-t border-gray-100"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            <span>Kelola / Tambah Alamat Baru di Peta...</span>
          </button>
        `;

        // Click on an address item
        dropdownMenu.querySelectorAll('.address-dropdown-item').forEach(item => {
          item.addEventListener('click', (e: any) => {
            const id = e.currentTarget.dataset.id;
            const chosen = userSavedAddresses.find(a => a.id === id);
            if (chosen) {
              applyAddressToForm(chosen);
              renderDropdownMenu();
              dropdownMenu.classList.add('hidden');
              if ((window as any).showToast) {
                (window as any).showToast(`Alamat "${chosen.label_name}" diterapkan!`, 'info');
              }
            }
          });
        });

        // Click on Add New button
        document.getElementById('btn-dropdown-add-new')?.addEventListener('click', () => {
          dropdownMenu.classList.add('hidden');
          if ((window as any).openAddressModal) {
            (window as any).openAddressModal();
          }
        });
      }

      // Load Saved Addresses from Supabase
      async function loadSavedAddressesForCheckout(selectedIdToPick: string | null = null) {
        try {
          const { data: addresses, error } = await supabase
            .from('user_addresses')
            .select('*')
            .eq('user_id', session.user.id)
            .order('is_default', { ascending: false })
            .order('created_at', { ascending: false });

          if (error || !addresses || addresses.length === 0) {
            savedDropdownContainer?.classList.add('hidden');
            return;
          }

          userSavedAddresses = addresses;
          savedDropdownContainer?.classList.remove('hidden');

          // Pick requested ID or Default Address (which is guaranteed 1st element)
          const targetAddr = selectedIdToPick 
            ? addresses.find(a => a.id === selectedIdToPick) 
            : addresses[0];

          if (targetAddr) {
            applyAddressToForm(targetAddr);
          }
          renderDropdownMenu();
        } catch(e) {
          console.warn('Error loading addresses in checkout', e);
        }
      }

      // Initial Load
      await loadSavedAddressesForCheckout();

      // Listen for custom events from AddressModal
      window.addEventListener('addressSelected', (e: any) => {
        if (e.detail && e.detail.id) {
          loadSavedAddressesForCheckout(e.detail.id);
        } else {
          applyAddressToForm(e.detail);
        }
        if ((window as any).showToast) (window as any).showToast('Alamat berhasil diterapkan!', 'success');
      });

      window.addEventListener('addressBookUpdated', () => {
        loadSavedAddressesForCheckout();
      });

      // Pay Now Logic
      const btnPayNow = document.getElementById('btn-pay-now');
      btnPayNow?.addEventListener('click', async () => {
        const selectedPayment = document.querySelector('input[name="payment"]:checked') as HTMLInputElement;
        
        const name = (document.getElementById('cust-name') as HTMLInputElement).value.trim();
        const phone = (document.getElementById('cust-phone') as HTMLInputElement).value.trim();
        const address = (document.getElementById('cust-address') as HTMLTextAreaElement).value.trim();

        if (!name || !phone || !address) {
          if ((window as any).showToast) (window as any).showToast('Mohon lengkapi informasi pengiriman', 'error');
          return;
        }

        if (!selectedPayment) {
          if ((window as any).showToast) (window as any).showToast('Silakan pilih metode pembayaran', 'error');
          return;
        }

        // Simulate Loading
        const originalText = btnPayNow.innerHTML;
        btnPayNow.innerHTML = `<div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div> Memproses...`;
        btnPayNow.setAttribute('disabled', 'true');

        try {
          // CREATE ORDER (Status: Pesanan Baru)
          const { data: order, error: orderError } = await supabase.from('orders').insert({
            user_id: session.user.id,
            customer_name: name,
            customer_phone: phone,
            customer_address: address,
            total_amount: finalTotal,
            status: 'Pesanan Baru'
          }).select().single();

          if (orderError) throw orderError;

          // Insert items
          const orderItems = cart.map((item: any) => ({
            order_id: order.id,
            product_id: item.id,
            product_name: item.name,
            product_image: item.image,
            size: item.size,
            outsole_model: item.outsole || 'Model 1',
            quantity: item.quantity,
            price: item.price
          }));

          const { error: itemsError } = await supabase.from('order_items').insert(orderItems);
          if (itemsError) throw itemsError;

          // Trigger Cloudflare Pages auto-build in background so E-Commerce static catalog updates
          fetch('https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/984ad6b4-c842-44cb-a50e-855dbfb7d6d4', { method: 'POST' }).catch(console.error);

          // SUCCESS
          localStorage.removeItem('ballqish_cart');
          window.location.href = '/?success=true';

        } catch (err: any) {
          console.error('Payment/Checkout Error:', err);
          if ((window as any).showToast) (window as any).showToast(`Gagal: ${err.message || 'Terjadi kesalahan'}`, 'error');
          btnPayNow.innerHTML = originalText;
          btnPayNow.removeAttribute('disabled');
        }
      });
    });
  </script>

  <AddressModal />
</Layout>
