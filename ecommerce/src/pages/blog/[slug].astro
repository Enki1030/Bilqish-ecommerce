---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: articles } = await supabase
    .from('articles')
    .select('slug')
    .eq('status', 'Published');

  return (articles || []).map(article => ({
    params: { slug: article.slug }
  }));
}

const { slug } = Astro.params;

// Fetch current article
const { data: article } = await supabase
  .from('articles')
  .select('*')
  .eq('slug', slug)
  .single();

if (!article) {
  return Astro.redirect('/blog');
}

// Fetch linked featured products if any
let featuredProducts = [];
if (article.featured_product_ids && article.featured_product_ids.length > 0) {
  const { data: prods } = await supabase
    .from('products')
    .select('*')
    .in('id', article.featured_product_ids);
  featuredProducts = prods || [];
}

// Fetch 3 other related articles
const { data: otherArticles } = await supabase
  .from('articles')
  .select('id, title, slug, cover_image, category, read_time_minutes')
  .eq('status', 'Published')
  .neq('slug', slug)
  .limit(3);

const currentUrl = `https://ballqish-ecommerce.pages.dev/blog/${article.slug}`;
---

<Layout 
  title={`${article.title} - Jurnal Ballqish`} 
  description={article.excerpt || article.meta_description || 'Baca artikel lengkap di Jurnal Ballqish Shoes.'}
>
<div data-theme="editorial" theme-ui class="bg-ivory min-h-screen py-12 md:py-20">
    <div class="max-w-[780px] mx-auto px-6 md:px-10">

      {/* Back Navigation — kembali ke beranda di ujung kiri */}
      <div class="flex items-center justify-between pb-5 mb-14 border-b border-line">
        <a href="/" class="home-back-btn inline-flex items-center gap-2.5 border border-ink/25 px-4 py-2.5 text-[11px] font-medium uppercase tracking-[0.2em] text-ink transition-colors duration-300 hover:bg-ink hover:text-ivory"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg> Kembali ke Beranda</a>
        <a href="/blog" class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.25em] text-ink/60 hover:text-oxblood transition-colors">
          Kembali ke Jurnal <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>

      {/* ============ PROFIL PENULIS (di atas judul & sub judul) ============ */}
      <div class="flex items-center gap-4 mb-12">
        <div class="w-10 h-10 rounded-full bg-ink text-ivory font-semibold text-[12px] flex items-center justify-center shrink-0">
          BQ
        </div>
        <div class="text-[14px] font-body">
          <p class="font-semibold text-ink">{article.author_name || 'Tim Pengrajin Ballqish'}</p>
          <p class="text-[12px] text-ink/50 mt-0.5">
            {new Date(article.published_at || article.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })} · {article.read_time_minutes || 3} menit baca
          </p>
        </div>
      </div>

      {/* ============ JUDUL (rata kiri, besar, bold) ============ */}
      <header class="mb-14">
        <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-6">
          {article.category}
        </span>

        <h1 class="text-[34px] md:text-[52px] font-bold text-ink leading-[1.12]">
          {article.title}
        </h1>

        {/* Sub judul / standfirst — dipakai hanya kalau artikel punya excerpt */}
        {article.excerpt && (
          <p class="text-[19px] text-ink/65 leading-[1.7] mt-7">
            {article.excerpt}
          </p>
        )}
      </header>

      {/* ============ GAMBAR — natural, tanpa rounded & tanpa shadow ============ */}
      {article.cover_image && (
        <figure class="mb-14">
          <img
            src={article.cover_image}
            alt={article.title}
            class="w-full h-auto"
          />
        </figure>
      )}

      {/* ============ ISI ARTIKEL — sans-serif, ukuran besar, di atas cream ============ */}
      <article class="article-body">
        <div class="article-content" set:html={article.content} />
      </article>

      {/* Social Share Bar */}
      <div class="mt-16 pt-8 pb-8 border-t border-b border-line flex flex-col sm:flex-row items-center justify-between gap-4">
        <span class="text-[11px] uppercase tracking-[0.25em] text-ink/50">
          Bagikan Artikel Ini
        </span>
        <div class="flex items-center gap-3">
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.title + ' ' + currentUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 bg-ink text-ivory text-[11px] uppercase tracking-[0.2em] px-5 py-3 hover:bg-oxblood transition-colors"
          >
            WhatsApp
          </a>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(currentUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 bg-ink hover:bg-oxblood text-ivory text-[11px] uppercase tracking-[0.2em] px-4 py-2.5 transition-colors"
          >
            Twitter / X
          </a>
          <button
            id="btn-copy-link"
            type="button"
            class="inline-flex items-center gap-1.5 bg-transparent hover:bg-bone text-ink text-[11px] uppercase tracking-[0.2em] px-4 py-2.5 transition-colors border border-line cursor-pointer"
          >
            Salin Link
          </button>
        </div>
      </div>

      {/* Featured Products Widget */}
      {featuredProducts.length > 0 && (
        <div class="mt-16 space-y-8">
          <div class="flex flex-col sm:flex-row justify-between sm:items-end gap-3">
            <div>
              <span class="block text-[10px] uppercase tracking-[0.35em] text-brass mb-3">Content to Commerce</span>
              <h3 class="text-3xl font-normal text-ink">Sepatu Terkait dalam Artikel Ini</h3>
            </div>
            <a href="/" class="text-[11px] uppercase tracking-[0.25em] text-ink border-b border-ink pb-1 hover:text-oxblood hover:border-oxblood transition-colors shrink-0">Lihat Semua Sepatu</a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-10">
            {featuredProducts.map(prod => (
              <div class="flex flex-col gap-3">
                <div class="aspect-[4/5] bg-bone overflow-hidden">
                  <img src={prod.image} alt={prod.name} class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" />
                </div>
                <div>
                  <h4 class="text-[20px] font-normal text-ink line-clamp-1">{prod.name}</h4>
                  <p class="text-[15px] font-semibold text-ink mt-1.5">Rp {prod.price.toLocaleString('id-ID')}</p>
                </div>
                <a href={`/product/${prod.id}`} class="block text-center w-full py-3.5 bg-ink hover:bg-oxblood text-ivory text-[11px] uppercase tracking-[0.25em] transition-colors">
                  Beli Sepatu Ini
                </a>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Other Articles Recommendation */}
      {otherArticles && otherArticles.length > 0 && (
        <div class="mt-20 space-y-8">
          <h3 class="text-[10px] uppercase tracking-[0.35em] text-brass">
            Artikel Menarik Lainnya
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-10">
            {otherArticles.map(other => (
              <a href={`/blog/${other.slug}`} class="group relative block overflow-hidden bg-bone aspect-[4/5]">
                <img src={other.cover_image} alt={other.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-ink/92 via-ink/45 to-transparent"></div>
                <div class="absolute inset-x-0 bottom-0 p-5">
                  <span class="block text-[10px] uppercase tracking-[0.25em] text-brass mb-2.5">{other.category}</span>
                  <h4 class="text-[20px] font-normal text-ivory leading-snug line-clamp-2">
                    {other.title}
                  </h4>
                  <span class="inline-flex items-center gap-2 mt-3.5 text-[10px] uppercase tracking-[0.25em] text-ivory/80 transition-colors duration-300 group-hover:text-ivory">
                    Lihat Selengkapnya
                    <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

    </div>
  </div>

  <style is:inline>
    /* ============================================================
       AREA BACA ARTIKEL — 100% sans-serif (Inter), ukuran besar.
       Selaras dengan fitur heading h1-h5 di Blog Editor (admin-dashboard):
       nanti saat admin memakai H1/H2/H3/H4/H5, hasilnya otomatis mengikuti
       skala di bawah ini — tidak perlu ubah kode lagi.
         h1 40px | h2 32px | h3 26px | h4 24px | h5 21px | h6 19px
       ============================================================ */
    .article-body .article-content,
    .article-body .article-content * {
      font-family: 'Inter', ui-sans-serif, system-ui, sans-serif !important;
    }
    .article-body .article-content h1,
    .article-body .article-content h2,
    .article-body .article-content h3,
    .article-body .article-content h4,
    .article-body .article-content h5,
    .article-body .article-content h6 {
      font-family: 'Inter', ui-sans-serif, system-ui, sans-serif !important;
      font-weight: 700;
      color: #1a1512;
      line-height: 1.28;
      letter-spacing: -0.01em;
    }
    .article-body .article-content h1 {
      font-size: 40px; margin-top: 3rem; margin-bottom: 1.1rem;
    }
    .article-body .article-content h2 {
      font-size: 32px; margin-top: 2.75rem; margin-bottom: 1rem;
    }
    .article-body .article-content h3 {
      font-size: 26px; margin-top: 2.25rem; margin-bottom: 0.85rem;
    }
    .article-body .article-content h4 {
      font-size: 24px; margin-top: 1.75rem; margin-bottom: 0.7rem;
    }
    .article-body .article-content h5 {
      font-size: 21px; margin-top: 1.5rem; margin-bottom: 0.6rem;
    }
    .article-body .article-content h6 {
      font-size: 19px; margin-top: 1.25rem; margin-bottom: 0.5rem;
      text-transform: uppercase; letter-spacing: 0.1em;
    }
    .article-body .article-content p {
      font-size: 23px;
      line-height: 1.85;
      margin-bottom: 1.5rem;
      color: rgba(26, 21, 18, 0.88);
    }
    .article-body .article-content blockquote {
      border-left: 3px solid #8c6239;
      padding: 0.25rem 0 0.25rem 1.5rem;
      font-style: italic;
      font-size: 24px;
      line-height: 1.7;
      color: rgba(26, 21, 18, 0.75);
      margin: 2rem 0;
    }
    .article-body .article-content ul,
    .article-body .article-content ol {
      padding-left: 1.5rem;
      margin-bottom: 1.5rem;
      font-size: 23px;
      line-height: 1.8;
    }
    .article-body .article-content ul { list-style-type: disc; }
    .article-body .article-content ol { list-style-type: decimal; }
    .article-body .article-content li { margin-bottom: 0.6rem; }
    .article-body .article-content li::marker { color: #8c6239; }
    .article-body .article-content img {
      width: 100%;
      height: auto;
      margin: 2rem 0;
    }
    .article-body .article-content a {
      color: #5a1a1c;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .article-body .article-content strong { font-weight: 700; color: #1a1512; }
    .article-body .article-content hr {
      border: 0;
      border-top: 1px solid #e5e2dc;
      margin: 2.5rem 0;
    }

    /* ------------------------------------------------------------------
       Kompatibilitas konten lama.
       Artikel yang sudah tersimpan di database masih membawa class Tailwind
       versi lama (dihasilkan BlogEditor). Isi database tidak diubah —
       class tersebut dinetralkan di sini agar tampilan artikel konsisten
       dengan palet editorial yang baru.
       ------------------------------------------------------------------ */
    .article-body .article-content blockquote[class] {
      border-left: 3px solid #a8865a !important;
      border-top: 0 !important;
      border-right: 0 !important;
      border-bottom: 0 !important;
      border-radius: 0 !important;
      padding: 0.25rem 0 0.25rem 1.5rem !important;
      background: transparent !important;
      color: rgba(26, 21, 18, 0.75) !important;
      font-style: italic !important;
      font-size: 24px !important;
      line-height: 1.7 !important;
      margin: 2rem 0 !important;
    }
    /* Tautan artikel: dari merah lama -> oxblood */
    .article-body .article-content a[class*="text-[#5c1616]"] {
      color: #5a1a1c !important;
    }
    /* Gambar dalam artikel: hilangkan bayangan & sudut membulat */
    .article-body .article-content img[class*="shadow-"],
    .article-body .article-content img[class*="rounded-"] {
      border-radius: 0 !important;
      box-shadow: none !important;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btnCopy = document.getElementById('btn-copy-link');
      btnCopy?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          btnCopy.textContent = '✓ Tersalin!';
          setTimeout(() => {
            btnCopy.textContent = 'Salin Link';
          }, 2000);
        } catch(e) {}
      });
    });
  </script>
</Layout>
