---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: articles } = await supabase
    .from('articles')
    .select('slug')
    .eq('status', 'Published');

  return (articles || []).map(article => ({
    params: { slug: article.slug }
  }));
}

const { slug } = Astro.params;

// Fetch current article
const { data: article } = await supabase
  .from('articles')
  .select('*')
  .eq('slug', slug)
  .single();

if (!article) {
  return Astro.redirect('/blog');
}

// Fetch linked featured products if any
let featuredProducts = [];
if (article.featured_product_ids && article.featured_product_ids.length > 0) {
  const { data: prods } = await supabase
    .from('products')
    .select('*')
    .in('id', article.featured_product_ids);
  featuredProducts = prods || [];
}

// Fetch 3 other related articles
const { data: otherArticles } = await supabase
  .from('articles')
  .select('id, title, slug, cover_image, category, read_time_minutes')
  .eq('status', 'Published')
  .neq('slug', slug)
  .limit(3);

const currentUrl = `https://ballqish-ecommerce.pages.dev/blog/${article.slug}`;
---

<Layout 
  title={`${article.title} - Jurnal Ballqish`} 
  description={article.excerpt || article.meta_description || 'Baca artikel lengkap di Jurnal Ballqish Shoes.'}
>
  <div class="bg-[#FAF9F6] min-h-screen py-8 sm:py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-10">
      
      <!-- Back Navigation -->
      <div class="flex items-center justify-between border-b border-gray-200 pb-4">
        <a href="/blog" class="inline-flex items-center gap-2 text-xs font-heading font-semibold uppercase tracking-widest text-gray-500 hover:text-[#5c1616] transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Kembali ke Jurnal
        </a>
        <span class="text-xs font-body text-gray-400">
          {new Date(article.published_at || article.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
        </span>
      </div>

      <!-- Article Header Header -->
      <div class="space-y-4 sm:space-y-6 text-center max-w-3xl mx-auto">
        <div class="flex items-center justify-center gap-2.5">
          <span class="bg-rose-100 text-[#5c1616] text-xs font-heading font-bold uppercase tracking-wider px-3 py-1 rounded-full">
            {article.category}
          </span>
          <span class="text-xs text-gray-400 font-body">•</span>
          <span class="text-xs text-gray-500 font-body">{article.read_time_minutes || 3} menit baca</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-heading font-bold text-gray-900 leading-tight">
          {article.title}
        </h1>

        <div class="flex items-center justify-center gap-3 pt-2">
          <div class="w-8 h-8 rounded-full bg-[#5c1616] text-white font-bold text-xs flex items-center justify-center shadow-xs">
            BQ
          </div>
          <div class="text-left text-xs font-body">
            <p class="font-bold text-gray-900">{article.author_name || 'Tim Pengrajin Ballqish'}</p>
            <p class="text-gray-500 text-[11px]">Ditinjau oleh Tim Ahli Kulit</p>
          </div>
        </div>
      </div>

      <!-- Cover Image -->
      {article.cover_image && (
        <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-200 bg-gray-100 max-h-[480px]">
          <img 
            src={article.cover_image} 
            alt={article.title} 
            class="w-full h-full object-cover max-h-[480px]" 
          />
        </div>
      )}

      <!-- Article Body Content (Rich Prose) -->
      <article class="bg-white p-6 sm:p-10 lg:p-12 rounded-2xl border border-gray-200 shadow-xs">
        <div class="article-content font-body text-gray-800 leading-relaxed text-sm sm:text-base space-y-6" set:html={article.content} />
      </article>

      <!-- Social Share Bar -->
      <div class="bg-white p-5 sm:p-6 rounded-2xl border border-gray-200 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
        <span class="text-xs font-heading font-bold text-gray-900 uppercase tracking-wider">
          Bagikan Artikel Ini:
        </span>
        <div class="flex items-center gap-2.5">
          <a 
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.title + ' ' + currentUrl)}`} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium px-3.5 py-2 rounded-xl transition-colors shadow-2xs"
          >
            WhatsApp
          </a>
          <a 
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(currentUrl)}`} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 bg-gray-900 hover:bg-black text-white text-xs font-medium px-3.5 py-2 rounded-xl transition-colors shadow-2xs"
          >
            Twitter / X
          </a>
          <button 
            id="btn-copy-link" 
            type="button" 
            class="inline-flex items-center gap-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-medium px-3.5 py-2 rounded-xl transition-colors border border-gray-200 cursor-pointer"
          >
            Salin Link
          </button>
        </div>
      </div>

      <!-- Featured Products Widget (Content-to-Commerce) -->
      {featuredProducts.length > 0 && (
        <div class="bg-gradient-to-br from-[#5c1616]/5 to-rose-50 border border-rose-200 p-6 sm:p-8 rounded-2xl space-y-5">
          <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-2 border-b border-rose-200/60 pb-3">
            <div>
              <span class="text-[10px] font-heading font-bold uppercase tracking-widest text-[#5c1616]">Content to Commerce</span>
              <h3 class="text-lg font-heading font-bold text-gray-900">Sepatu Terkait dalam Artikel Ini</h3>
            </div>
            <a href="/" class="text-xs font-heading font-bold text-[#5c1616] hover:underline">Lihat Semua Sepatu →</a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {featuredProducts.map(prod => (
              <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-2xs space-y-3 flex flex-col justify-between">
                <div class="space-y-2">
                  <div class="h-36 bg-gray-50 rounded-lg overflow-hidden flex items-center justify-center p-2">
                    <img src={prod.image} alt={prod.name} class="max-h-full object-contain mix-blend-multiply hover:scale-105 transition-transform" />
                  </div>
                  <h4 class="font-heading font-semibold text-xs text-gray-900 line-clamp-1 uppercase tracking-wide">{prod.name}</h4>
                  <p class="text-xs font-bold text-[#5c1616]">Rp {prod.price.toLocaleString('id-ID')}</p>
                </div>
                <a href={`/product/${prod.id}`} class="block text-center w-full py-2 bg-[#5c1616] hover:bg-[#400f0f] text-white text-[11px] font-heading font-semibold uppercase tracking-wider rounded-lg transition-colors shadow-2xs">
                  Beli Sepatu Ini
                </a>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Other Articles Recommendation -->
      {otherArticles && otherArticles.length > 0 && (
        <div class="space-y-4 pt-6 border-t border-gray-200">
          <h3 class="text-sm font-heading font-bold text-gray-900 uppercase tracking-widest">
            Artikel Menarik Lainnya
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {otherArticles.map(other => (
              <a href={`/blog/${other.slug}`} class="group bg-white p-3.5 rounded-xl border border-gray-200 hover:shadow-md transition-all space-y-2.5">
                <div class="h-32 bg-gray-100 rounded-lg overflow-hidden">
                  <img src={other.cover_image} alt={other.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
                <span class="text-[9px] font-heading font-bold text-[#5c1616] uppercase tracking-wider">{other.category}</span>
                <h4 class="text-xs font-heading font-semibold text-gray-900 group-hover:text-[#5c1616] line-clamp-2 leading-snug">
                  {other.title}
                </h4>
              </a>
            ))}
          </div>
        </div>
      )}

    </div>
  </div>

  <style is:inline>
    .article-content h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: #111827;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      line-height: 1.3;
    }
    .article-content h3 {
      font-family: 'Playfair Display', serif;
      font-size: 1.25rem;
      font-weight: 600;
      color: #1f2937;
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }
    .article-content p {
      margin-bottom: 1.25rem;
      color: #374151;
      line-height: 1.8;
    }
    .article-content blockquote {
      border-left: 4px solid #5c1616;
      padding-left: 1.25rem;
      font-style: italic;
      color: #4b5563;
      background: #FAF9F6;
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
      border-radius: 0 0.5rem 0.5rem 0;
    }
    .article-content ul {
      list-style-type: disc;
      padding-left: 1.5rem;
      margin-bottom: 1.25rem;
      color: #374151;
    }
    .article-content ol {
      list-style-type: decimal;
      padding-left: 1.5rem;
      margin-bottom: 1.25rem;
      color: #374151;
    }
    .article-content li {
      margin-bottom: 0.5rem;
    }
    .article-content img {
      border-radius: 0.75rem;
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      width: 100%;
      max-height: 450px;
      object-fit: cover;
    }
    .article-content a {
      color: #5c1616;
      text-decoration: underline;
      font-weight: 600;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btnCopy = document.getElementById('btn-copy-link');
      btnCopy?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          btnCopy.textContent = '✓ Tersalin!';
          setTimeout(() => {
            btnCopy.textContent = 'Salin Link';
          }, 2000);
        } catch(e) {}
      });
    });
  </script>
</Layout>
