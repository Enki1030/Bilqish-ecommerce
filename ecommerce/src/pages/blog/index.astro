---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

// Fetch published articles
const { data: rawArticles } = await supabase
  .from('articles')
  .select('*')
  .eq('status', 'Published')
  .order('published_at', { ascending: false });

const articles = rawArticles || [];
const featuredArticle = articles[0] || null;
const regularArticles = articles.length > 1 ? articles.slice(1) : [];

const categories = ['Semua', 'Tips & Perawatan', 'Kisah Pengrajin', 'Gaya & Tren', 'Behind the Scenes'];
---

<Layout title="Jurnal & Edukasi Sepatu Kulit - Ballqish Shoes" description="Koleksi artikel, tips perawatan sepatu kulit asli, panduan gaya, dan kisah di balik dedikasi pengrajin sepatu lokal Ballqish.">
  <div class="bg-[#FAF9F6] min-h-screen py-8 sm:py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-12">
      
      <!-- Page Header -->
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="text-xs font-heading font-bold text-[#5c1616] uppercase tracking-widest bg-rose-50 border border-rose-200 px-3 py-1 rounded-full inline-block">
          Jurnal & Cerita Ballqish
        </span>
        <h1 class="text-3xl sm:text-4xl font-heading font-bold text-gray-900 tracking-tight">
          Edukasi & Cerita Dibalik Sepatu Berkualitas
        </h1>
        <p class="text-xs sm:text-sm text-gray-600 font-body leading-relaxed">
          Temukan panduan merawat sepatu kulit asli, inspirasi gaya harian, dan dedikasi tangan-tangan terampil pengrajin lokal.
        </p>
      </div>

      <!-- Search & Category Filters -->
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-3">
          <!-- Category Tabs -->
          <div class="flex items-center gap-2 overflow-x-auto no-scrollbar w-full sm:w-auto pb-1" id="category-tabs">
            {categories.map((cat, idx) => (
              <button 
                type="button" 
                class={`category-tab-btn px-4 py-2 rounded-xl text-xs font-heading font-semibold uppercase tracking-wider transition-all whitespace-nowrap cursor-pointer ${
                  idx === 0 ? 'bg-[#5c1616] text-white shadow-xs' : 'bg-white text-gray-700 hover:bg-gray-100 border border-gray-200'
                }`}
                data-category={cat}
              >
                {cat}
              </button>
            ))}
          </div>

          <!-- Search Box -->
          <div class="relative w-full sm:w-72">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <input 
              type="text" 
              id="article-search" 
              class="w-full bg-white border border-gray-200 rounded-xl pl-9 pr-4 py-2 text-xs font-body focus:outline-none focus:border-[#5c1616] transition-colors" 
              placeholder="Cari judul artikel..." 
            />
          </div>
        </div>
      </div>

      <!-- Featured Hero Article -->
      {featuredArticle && (
        <div id="featured-article-card" class="article-item" data-category={featuredArticle.category} data-title={featuredArticle.title.toLowerCase()}>
          <a href={`/blog/${featuredArticle.slug}`} class="group relative block bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
              <div class="lg:col-span-7 h-64 sm:h-80 lg:h-96 relative overflow-hidden bg-gray-100">
                <img 
                  src={featuredArticle.cover_image || 'https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=1200&q=80'} 
                  alt={featuredArticle.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                />
                <div class="absolute top-4 left-4">
                  <span class="bg-[#5c1616] text-white text-[10px] font-heading font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-md">
                    ★ Pilihan Utama
                  </span>
                </div>
              </div>

              <div class="lg:col-span-5 p-6 sm:p-8 lg:p-10 flex flex-col justify-between space-y-6">
                <div class="space-y-3">
                  <div class="flex items-center gap-2.5 text-xs text-gray-500 font-body">
                    <span class="font-semibold text-[#5c1616] uppercase tracking-wider">{featuredArticle.category}</span>
                    <span>•</span>
                    <span>{featuredArticle.read_time_minutes || 3} mnt baca</span>
                  </div>

                  <h2 class="text-xl sm:text-2xl font-heading font-bold text-gray-900 group-hover:text-[#5c1616] transition-colors leading-snug">
                    {featuredArticle.title}
                  </h2>

                  <p class="text-xs sm:text-sm text-gray-600 font-body line-clamp-3 leading-relaxed">
                    {featuredArticle.excerpt || 'Pelajari rahasia dan panduan lengkap tentang teknik pembuatan dan perawatan sepatu kulit asli.'}
                  </p>
                </div>

                <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                  <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-full bg-rose-100 text-[#5c1616] font-bold text-xs flex items-center justify-center">
                      BQ
                    </div>
                    <span class="text-xs font-body font-medium text-gray-700">{featuredArticle.author_name || 'Tim Ballqish'}</span>
                  </div>
                  <span class="text-xs font-heading font-bold text-[#5c1616] group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    Baca Artikel →
                  </span>
                </div>
              </div>
            </div>
          </a>
        </div>
      )}

      <!-- Articles Grid -->
      <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {regularArticles.map(article => (
          <article class="article-item group bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col" data-category={article.category} data-title={article.title.toLowerCase()}>
            <a href={`/blog/${article.slug}`} class="block relative h-48 sm:h-52 overflow-hidden bg-gray-100">
              <img 
                src={article.cover_image || 'https://images.unsplash.com/photo-1560769629-975ec94e6a86?auto=format&fit=crop&w=800&q=80'} 
                alt={article.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
              <div class="absolute top-3 left-3">
                <span class="bg-white/90 backdrop-blur-xs text-gray-900 text-[10px] font-heading font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-md shadow-2xs">
                  {article.category}
                </span>
              </div>
            </a>

            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <div class="flex items-center gap-2 text-[11px] text-gray-400 font-body">
                  <span>{new Date(article.published_at || article.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                  <span>•</span>
                  <span>{article.read_time_minutes || 3} mnt baca</span>
                </div>

                <a href={`/blog/${article.slug}`}>
                  <h3 class="text-base font-heading font-bold text-gray-900 group-hover:text-[#5c1616] transition-colors leading-snug line-clamp-2">
                    {article.title}
                  </h3>
                </a>

                <p class="text-xs text-gray-600 font-body line-clamp-2 leading-relaxed">
                  {article.excerpt}
                </p>
              </div>

              <div class="pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                <span class="text-gray-500 font-body text-[11px]">{article.author_name || 'Tim Ballqish'}</span>
                <a href={`/blog/${article.slug}`} class="font-heading font-bold text-[#5c1616] group-hover:underline">
                  Baca →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- No Articles Empty State -->
      <div id="no-articles-state" class="hidden text-center py-16 bg-white rounded-2xl border border-gray-200 space-y-3">
        <div class="w-12 h-12 rounded-full bg-rose-50 text-[#5c1616] flex items-center justify-center mx-auto">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
        </div>
        <h3 class="text-sm font-heading font-bold text-gray-900 uppercase tracking-wider">Artikel Tidak Ditemukan</h3>
        <p class="text-xs text-gray-500 max-w-sm mx-auto">Coba cari dengan kata kunci lain atau pilih kategori artikel yang berbeda.</p>
      </div>

      <!-- Commerce Banner CTA -->
      <div class="bg-gradient-to-br from-[#5c1616] to-[#3a0a0a] text-white p-8 sm:p-12 rounded-2xl shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <span class="text-[10px] font-heading font-bold uppercase tracking-widest text-rose-200">Sepatu Asli Pengrajin Lokal</span>
          <h2 class="text-2xl sm:text-3xl font-heading font-bold">Tertarik Merasakan Kenyamanan Sepatu Ballqish?</h2>
          <p class="text-xs sm:text-sm text-rose-100 font-body max-w-xl">
            Setiap pasang dirakit dengan bahan kulit sapi grade A dan jahitan tangan presisi bergaransi.
          </p>
        </div>
        <a href="/" class="bg-white text-[#5c1616] hover:bg-rose-50 px-6 py-3.5 rounded-xl font-heading font-bold text-xs uppercase tracking-widest transition-all shadow-md hover:scale-105 shrink-0">
          Lihat Koleksi Sepatu →
        </a>
      </div>

    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      let activeCategory = 'Semua';
      let searchQuery = '';

      const categoryButtons = document.querySelectorAll('.category-tab-btn');
      const searchInput = document.getElementById('article-search') as HTMLInputElement;
      const articleItems = document.querySelectorAll('.article-item');
      const noArticles = document.getElementById('no-articles-state');

      function filterArticles() {
        let visibleCount = 0;

        articleItems.forEach((item: any) => {
          const category = item.dataset.category || '';
          const title = item.dataset.title || '';

          const matchesCategory = activeCategory === 'Semua' || category === activeCategory;
          const matchesSearch = !searchQuery || title.includes(searchQuery);

          if (matchesCategory && matchesSearch) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (noArticles) {
          if (visibleCount === 0) {
            noArticles.classList.remove('hidden');
          } else {
            noArticles.classList.add('hidden');
          }
        }
      }

      categoryButtons.forEach(btn => {
        btn.addEventListener('click', (e: any) => {
          categoryButtons.forEach(b => {
            b.classList.remove('bg-[#5c1616]', 'text-white', 'shadow-xs');
            b.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
          });

          e.currentTarget.classList.add('bg-[#5c1616]', 'text-white', 'shadow-xs');
          e.currentTarget.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');

          activeCategory = e.currentTarget.dataset.category;
          filterArticles();
        });
      });

      searchInput?.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        filterArticles();
      });
    });
  </script>
</Layout>
