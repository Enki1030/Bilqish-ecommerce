---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

// Fetch published articles
const { data: rawArticles } = await supabase
  .from('articles')
  .select('*')
  .eq('status', 'Published')
  .order('published_at', { ascending: false });

const articles = rawArticles || [];
// 3 artikel teratas ditampilkan lebih besar, sisanya jadi kumpulan kartu kecil.
// Level ini murni untuk tampilan — query & urutan data tidak diubah.
const featuredArticles = articles.slice(0, 3);
const restArticles = articles.slice(3);

const categories = ['Semua', 'Tips & Perawatan', 'Kisah Pengrajin', 'Gaya & Tren', 'Behind the Scenes'];
---

<Layout title="Jurnal & Edukasi Sepatu Kulit - Ballqish Shoes" description="Koleksi artikel, tips perawatan sepatu kulit asli, panduan gaya, dan kisah di balik dedikasi pengrajin sepatu lokal Ballqish.">
<div data-theme="editorial" theme-ui class="bg-ivory min-h-screen py-14 md:py-20">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">

      {/* Jalur kembali ke beranda — di ujung kiri */}
      <div class="flex items-start justify-start mb-10">
        <a href="/" class="home-back-btn inline-flex items-center gap-2.5 border border-ink/25 px-4 py-2.5 text-[11px] font-medium uppercase tracking-[0.2em] text-ink transition-colors duration-300 hover:bg-ink hover:text-ivory"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg> Kembali ke Beranda</a>
      </div>

      {/* Page Header */}
      <div class="mb-12">
        <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-5">Jurnal &amp; Cerita</span>
        <h1 class="text-5xl md:text-6xl font-normal text-ink leading-[1.15]">Edukasi &amp; Cerita Dibalik Sepatu Berkualitas</h1>
        <p class="text-base text-ink/65 mt-6 max-w-2xl leading-relaxed">
          Temukan panduan merawat sepatu kulit asli, inspirasi gaya harian, dan dedikasi tangan-tangan terampil pengrajin lokal.
        </p>
      </div>

      {/* Search & Category Filters */}
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 pb-6 mb-12 border-b border-line">
        {/* Category Tabs */}
        <div class="flex items-center gap-8 overflow-x-auto no-scrollbar w-full lg:w-auto" id="category-tabs">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`category-tab-btn text-[14px] uppercase tracking-[0.16em] pb-3 border-b-2 whitespace-nowrap cursor-pointer transition-colors ${
                idx === 0 ? 'bg-[#5c1616] text-white shadow-xs' : 'bg-white text-gray-700 hover:bg-gray-100 border border-gray-200'
              }`}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>

        {/* Search Box — kotak putih agar jelas terpisah dari background ivory */}
        <div class="relative w-full lg:w-80 shrink-0">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-ink/50">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <input
            type="text"
            id="article-search"
            class="w-full bg-white border border-ink/25 pl-12 pr-4 py-3.5 text-[15px] text-ink placeholder:text-ink/40 font-body focus:outline-none focus:border-ink transition-colors"
            placeholder="Cari judul artikel..."
          />
        </div>
      </div>

      {/* ============ 3 ARTIKEL TERATAS — kartu besar ============ */}
      <div id="featured-article-card" class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-10 mb-24">
        {featuredArticles.map((article) => (
          <a
            href={`/blog/${article.slug}`}
            class="article-item group relative block overflow-hidden bg-bone aspect-[3/4]"
            data-category={article.category}
            data-title={article.title.toLowerCase()}
          >
            {article.cover_image ? (
              <img
                src={article.cover_image}
                alt={article.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105"
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-[10px] uppercase tracking-[0.25em] text-ink/40">Visual Cover</span>
              </div>
            )}

            <div class="absolute inset-0 bg-gradient-to-t from-ink/92 via-ink/45 to-transparent"></div>

            <div class="absolute inset-x-0 bottom-0 p-6">
              <span class="block text-[10px] uppercase tracking-[0.25em] text-brass mb-3">
                {article.category}
              </span>
              <h2 class="text-[26px] md:text-[28px] font-normal text-ivory leading-snug line-clamp-3">
                {article.title}
              </h2>
              <span class="inline-flex items-center gap-2 mt-4 text-[10px] uppercase tracking-[0.25em] text-ivory/80 transition-colors duration-300 group-hover:text-ivory">
                Baca Artikel
                <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      {/* ============ ARTIKEL LAINNYA — kartu kecil ============ */}
      {restArticles.length > 0 && (
        <div>
          <div class="flex items-end gap-8 mb-12">
            <div class="shrink-0">
              <span class="block text-[10px] uppercase tracking-[0.4em] text-brass mb-4">Terus Baca</span>
              <h2 class="text-3xl md:text-4xl font-normal text-ink leading-tight">Artikel Lainnya</h2>
            </div>
            <span class="flex-1 h-px bg-line mb-4"></span>
          </div>

          <div id="articles-grid" class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12">
            {restArticles.map((article) => (
              <a
                href={`/blog/${article.slug}`}
                class="article-item group block"
                data-category={article.category}
                data-title={article.title.toLowerCase()}
              >
                <div class="relative aspect-[4/5] overflow-hidden bg-bone">
                  {article.cover_image ? (
                    <img
                      src={article.cover_image}
                      alt={article.title}
                      class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105"
                    />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center">
                      <span class="text-[10px] uppercase tracking-[0.25em] text-ink/40">Visual Cover</span>
                    </div>
                  )}
                </div>

                <div class="pt-5">
                  <span class="block text-[10px] uppercase tracking-[0.25em] text-brass mb-2.5">
                    {article.category}
                  </span>
                  <h3 class="text-[20px] font-normal text-ink leading-snug line-clamp-2 group-hover:underline">
                    {article.title}
                  </h3>
                  <span class="inline-flex items-center gap-2 mt-4 text-[10px] uppercase tracking-[0.25em] text-ink/60 transition-colors group-hover:text-oxblood">
                    Baca
                    <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {/* No Articles Empty State */}
      <div id="no-articles-state" class="hidden text-center py-20 space-y-3">
        <div class="w-12 h-12 rounded-full bg-bone text-oxblood flex items-center justify-center mx-auto">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
        </div>
        <h3 class="text-[11px] uppercase tracking-[0.3em] text-ink">Artikel Tidak Ditemukan</h3>
        <p class="text-sm text-ink/50 max-w-sm mx-auto">Coba cari dengan kata kunci lain atau pilih kategori artikel yang berbeda.</p>
      </div>

      {/* Commerce Banner CTA */}
      <div class="mt-24 bg-oxblood text-ivory p-8 md:p-14 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-3 text-center md:text-left">
          <span class="block text-[10px] uppercase tracking-[0.35em] text-brass">Sepatu Asli Pengrajin Lokal</span>
          <h2 class="text-3xl md:text-4xl font-normal leading-snug">Tertarik Merasakan Kenyamanan Sepatu Ballqish?</h2>
          <p class="text-[15px] text-ivory/70 font-body max-w-xl leading-relaxed">
            Setiap pasang dirakit dengan bahan kulit sapi grade A dan jahitan tangan presisi bergaransi.
          </p>
        </div>
        <a href="/" class="inline-flex items-center justify-center bg-ink text-ivory px-8 py-4 text-[11px] uppercase tracking-[0.3em] shrink-0 transition-colors duration-300 hover:bg-ivory hover:text-ink">
          Lihat Koleksi Sepatu
        </a>
      </div>

    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      let activeCategory = 'Semua';
      let searchQuery = '';

      const categoryButtons = document.querySelectorAll('.category-tab-btn');
      const searchInput = document.getElementById('article-search') as HTMLInputElement;
      const articleItems = document.querySelectorAll('.article-item');
      const noArticles = document.getElementById('no-articles-state');

      function filterArticles() {
        let visibleCount = 0;

        articleItems.forEach((item: any) => {
          const category = item.dataset.category || '';
          const title = item.dataset.title || '';

          const matchesCategory = activeCategory === 'Semua' || category === activeCategory;
          const matchesSearch = !searchQuery || title.includes(searchQuery);

          if (matchesCategory && matchesSearch) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (noArticles) {
          if (visibleCount === 0) {
            noArticles.classList.remove('hidden');
          } else {
            noArticles.classList.add('hidden');
          }
        }
      }

      categoryButtons.forEach(btn => {
        btn.addEventListener('click', (e: any) => {
          categoryButtons.forEach(b => {
            b.classList.remove('bg-[#5c1616]', 'text-white', 'shadow-xs');
            b.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
          });

          e.currentTarget.classList.add('bg-[#5c1616]', 'text-white', 'shadow-xs');
          e.currentTarget.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');

          activeCategory = e.currentTarget.dataset.category;
          filterArticles();
        });
      });

      searchInput?.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        filterArticles();
      });
    });
  </script>
</Layout>
