---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Masuk / Daftar - Ballqish Shoes">
  <Header />

  <main data-theme="editorial" class="bg-ivory flex flex-col justify-center py-16 sm:px-6 lg:px-8">

    <div class="sm:mx-auto sm:w-full sm:max-w-md">
      <span class="block text-center text-[10px] uppercase tracking-[0.4em] text-brass mb-4">Akun Pelanggan</span>
      <h2 class="display-font text-center text-4xl font-normal text-ink leading-none">Selamat Datang</h2>
      <p class="mt-4 text-center text-[13px] text-ink/50 leading-relaxed">
        Masuk untuk melihat riwayat pesanan dan checkout lebih cepat.
      </p>
    </div>

    <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-md">

      {/* Google */}
      <button
        id="btn-google"
        class="w-full flex justify-center items-center gap-3 bg-white border border-line text-ink text-[11px] uppercase tracking-[0.25em] py-4 hover:border-ink transition-colors cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Lanjutkan dengan Google
      </button>

      {/* Pemisah */}
      <div class="my-8 relative">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-line"></div>
        </div>
        <div class="relative flex justify-center">
          <span class="px-4 bg-ivory text-[10px] uppercase tracking-[0.3em] text-ink/40">Atau gunakan email</span>
        </div>
      </div>

      <div id="error-message" class="hidden mt-4 bg-oxblood/6 border border-oxblood/25 text-oxblood px-4 py-3 flex items-center gap-3 text-[13px]">
        <span id="error-text">Terjadi kesalahan</span>
      </div>

      <div id="success-message" class="hidden mt-4 bg-bone border border-line text-ink px-4 py-3 flex items-center gap-3 text-[13px]">
        <span id="success-text">Silakan periksa email Anda untuk link konfirmasi!</span>
      </div>

      {/* Form */}
      <form id="auth-form" class="mt-8 space-y-6">
        <div>
          <label for="email" class="block text-[10px] uppercase tracking-[0.25em] text-ink/50 mb-2.5">Alamat Email</label>
          <input
            id="email"
            type="email"
            required
            class="w-full border border-line bg-white px-4 py-3.5 text-[14px] text-ink placeholder:text-ink/25 focus:outline-none focus:border-ink transition-colors"
            placeholder="nama@email.com"
          />
        </div>

        <div>
          <label for="password" class="block text-[10px] uppercase tracking-[0.25em] text-ink/50 mb-2.5">Kata Sandi</label>
          <input
            id="password"
            type="password"
            required
            minlength="6"
            class="w-full border border-line bg-white px-4 py-3.5 text-[14px] text-ink placeholder:text-ink/25 focus:outline-none focus:border-ink transition-colors"
            placeholder="Minimal 6 karakter"
          />
        </div>

        <div class="pt-2 flex flex-col sm:flex-row gap-3">
          <button
            type="submit"
            id="btn-login"
            class="flex-1 flex justify-center items-center bg-ink text-ivory text-[11px] uppercase tracking-[0.3em] py-4 hover:bg-oxblood transition-colors cursor-pointer"
          >
            Masuk
          </button>
          <button
            type="button"
            id="btn-register"
            class="flex-1 flex justify-center items-center border border-ink text-ink text-[11px] uppercase tracking-[0.3em] py-4 hover:bg-ink hover:text-ivory transition-colors cursor-pointer"
          >
            Daftar Baru
          </button>
        </div>
      </form>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  // UI Elements
  const form = document.getElementById('auth-form') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const btnLogin = document.getElementById('btn-login') as HTMLButtonElement;
  const btnRegister = document.getElementById('btn-register') as HTMLButtonElement;
  const btnGoogle = document.getElementById('btn-google') as HTMLButtonElement;
  const errorBox = document.getElementById('error-message');
  const errorText = document.getElementById('error-text');
  const successBox = document.getElementById('success-message');
  const successText = document.getElementById('success-text');

  function showError(msg: string) {
    if (errorBox && errorText) {
      errorText.textContent = msg;
      errorBox.classList.remove('hidden');
      if (successBox) successBox.classList.add('hidden');
    }
  }

  function showSuccess(msg: string) {
    if (successBox && successText) {
      successText.textContent = msg;
      successBox.classList.remove('hidden');
      if (errorBox) errorBox.classList.add('hidden');
    }
  }

  function setLoading(btn: HTMLButtonElement, isLoading: boolean, defaultText: string) {
    if (isLoading) {
      btn.disabled = true;
      btn.innerHTML = `<svg class="w-5 h-5 animate-spin mx-auto text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;
    } else {
      btn.disabled = false;
      btn.textContent = defaultText;
    }
  }

  // --- LOGIN WITH EMAIL ---
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setLoading(btnLogin, true, 'Masuk');
    
    const { data, error } = await supabase.auth.signInWithPassword({
      email: emailInput.value,
      password: passwordInput.value,
    });

    if (error) {
      showError(error.message);
      setLoading(btnLogin, false, 'Masuk');
    } else {
      const redirect = new URLSearchParams(window.location.search).get('redirect');
      const safeRedirect = redirect && redirect.startsWith('/') && !redirect.startsWith('//') ? redirect : '/';
      window.location.href = safeRedirect;
    }
  });

  // --- REGISTER WITH EMAIL ---
  btnRegister.addEventListener('click', async () => {
    if (!emailInput.value || !passwordInput.value) {
      showError("Harap isi email dan password terlebih dahulu.");
      return;
    }
    
    setLoading(btnRegister, true, 'Daftar Baru');

    const { data, error } = await supabase.auth.signUp({
      email: emailInput.value,
      password: passwordInput.value,
    });

    setLoading(btnRegister, false, 'Daftar Baru');

    if (error) {
      showError(error.message);
    } else {
      showSuccess("Pendaftaran berhasil! Silakan periksa kotak masuk email Anda (atau folder Spam) untuk mengonfirmasi akun Anda.");
    }
  });

  // --- LOGIN WITH GOOGLE ---
  btnGoogle.addEventListener('click', async () => {
    const redirect = new URLSearchParams(window.location.search).get('redirect');
    const safeRedirect = redirect && redirect.startsWith('/') && !redirect.startsWith('//') ? redirect : '/';
    const { data, error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: {
        redirectTo: `${window.location.origin}/login?redirect=${encodeURIComponent(safeRedirect)}`,
      }
    });

    if (error) {
      showError(error.message);
    }
  });
</script>
