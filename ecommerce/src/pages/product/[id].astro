---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { supabase } from '../../lib/supabase';
import { products as defaultProducts } from '../../data/products';

export async function getStaticPaths() {
  let productList: any[] = [];
  try {
    const res = await supabase.from('products').select('id');
    if (res.data && res.data.length > 0) productList = res.data;
  } catch (e) {}

  if (productList.length === 0) {
    productList = defaultProducts.map(p => ({ id: p.id }));
  }

  return productList.map(p => ({
    params: { id: p.id }
  }));
}

const { id } = Astro.params;

let product: any = null;
try {
  const res = await supabase
    .from('products')
    .select('*')
    .eq('id', id)
    .single();
  if (res.data) product = res.data;
} catch (e) {}

if (!product) {
  const fb = defaultProducts.find(p => p.id === id);
  if (fb) {
    product = {
      ...fb,
      image_url: fb.image,
      model: fb.model || 'G'
    };
  } else {
    return Astro.redirect('/404');
  }
}

// Convert sizes array from JSON string if needed, or if it's already an array
const sizes = Array.isArray(product.sizes) ? product.sizes : JSON.parse(product.sizes || '[]');

// Extract all gallery / promo mockup photos safely from column OR embedded tag
let galleryList: string[] = [];

if (product.gallery_urls) {
  galleryList = Array.isArray(product.gallery_urls) ? product.gallery_urls : (typeof product.gallery_urls === 'string' ? JSON.parse(product.gallery_urls || '[]') : []);
}

// Fallback to embedded description tag if galleryList is empty
if (galleryList.length === 0 && product.description) {
  const match = product.description.match(/<!--GALLERY:(.*?)-->/);
  if (match && match[1]) {
    try {
      galleryList = JSON.parse(match[1]);
    } catch (e) {
      console.error(e);
    }
  }
}

// Query total sold quantity from order_items for this product
const { data: orderItemsData } = await supabase
  .from('order_items')
  .select('quantity')
  .eq('product_id', product.id);

const totalSold = (orderItemsData || []).reduce((sum, item) => sum + (Number(item.quantity) || 1), 0);

// Extract initial stock from product column OR embedded description tag
let initialStock = 50;
if (product.stock !== undefined && product.stock !== null) {
  initialStock = Number(product.stock);
} else if (product.description) {
  const stockMatch = product.description.match(/<!--STOCK:(\d+)-->/);
  if (stockMatch && stockMatch[1]) {
    initialStock = parseInt(stockMatch[1]);
  }
}

const effectiveStock = Math.max(0, initialStock - totalSold);

const allImages = [product.image_url, ...galleryList].filter(Boolean);
const cleanDescription = (product.description || '').replace(/<!--(GALLERY|STOCK):[\s\S]*?-->/g, '').trim();

---

<Layout title={`${product.name} - Ballqish Shoes`}>
  <Header />

  <main data-theme="editorial" theme-ui class="flex-1 bg-ivory pb-28 md:pb-16">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-8 md:py-12">

      {/* ---------- Kembali ke koleksi ---------- */}
      <a href="/#collection" class="inline-flex items-center gap-2 mb-8 text-[11px] uppercase tracking-[0.25em] text-ink/60 hover:text-oxblood transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Koleksi
      </a>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">

        {/* ================= KOLOM KIRI — GALERI (7 dari 12) ================= */}
        <div class="lg:col-span-6">

          {/* Gambar utama 1:1 + badge */}
          <div class="relative aspect-square bg-bone overflow-hidden">
            <img id="mainProductImage" src={product.image_url} alt={product.name} class="w-full h-full object-cover" />
            <span class="absolute bottom-4 left-4 bg-ivory/90 backdrop-blur-sm px-3 py-1.5 text-[10px] uppercase tracking-[0.25em] text-ink">
              Tampilan Utama
            </span>
          </div>

          {/* Galeri thumbnail 3 kolom */}
          <div id="thumbnail-gallery" class="grid grid-cols-3 gap-3 mt-3">
            {allImages.map((imgSrc, idx) => (
              <button
                type="button"
                data-img-src={imgSrc}
                class={`thumbnail-btn w-full aspect-square bg-bone border-2 overflow-hidden transition-all duration-300 cursor-pointer ${
                  idx === 0
                    ? 'border-gray-900 border-2'
                    : 'border-gray-200 opacity-70 hover:opacity-100'
                }`}
              >
                <img src={imgSrc} alt={`Tampilan ${idx + 1}`} class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        </div>

        {/* ================= KOLOM KANAN — INFORMASI (5 dari 12) ================= */}
        <div class="lg:col-span-6 flex flex-col">

          {/* LEVEL 1 — Kategori & Kode referensi */}
          <p class="text-[12px] uppercase tracking-[0.25em] text-ink/45">
            {product.category} — Ref. {product.model}
          </p>

          {/* LEVEL 2 — Nama produk */}
          <h1 class="mt-4 text-[34px] md:text-[44px] font-bold leading-[1.1] text-ink">
            {product.name}
          </h1>

          {/* LEVEL 3 — Material / sub judul */}
          <p class="mt-3 text-[15px] text-ink/60">
            {product.model || product.type || 'Kulit Sapi Pilihan'}
          </p>

          {/* LEVEL 4 — Harga */}
          <p class="mt-6 text-[22px] font-semibold text-ink">
            Rp {product.price.toLocaleString('id-ID')}
          </p>

          {/* LEVEL 5 — Deskripsi singkat */}
          <p class="mt-6 text-[14px] leading-[1.7] text-ink/65 line-clamp-4">
            {cleanDescription || `Sepatu ${product.name} dari Ballqish dirancang dengan tingkat ketelitian tinggi. Model ${product.model} ini menghadirkan perpaduan material premium yang tahan lama.`}
          </p>

          {/* LEVEL 6 — Pilihan ukuran */}
          <div class="mt-10">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-[11px] uppercase tracking-[0.25em] text-ink/50">Ukuran (EU)</h2>
              <a href="#size-chart" class="inline-flex items-center gap-1.5 text-[11px] uppercase tracking-[0.15em] text-ink/50 hover:text-oxblood transition-colors">
                Panduan ukuran
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15l6-6 4 4 8-8M21 5h-5M21 5v5"></path></svg>
              </a>
            </div>

            <div id="size-selector" class="grid grid-cols-4 sm:grid-cols-5 gap-3">
              {sizes.map(size => (
                <button
                  type="button"
                  data-size={size}
                  class="size-btn py-3 border border-gray-200 text-sm font-medium text-gray-700 hover:border-ink transition-all duration-200 focus:outline-none cursor-pointer"
                >
                  {size}
                </button>
              ))}
            </div>

            <p id="size-error" class="hidden mt-3 text-[11px] uppercase tracking-[0.15em] text-oxblood">
              Harap pilih ukuran terlebih dahulu
            </p>
          </div>

          {/* LEVEL 7 — Beli satuan / B2B */}
          <div class="mt-10">
            <h2 class="text-[11px] uppercase tracking-[0.25em] text-ink/50 mb-4">Jenis Pembelian</h2>
            <div class="grid grid-cols-2 gap-3" role="group" aria-label="Jenis pembelian">
              <button type="button" id="mode-satuan" class="purchase-mode cursor-pointer border border-gray-900 bg-gray-900 text-white px-4 py-3.5 text-[11px] uppercase tracking-[0.2em] transition-colors" data-mode="satuan" aria-pressed="true">
                Beli Satuan
              </button>
              <button type="button" id="mode-b2b" class="purchase-mode cursor-pointer border border-gray-200 bg-white text-gray-700 px-4 py-3.5 text-[11px] uppercase tracking-[0.2em] transition-colors" data-mode="b2b" aria-pressed="false">
                Beli B2B
              </button>
            </div>
          </div>

          {/* LEVEL 8 — Pilih jenis jahitan */}
          <div class="mt-10">
            <h2 class="text-[11px] uppercase tracking-[0.25em] text-ink/50 mb-4">Pilih Jenis Jahitan</h2>
            <div class="grid grid-cols-3 gap-3">
              {['Jahitan 1', 'Jahitan 2', 'Jahitan 3'].map((stitching, index) => (
                <label class="cursor-pointer">
                  <input type="radio" name="stitching" value={stitching} class="peer sr-only" checked={index === 0} />
                  <span class="block border p-1.5 transition-colors duration-300 border-line hover:border-ink/50 peer-checked:border-ink">
                    <span class="block aspect-square bg-bone overflow-hidden">
                      <img src={product.image_url} alt={stitching} class="w-full h-full object-cover opacity-85" />
                    </span>
                    <span class="block text-center text-[11px] uppercase tracking-[0.15em] text-ink/60 py-2.5">{stitching}</span>
                  </span>
                </label>
              ))}
            </div>
          </div>

          {/* LEVEL 9 — Pilih outsole */}
          <div class="mt-10">
            <h2 class="text-[11px] uppercase tracking-[0.25em] text-ink/50 mb-4">Pilih Outsole</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="cursor-pointer">
                <input type="radio" name="outsole" value="Model 1" class="peer sr-only" checked />
                <span class="flex items-center gap-3 border p-2 transition-colors duration-300 border-line hover:border-ink/50 peer-checked:border-ink">
                  <span class="w-14 h-14 bg-bone overflow-hidden shrink-0">
                    <img src={product.image_url} alt="Model 1" class="w-full h-full object-cover opacity-85" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-[13px] font-medium text-ink">Model 1</span>
                    <span class="block text-[12px] text-ink/55">Sol Standar</span>
                  </span>
                </span>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="outsole" value="Model 2" class="peer sr-only" />
                <span class="flex items-center gap-3 border p-2 transition-colors duration-300 border-line hover:border-ink/50 peer-checked:border-ink">
                  <span class="w-14 h-14 bg-bone overflow-hidden shrink-0">
                    <img src={product.image_url} alt="Model 2" class="w-full h-full object-cover opacity-85" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-[13px] font-medium text-ink">Model 2</span>
                    <span class="block text-[12px] text-ink/55">Sol Premium</span>
                  </span>
                </span>
              </label>
            </div>

            {/* Insole — hanya tampil pada mode B2B (dikendalikan JS) */}
            <div id="insole-selection" class="hidden mt-10">
              <h2 class="text-[11px] uppercase tracking-[0.25em] text-ink/50 mb-4">Pilih Insole</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {['Insole 1', 'Insole 2'].map((insole, index) => (
                  <label class="cursor-pointer">
                    <input type="radio" name="insole" value={insole} class="peer sr-only" checked={index === 0} />
                    <span class="flex items-center gap-3 border p-2 transition-colors duration-300 border-line hover:border-ink/50 peer-checked:border-ink">
                      <span class="w-14 h-14 bg-bone overflow-hidden shrink-0">
                        <img src={product.image_url} alt={insole} class="w-full h-full object-cover opacity-85" />
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[13px] font-medium text-ink">{insole}</span>
                        <span class="block text-[12px] text-ink/55">{index === 0 ? 'Standar' : 'Extra Empuk'}</span>
                      </span>
                    </span>
                  </label>
                ))}
              </div>
            </div>
          </div>

          {/* LEVEL 10 — Jumlah / stok */}
          <div class="mt-10">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-[11px] uppercase tracking-[0.25em] text-ink/50">Jumlah</h2>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex items-center border border-line bg-transparent">
                <button type="button" id="qty-minus" class="px-5 py-3.5 text-ink/60 hover:bg-bone hover:text-ink transition-colors focus:outline-none cursor-pointer" aria-label="Kurangi jumlah">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4"></path></svg>
                </button>
                <input type="number" id="qty-input" value="1" min="1" max={effectiveStock} class="w-14 text-center text-[15px] font-medium text-ink focus:outline-none bg-transparent appearance-none border-none p-0" readonly />
                <button type="button" id="qty-plus" class="px-5 py-3.5 text-ink/60 hover:bg-bone hover:text-ink transition-colors focus:outline-none cursor-pointer" aria-label="Tambah jumlah">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                </button>
              </div>

              <p id="quantity-note" class="text-[12px] text-ink/50">
                Sisa stok: <span id="live-stock-count">{effectiveStock}</span> pasang
              </p>
            </div>
            <p id="b2b-size-note" class="hidden mt-3 text-[12px] text-ink/55 border-l-2 border-oxblood pl-3">Ukuran ini akan dibuat seragam untuk seluruh jumlah B2B.</p>
          </div>

          {/* LEVEL 11 — Tombol aksi */}
          <div class="mt-10 flex items-stretch gap-3">
            <button id="add-to-cart-btn" class="flex-1 bg-ink border border-ink text-ivory font-medium text-[12px] uppercase tracking-[0.25em] px-8 py-4 hover:bg-oxblood hover:border-oxblood transition-colors cursor-pointer">
              Masukkan ke Tas
            </button>
            <button id="buy-now-btn" class="flex-1 bg-transparent border border-ink text-ink font-medium text-[12px] uppercase tracking-[0.25em] px-8 py-4 hover:bg-ink hover:text-ivory transition-colors cursor-pointer">
              Beli Sekarang
            </button>

            {/* Wishlist */}
            <button
              type="button"
              data-product-id={product.id}
              data-product-name={product.name}
              data-product-price={product.price}
              data-product-image={product.image_url}
              class="favorite-btn w-14 shrink-0 border border-ink/25 bg-ivory flex items-center justify-center text-ink/50 transition-colors duration-300 hover:border-ink cursor-pointer"
              aria-label="Simpan ke wishlist"
            >
              <svg class="w-5 h-5 fill-current transition-colors heart-icon" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            </button>
          </div>

          {/* Info tambahan (dikendalikan JS, tidak disruptif) */}
          <div class="mt-6 p-4 bg-bone/40 border border-line">
            <div class="flex items-center justify-between gap-3">
              <span class="text-[10px] uppercase tracking-[0.25em] text-ink/50">Estimasi Waktu Tiba</span>
              <span id="lead-time-mode-badge" class="text-[10px] font-medium uppercase tracking-[0.15em] text-ink bg-bone px-2 py-0.5">Stok Siap</span>
            </div>
            <p class="mt-2 text-[15px] font-medium text-ink" id="estimated-arrival-date">Menghitung estimasi...</p>
            <p class="mt-1 text-[11px] text-ink/50 leading-relaxed" id="estimated-arrival-details">
              Estimasi pengerjaan handmade & pengiriman standar.
            </p>
          </div>

          <div id="craftsman-material-notice" class="hidden mt-4 p-4 bg-amber-50 border border-amber-200">
            <p id="craftsman-notice-text" class="text-[12px] text-amber-900 leading-relaxed"></p>
          </div>

        </div>
      </div>
    </div>

    {/* ---------- Mobile Sticky Buy Bar ---------- */}
    <div class="fixed bottom-0 left-0 right-0 z-40 md:hidden bg-ivory/95 backdrop-blur-md px-4 py-3 border-t border-line flex items-center justify-between gap-3">
      <div>
        <span class="text-[10px] text-ink/50 block uppercase tracking-wider">Total Harga</span>
        <span class="text-[15px] font-semibold text-ink leading-none">Rp {product.price.toLocaleString('id-ID')}</span>
      </div>

      <div class="flex items-center gap-2 flex-1 max-w-[260px]">
        <button
          id="mobile-add-cart-btn"
          type="button"
          class="flex-1 py-3 px-2 border border-ink text-ink text-[11px] uppercase tracking-[0.15em] hover:bg-bone active:scale-95 transition-all text-center cursor-pointer"
        >
          + Tas
        </button>
        <button
          id="mobile-buy-now-btn"
          type="button"
          class="flex-1 py-3 px-2 bg-ink text-ivory text-[11px] uppercase tracking-[0.15em] hover:bg-oxblood active:scale-95 transition-all text-center cursor-pointer"
        >
          Beli
        </button>
      </div>
    </div>
  </main>

  <Footer />

  <style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    /* Hide number input arrows */
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
  </style>

  <script define:vars={{ product, initialStock, supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL, supabaseKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }}>
    document.addEventListener('DOMContentLoaded', () => {
      let selectedSize = null;
      let quantity = 1;
      let purchaseMode = 'satuan';
      let currentMaxStock = initialStock;
      // Minimum pembelian B2B: 10 pasang. Satuan tetap minimal 1.
      const B2B_MIN = 10;
      const B2B_STEP = 10;

      // --- DOM Elements ---
      const sizeBtns = document.querySelectorAll('.size-btn');
      const errorMsg = document.getElementById('size-error');
      const qtyInput = document.getElementById('qty-input');
      const btnMinus = document.getElementById('qty-minus');
      const btnPlus = document.getElementById('qty-plus');
      const btnAddToCart = document.getElementById('add-to-cart-btn');
      const btnBuyNow = document.getElementById('buy-now-btn');
      const outsoleRadios = document.querySelectorAll('input[name="outsole"]');
      const stitchingRadios = document.querySelectorAll('input[name="stitching"]');
      const insoleRadios = document.querySelectorAll('input[name="insole"]');
      const purchaseModeBtns = document.querySelectorAll('.purchase-mode');
      const insoleSelection = document.getElementById('insole-selection');
      const b2bSizeNote = document.getElementById('b2b-size-note');
      const quantityNote = document.getElementById('quantity-note');

      // --- Real-time Live Stock Sync from Supabase ---
      async function syncLiveStock() {
        if (!supabaseUrl || !supabaseKey) return;
        try {
          const res = await fetch(`${supabaseUrl}/rest/v1/order_items?product_id=eq.${product.id}&select=quantity`, {
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`
            }
          });
          if (res.ok) {
            const items = await res.json();
            const sold = items.reduce((acc, i) => acc + (Number(i.quantity) || 1), 0);
            currentMaxStock = Math.max(0, initialStock - sold);

            const stockEl = document.getElementById('live-stock-count');
            if (stockEl) stockEl.textContent = currentMaxStock.toString();

            if (qtyInput) qtyInput.setAttribute('max', currentMaxStock.toString());
          }
        } catch(e) {
          console.error('Failed to sync live stock:', e);
        }
      }

      syncLiveStock();

      // --- 3-Stage Dynamic Lead Time Calculator (Privacy-Safe) ---
      let rawMaterialsCache = null;

      async function updateDynamicLeadTime() {
        if (!supabaseUrl || !supabaseKey) return;

        try {
          if (!rawMaterialsCache) {
            const res = await fetch(`${supabaseUrl}/rest/v1/raw_materials?select=*`, {
              headers: {
                'apikey': supabaseKey,
                'Authorization': `Bearer ${supabaseKey}`
              }
            });
            if (res.ok) {
              rawMaterialsCache = await res.json();
            }
          }

          const mats = rawMaterialsCache || [];
          const selectedSolRadio = document.querySelector('input[name="outsole"]:checked');
          const solModel = selectedSolRadio ? selectedSolRadio.value : 'Model 1';

          const nameUpper = (product.name || '').toUpperCase();
          const isLaced = nameUpper.includes(' T') || nameUpper.endsWith('T') || nameUpper.includes('BERTALI') || nameUpper.includes('TALI');
          const isNonLaced = nameUpper.includes(' G') || nameUpper.endsWith('G') || nameUpper.includes('NON-TALI') || nameUpper.includes('SLIP');
          const upperSubType = isLaced ? 'Bertali' : 'Non-Tali';

          let upperDelay = 0;
          let solDelay = 0;

          // Check Upper Material Combined Stock across all vendors
          const matchingUppers = mats
            .filter(m => m.sub_type === upperSubType || (m.name || '').includes(upperSubType))
            .sort((a, b) => (Number(b.stock_quantity) || 0) - (Number(a.stock_quantity) || 0));
          const totalUpperStock = matchingUppers.reduce((acc, m) => acc + (Number(m.stock_quantity) || 0), 0);
          if (quantity > totalUpperStock) {
            const primaryUpper = matchingUppers[0];
            upperDelay = Number(primaryUpper?.delay_days || 2);
          }

          // Check Sol Material Combined Stock across all vendors
          const matchingSols = mats
            .filter(m => m.sub_type === solModel || (m.name || '').includes(solModel))
            .sort((a, b) => (Number(b.stock_quantity) || 0) - (Number(a.stock_quantity) || 0));
          const totalSolStock = matchingSols.reduce((acc, m) => acc + (Number(m.stock_quantity) || 0), 0);
          if (quantity > totalSolStock) {
            const primarySol = matchingSols[0];
            solDelay = Number(primarySol?.delay_days || 2);
          }

          // 3-Stage Formula: Procurement + 2 Days Production + 3 Days Default Shipping
          const procurementDelay = Math.max(upperDelay, solDelay);
          const productionDays = 2;
          const shippingDays = 3;
          const totalDaysMin = procurementDelay + productionDays + shippingDays;
          const totalDaysMax = totalDaysMin + 2;

          const nowMin = new Date();
          nowMin.setDate(nowMin.getDate() + totalDaysMin);
          const nowMax = new Date();
          nowMax.setDate(nowMax.getDate() + totalDaysMax);

          const minStr = nowMin.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
          const maxStr = nowMax.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });

          const arrivalEl = document.getElementById('estimated-arrival-date');
          if (arrivalEl) arrivalEl.textContent = `${minStr} - ${maxStr} ${nowMin.getFullYear()}`;

          const badgeEl = document.getElementById('lead-time-mode-badge');
          if (badgeEl) {
            if (procurementDelay > 0) {
              badgeEl.textContent = 'Pesanan Pengrajin';
              badgeEl.className = 'text-[10px] font-medium uppercase tracking-[0.15em] text-oxblood bg-oxblood/10 px-2 py-0.5';
            } else {
              badgeEl.textContent = 'Stok Siap';
              badgeEl.className = 'text-[10px] font-medium uppercase tracking-[0.15em] text-ink bg-bone px-2 py-0.5';
            }
          }
        } catch(e) {
          console.error('Lead time update error:', e);
        }
      }

      updateDynamicLeadTime();

      outsoleRadios.forEach(radio => {
        radio.addEventListener('change', updateDynamicLeadTime);
      });

      function updatePurchaseMode(nextMode) {
        purchaseMode = nextMode;
        const isB2b = purchaseMode === 'b2b';
        quantity = isB2b ? Math.min(B2B_MIN, currentMaxStock) : 1;

        purchaseModeBtns.forEach(button => {
          const isActive = button.dataset.mode === purchaseMode;
          button.classList.toggle('border-gray-900', isActive);
          button.classList.toggle('bg-gray-900', isActive);
          button.classList.toggle('text-white', isActive);
          button.classList.toggle('border-gray-200', !isActive);
          button.classList.toggle('bg-white', !isActive);
          button.classList.toggle('text-gray-700', !isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        insoleSelection?.classList.toggle('hidden', !isB2b);
        b2bSizeNote?.classList.toggle('hidden', !isB2b);
        if (quantityNote) {
          quantityNote.innerHTML = isB2b
            ? `Jumlah B2B: <span id="live-stock-count">${currentMaxStock}</span> pasang (kelipatan ${B2B_MIN})`
            : `Sisa stok: <span id="live-stock-count">${currentMaxStock}</span> pasang`;
        }
        if (qtyInput) qtyInput.value = quantity.toString();
        if (qtyInput) qtyInput.setAttribute('max', currentMaxStock.toString());

        // B2B sudah di batas minimum (10) -> tombol minus dimatikan
        if (btnMinus) {
          btnMinus.disabled = isB2b;
          btnMinus.style.opacity = isB2b ? '0.35' : '1';
          btnMinus.style.cursor = isB2b ? 'not-allowed' : 'pointer';
        }

        updateDynamicLeadTime();
      }

      purchaseModeBtns.forEach(button => {
        button.addEventListener('click', () => {
          updatePurchaseMode(button.dataset.mode || 'satuan');
        });
      });

      // --- Size Selection Logic ---
      sizeBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget;
          selectedSize = target.dataset.size;
          
          // Reset styles
          sizeBtns.forEach(b => {
            b.classList.remove('border-gray-900', 'bg-gray-900', 'text-white');
            b.classList.add('border-gray-200', 'text-gray-700');
          });
          
          // Apply active style
          target.classList.remove('border-gray-200', 'text-gray-700');
          target.classList.add('border-gray-900', 'bg-gray-900', 'text-white');
          
          // Hide error if selected
          if (errorMsg) errorMsg.classList.add('hidden');
        });
      });

      // --- Quantity Logic ---
      btnMinus?.addEventListener('click', () => {
        if (purchaseMode === 'b2b') return; // sudah minimum 10
        if (quantity > 1) {
          quantity -= 1;
          if (qtyInput) qtyInput.value = quantity.toString();
          updateDynamicLeadTime();
        }
      });

      btnPlus?.addEventListener('click', () => {
        const increment = purchaseMode === 'b2b' ? B2B_STEP : 1;
        if (quantity + increment <= currentMaxStock) {
          quantity += increment;
          if (qtyInput) qtyInput.value = quantity.toString();
          updateDynamicLeadTime();
        } else {
          if (window.showToast) window.showToast(purchaseMode === 'b2b' ? `Stok tidak cukup untuk menambah ${B2B_STEP} pasang` : 'Maksimal stok tercapai', 'error');
        }
      });

      // --- Add to Cart Logic ---
      function handleAddToCart(buyNow = false) {
        if (!selectedSize) {
          if (errorMsg) errorMsg.classList.remove('hidden');
          
          // Shake animation on size selector
          const selector = document.getElementById('size-selector');
          selector.classList.add('animate-[shake_0.5s_ease-in-out]');
          setTimeout(() => selector.classList.remove('animate-[shake_0.5s_ease-in-out]'), 500);
          
          if (window.showToast) window.showToast('Pilih ukuran terlebih dahulu', 'error');
          return;
        }

        let selectedOutsole = 'Model 1';
        outsoleRadios.forEach(radio => {
          if (radio.checked) selectedOutsole = radio.value;
        });

        let selectedStitching = 'Jahitan 1';
        stitchingRadios.forEach(radio => {
          if (radio.checked) selectedStitching = radio.value;
        });

        let selectedInsole = null;
        insoleRadios.forEach(radio => {
          if (radio.checked) selectedInsole = radio.value;
        });

        // Load existing cart
        let cart = [];
        try {
          const c = localStorage.getItem('ballqish_cart');
          if (c) cart = JSON.parse(c);
        } catch(e) {}

        const itemToAdd = {
          id: product.id,
          name: product.name,
          price: product.price,
          image: product.image_url,
          mode: purchaseMode,
          size: selectedSize,
          stitching: selectedStitching,
          outsole: selectedOutsole,
          insole: purchaseMode === 'b2b' ? selectedInsole : null,
          quantity: quantity
        };

        const existingItemIndex = cart.findIndex(item => item.id === itemToAdd.id && item.mode === itemToAdd.mode && item.size === itemToAdd.size && item.stitching === itemToAdd.stitching && item.outsole === itemToAdd.outsole && item.insole === itemToAdd.insole);
        
        if (existingItemIndex > -1) {
          cart[existingItemIndex].quantity += itemToAdd.quantity;
        } else {
          cart.push(itemToAdd);
        }

        localStorage.setItem('ballqish_cart', JSON.stringify(cart));

        if (window.showToast) {
          window.showToast(`Berhasil menambahkan ${itemToAdd.quantity} pasang ke keranjang!`, 'success');
        }

        // Trigger custom event so Header can update cart count
        window.dispatchEvent(new Event('cartUpdated'));

        if (buyNow) {
          // Direct redirect to checkout without intermediate modal
          window.location.href = '/checkout';
        }
      }

      // ---------- Wishlist (tombol kotak di panel aksi) ----------
      // Memakai key localStorage yang sama dengan kartu produk di homepage,
      // sehingga statusnya konsisten di kedua halaman.
      const favBtnEl = document.querySelector('.favorite-btn');
      if (favBtnEl) {
        const pid = favBtnEl.getAttribute('data-product-id');
        const pname = favBtnEl.getAttribute('data-product-name');
        const pprice = favBtnEl.getAttribute('data-product-price');
        const pimage = favBtnEl.getAttribute('data-product-image');

        const readFavs = () => {
          try {
            const f = localStorage.getItem('ballqish_favs');
            return f ? JSON.parse(f) : [];
          } catch (e) { return []; }
        };

        const paintWishlist = () => {
          const on = readFavs().some(f => f.id === pid);
          const icon = favBtnEl.querySelector('.heart-icon');
          if (!icon) return;
          if (on) {
            icon.classList.add('text-red-500', 'fill-red-500');
            icon.classList.remove('text-gray-300', 'fill-current');
          } else {
            icon.classList.remove('text-red-500', 'fill-red-500');
            icon.classList.add('text-gray-300', 'fill-current');
          }
        };

        favBtnEl.addEventListener("click", (ev) => {
          ev.stopPropagation();
          const favs = readFavs();
          const idx = favs.findIndex(f => f.id === pid);
          if (idx > -1) favs.splice(idx, 1);
          else favs.push({ id: pid, name: pname, price: parseInt(pprice || '0'), image: pimage });

          localStorage.setItem('ballqish_favs', JSON.stringify(favs));
          paintWishlist();
          window.dispatchEvent(new Event('favoritesUpdated'));
          if (window.showToast) {
            window.showToast(idx > -1 ? 'Dihapus dari favorit' : 'Disimpan ke favorit', 'success');
          }
        });

        paintWishlist();
      }

      btnAddToCart?.addEventListener('click', () => handleAddToCart(false));
      btnBuyNow?.addEventListener('click', () => handleAddToCart(true));

      // Mobile Sticky Floating Buttons
      const mobileAddCartBtn = document.getElementById('mobile-add-cart-btn');
      const mobileBuyNowBtn = document.getElementById('mobile-buy-now-btn');
      mobileAddCartBtn?.addEventListener('click', () => handleAddToCart(false));
      mobileBuyNowBtn?.addEventListener('click', () => handleAddToCart(true));

      // Interactive Thumbnail Image Switcher
      function bindThumbnails() {
        const mainImg = document.getElementById('mainProductImage');
        const thumbnailContainer = document.querySelector('.thumbnail-btn')?.parentElement;
        if (!mainImg || !thumbnailContainer) return;

        thumbnailContainer.addEventListener('click', (event) => {
          const target = event.target;
          const thumbnail = target instanceof Element ? target.closest('.thumbnail-btn') : null;
          if (!thumbnail) return;

          event.preventDefault();
          const newSrc = thumbnail.dataset.imgSrc;
          if (!newSrc) return;

          mainImg.setAttribute('src', newSrc);
          thumbnailContainer.querySelectorAll('.thumbnail-btn').forEach(button => {
            button.classList.remove('border-gray-900', 'border-2');
            button.classList.add('border-gray-200', 'opacity-70');
          });

          thumbnail.classList.remove('border-gray-200', 'opacity-70');
          thumbnail.classList.add('border-gray-900', 'border-2');
        });
      }

      bindThumbnails();

      // Check Raw Material Supplier PO Status
      async function checkMaterialStatus() {
        if (!supabaseUrl || !supabaseKey) return;
        try {
          const res = await fetch(`${supabaseUrl}/rest/v1/raw_materials?select=*`, {
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`
            }
          });
          if (res.ok) {
            const rawMats = await res.json();
            if (rawMats && rawMats.length > 0) {
              const limitedOrOut = rawMats.find(m => m.status === 'Terbatas' || m.status === 'Habis');
              if (limitedOrOut) {
                const noticeBox = document.getElementById('craftsman-material-notice');
                const noticeText = document.getElementById('craftsman-notice-text');
                if (noticeBox && noticeText) {
                  const delay = limitedOrOut.delay_days || 2;
                  noticeText.textContent = `Info Pasokan: ${limitedOrOut.name} berstatus ${limitedOrOut.status}. Estimasi tambahan waktu produksi +${delay} hari (PO).`;
                  noticeBox.classList.remove('hidden');
                }
              }
            }
          }
        } catch (e) {
          // Silent fallback
        }
      }

      checkMaterialStatus();
    });
  </script>
</Layout>
