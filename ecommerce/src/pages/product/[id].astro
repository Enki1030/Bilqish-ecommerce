---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: products } = await supabase.from('products').select('id');
  return (products || []).map(p => ({
    params: { id: p.id }
  }));
}

const { id } = Astro.params;

const { data: product, error } = await supabase
  .from('products')
  .select('*')
  .eq('id', id)
  .single();

if (error || !product) {
  return Astro.redirect('/404');
}

// Convert sizes array from JSON string if needed, or if it's already an array
const sizes = Array.isArray(product.sizes) ? product.sizes : JSON.parse(product.sizes || '[]');

// Extract all gallery / promo mockup photos safely from column OR embedded tag
let galleryList: string[] = [];

if (product.gallery_urls) {
  galleryList = Array.isArray(product.gallery_urls) ? product.gallery_urls : (typeof product.gallery_urls === 'string' ? JSON.parse(product.gallery_urls || '[]') : []);
}

// Fallback to embedded description tag if galleryList is empty
if (galleryList.length === 0 && product.description) {
  const match = product.description.match(/<!--GALLERY:(.*?)-->/);
  if (match && match[1]) {
    try {
      galleryList = JSON.parse(match[1]);
    } catch (e) {
      console.error(e);
    }
  }
}

// Query total sold quantity from order_items for this product
const { data: orderItemsData } = await supabase
  .from('order_items')
  .select('quantity')
  .eq('product_id', product.id);

const totalSold = (orderItemsData || []).reduce((sum, item) => sum + (Number(item.quantity) || 1), 0);

// Extract initial stock from product column OR embedded description tag
let initialStock = 50;
if (product.stock !== undefined && product.stock !== null) {
  initialStock = Number(product.stock);
} else if (product.description) {
  const stockMatch = product.description.match(/<!--STOCK:(\d+)-->/);
  if (stockMatch && stockMatch[1]) {
    initialStock = parseInt(stockMatch[1]);
  }
}

const effectiveStock = Math.max(0, initialStock - totalSold);

const allImages = [product.image_url, ...galleryList].filter(Boolean);
const cleanDescription = (product.description || '').replace(/<!--(GALLERY|STOCK):[\s\S]*?-->/g, '').trim();

---

<Layout title={`${product.name} - Ballqish Shoes`}>
  <Header />

  <main class="flex-1 bg-[#FAF9F6] pt-8 pb-24">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex text-xs font-heading tracking-widest uppercase text-gray-500 mb-8 font-medium">
        <a href="/" class="hover:text-primary transition-colors">Shop</a>
        <span class="mx-3">/</span>
        <span class="text-gray-900">{product.name}</span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-12 lg:gap-20">
        
        <!-- LEFT: Image Gallery -->
        <div class="w-full lg:w-1/2 flex flex-col-reverse md:flex-row gap-4 lg:sticky lg:top-32 lg:h-max">
          <!-- Thumbnails (Main Photo & Promo Mockup Photos with Scrollbar) -->
          <div class="flex md:flex-col gap-3 overflow-x-auto md:overflow-y-auto w-full md:w-24 md:max-h-[540px] flex-shrink-0 pr-1 scrollbar-thin scrollbar-thumb-gray-300">
            {allImages.map((imgSrc, idx) => (
              <button 
                type="button"
                data-img-src={imgSrc}
                class={`thumbnail-btn w-20 h-20 md:w-full md:h-24 bg-white border flex-shrink-0 flex items-center justify-center transition-all cursor-pointer rounded-lg overflow-hidden ${
                  idx === 0 ? 'border-gray-900 border-2' : 'border-gray-200 opacity-70 hover:opacity-100 hover:border-gray-400'
                }`}
              >
                <img src={imgSrc} alt={`Tampilan ${idx + 1}`} class="w-full h-full object-cover mix-blend-multiply" />
              </button>
            ))}
          </div>
          
          <!-- Main Image Display -->
          <div class="flex-1 bg-white border border-gray-200 aspect-[4/5] flex items-center justify-center p-8 relative rounded-xl overflow-hidden shadow-xs">
            <img id="mainProductImage" src={product.image_url} alt={product.name} class="w-full h-full object-cover mix-blend-multiply transition-all duration-300" />
          </div>
        </div>

        <!-- RIGHT: Product Details -->
        <div class="w-full lg:w-1/2 flex flex-col">
          
          <!-- Title & Price -->
          <div class="mb-10 border-b border-gray-200 pb-8">
            <p class="text-xs font-heading font-medium text-gray-500 mb-3 tracking-[0.2em] uppercase">{product.category}</p>
            <p class="text-2xl font-body font-bold text-gray-900">Rp {product.price.toLocaleString('id-ID')}</p>
            
            <!-- Privacy-Safe Dynamic Delivery Lead Time Estimator Widget -->
            <div class="mt-5 p-4 bg-[#FAF9F6] border border-gray-200 rounded-xl font-sans space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                  <span class="text-xs font-bold text-gray-900 tracking-wide uppercase font-heading">Estimasi Waktu Tiba</span>
                </div>
                <span id="lead-time-mode-badge" class="text-[11px] font-bold text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-full">Ready Stock</span>
              </div>
              <p class="text-base font-bold text-gray-900" id="estimated-arrival-date">Menghitung estimasi...</p>
              <p class="text-[11px] text-gray-500 font-light leading-relaxed" id="estimated-arrival-details">
                Estimasi pengerjaan handmade & pengiriman standar (3 Hari Ekspedisi ke seluruh wilayah).
              </p>
            </div>
          </div>

          <!-- Outsole Model Selection -->
          <div class="mb-8">
            <h3 class="text-xs font-heading font-semibold text-gray-900 uppercase tracking-widest mb-4">Pilih Model Outsole</h3>
            <div class="grid grid-cols-2 gap-4">
              <label class="cursor-pointer group">
                <input type="radio" name="outsole" value="Model 1" class="peer sr-only" checked />
                <div class="flex items-center gap-3 p-3 border border-gray-200 peer-checked:border-gray-900 peer-checked:bg-white hover:border-gray-300 transition-colors">
                  <div class="w-12 h-12 bg-gray-50 flex-shrink-0 flex items-center justify-center">
                    <img src={product.image_url} alt="Model 1" class="w-full h-full object-cover mix-blend-multiply opacity-80" />
                  </div>
                  <div>
                    <p class="font-heading font-semibold text-gray-900 text-sm tracking-wide">Model 1</p>
                    <p class="text-sm text-gray-600 font-body">Standard Sole</p>
                  </div>
                </div>
              </label>
              
              <label class="cursor-pointer group">
                <input type="radio" name="outsole" value="Model 2" class="peer sr-only" />
                <div class="flex items-center gap-3 p-3 border border-gray-200 peer-checked:border-gray-900 peer-checked:bg-white hover:border-gray-300 transition-colors">
                  <div class="w-12 h-12 bg-gray-50 flex-shrink-0 flex items-center justify-center">
                    <img src={product.image_url} alt="Model 2" class="w-full h-full object-cover mix-blend-multiply filter contrast-125" />
                  </div>
                  <div>
                    <p class="font-heading font-semibold text-gray-900 text-sm tracking-wide">Model 2</p>
                    <p class="text-sm text-gray-600 font-body">Premium Sole</p>
                  </div>
                </div>
              </label>
            </div>
          </div>

          <!-- Size Selection -->
          <div class="mb-8">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-xs font-heading font-semibold text-gray-900 uppercase tracking-widest">Pilih Ukuran Size</h3>
              <a href="#size-chart" class="text-xs text-gray-500 hover:text-primary uppercase tracking-widest transition-colors font-heading">Panduan Ukuran</a>
            </div>
            <div class="grid grid-cols-4 sm:grid-cols-5 gap-3" id="size-selector">
              {sizes.map(size => (
                <button type="button" data-size={size} class="size-btn py-3 border border-gray-200 text-sm font-button font-medium text-gray-700 hover:border-gray-900 transition-all focus:outline-none">
                  {size}
                </button>
              ))}
            </div>
            <p id="size-error" class="hidden text-xs text-primary font-heading uppercase tracking-wide mt-3 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              Harap pilih ukuran terlebih dahulu
            </p>
          </div>

          <!-- Quantity -->
          <div class="mb-10">
            <h3 class="text-xs font-heading font-semibold text-gray-900 uppercase tracking-widest mb-4">Jumlah</h3>
            <div class="flex items-center border border-gray-200 w-max bg-white">
              <button type="button" id="qty-minus" class="px-5 py-3 text-gray-500 hover:bg-gray-50 hover:text-gray-900 transition-colors focus:outline-none">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 12H4"></path></svg>
              </button>
              <input type="number" id="qty-input" value="1" min="1" max={effectiveStock} class="w-12 text-center text-gray-900 font-heading font-semibold focus:outline-none bg-transparent appearance-none border-none p-0" readonly />
              <button type="button" id="qty-plus" class="px-5 py-3 text-gray-500 hover:bg-gray-50 hover:text-gray-900 transition-colors focus:outline-none">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
              </button>
            </div>
            <p class="text-xs text-gray-500 font-body mt-3">Sisa stok: <span id="live-stock-count">{effectiveStock}</span> pasang</p>
          </div>

          <!-- Actions -->
          <div class="flex flex-col sm:flex-row gap-4 mb-12">
            <button id="add-to-cart-btn" class="flex-1 bg-transparent border border-gray-900 text-gray-900 font-button font-medium text-xs tracking-widest uppercase px-8 py-4 hover:bg-gray-900 hover:text-white transition-colors focus:outline-none">
              Add to cart
            </button>
            <button id="buy-now-btn" class="flex-1 bg-gray-900 border border-gray-900 text-white font-button font-medium text-xs tracking-widest uppercase px-8 py-4 hover:bg-gray-800 transition-colors focus:outline-none">
              Buy it now
            </button>
          </div>

          <!-- Description Accordion -->
          <div class="border-t border-gray-200">
            <details class="group py-5" open>
              <summary class="flex justify-between items-center font-heading font-semibold text-gray-900 uppercase tracking-widest text-sm cursor-pointer list-none">
                Description
                <span class="transition group-open:rotate-180">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </summary>
              <div class="text-gray-700 mt-4 leading-snug font-body font-light text-base whitespace-pre-line">
                {cleanDescription || `Sepatu ${product.name} dari Ballqish dirancang dengan tingkat ketelitian tinggi. Model ${product.model} ini menghadirkan perpaduan material premium yang tahan lama, sangat nyaman digunakan untuk kegiatan sehari-hari maupun acara khusus.`}
              </div>
            </details>
            <details class="group py-5 border-t border-gray-200">
              <summary class="flex justify-between items-center font-heading font-semibold text-gray-900 uppercase tracking-widest text-sm cursor-pointer list-none">
                Shipping & Returns
                <span class="transition group-open:rotate-180">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </summary>
              <div class="text-gray-700 mt-4 leading-snug font-body font-light text-base">
                Pengiriman akan diproses 1x24 jam setelah pembayaran dikonfirmasi. Garansi retur ukuran maksimal 3 hari sejak barang diterima (syarat dan ketentuan berlaku).
              </div>
            </details>
          </div>

        </div>
      </div>
    </div>
  </main>
  
  <Footer />

  <style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    /* Hide number input arrows */
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
      -webkit-appearance: none; 
      margin: 0; 
    }
  </style>

  <script define:vars={{ product, initialStock, supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL, supabaseKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }}>
    document.addEventListener('DOMContentLoaded', () => {
      let selectedSize = null;
      let quantity = 1;
      let currentMaxStock = initialStock;

      // --- DOM Elements ---
      const sizeBtns = document.querySelectorAll('.size-btn');
      const errorMsg = document.getElementById('size-error');
      const qtyInput = document.getElementById('qty-input');
      const btnMinus = document.getElementById('qty-minus');
      const btnPlus = document.getElementById('qty-plus');
      const btnAddToCart = document.getElementById('add-to-cart-btn');
      const btnBuyNow = document.getElementById('buy-now-btn');
      const outsoleRadios = document.querySelectorAll('input[name="outsole"]');

      // --- Real-time Live Stock Sync from Supabase ---
      async function syncLiveStock() {
        if (!supabaseUrl || !supabaseKey) return;
        try {
          const res = await fetch(`${supabaseUrl}/rest/v1/order_items?product_id=eq.${product.id}&select=quantity`, {
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`
            }
          });
          if (res.ok) {
            const items = await res.json();
            const sold = items.reduce((acc, i) => acc + (Number(i.quantity) || 1), 0);
            currentMaxStock = Math.max(0, initialStock - sold);

            const stockEl = document.getElementById('live-stock-count');
            if (stockEl) stockEl.textContent = currentMaxStock.toString();

            if (qtyInput) qtyInput.setAttribute('max', currentMaxStock.toString());
          }
        } catch(e) {
          console.error('Failed to sync live stock:', e);
        }
      }

      syncLiveStock();

      // --- 3-Stage Dynamic Lead Time Calculator (Privacy-Safe) ---
      let rawMaterialsCache = null;

      async function updateDynamicLeadTime() {
        if (!supabaseUrl || !supabaseKey) return;

        try {
          if (!rawMaterialsCache) {
            const res = await fetch(`${supabaseUrl}/rest/v1/raw_materials?select=*`, {
              headers: {
                'apikey': supabaseKey,
                'Authorization': `Bearer ${supabaseKey}`
              }
            });
            if (res.ok) {
              rawMaterialsCache = await res.json();
            }
          }

          const mats = rawMaterialsCache || [];
          const selectedSolRadio = document.querySelector('input[name="outsole"]:checked');
          const solModel = selectedSolRadio ? selectedSolRadio.value : 'Model 1';

          const isLaced = product.name.toLowerCase().includes('bertali') || product.name.includes(' T') || product.name.toLowerCase().includes('tali');
          const upperSubType = isLaced ? 'Bertali' : 'Non-Tali';

          let upperDelay = 0;
          let solDelay = 0;

          // Check Upper Material Stock
          const upperMat = mats.find(m => m.sub_type === upperSubType || m.name?.includes(upperSubType));
          if (upperMat) {
            const stock = Number(upperMat.stock_quantity ?? 25);
            if (quantity > stock) {
              upperDelay = Number(upperMat.delay_days || 2);
            }
          }

          // Check Sol Material Stock
          const solMat = mats.find(m => m.sub_type === solModel || m.name?.includes(solModel));
          if (solMat) {
            const stock = Number(solMat.stock_quantity ?? 25);
            if (quantity > stock) {
              solDelay = Number(solMat.delay_days || 2);
            }
          }

          // 3-Stage Formula: Procurement + 2 Days Production + 3 Days Default Shipping
          const procurementDelay = Math.max(upperDelay, solDelay);
          const productionDays = 2;
          const shippingDays = 3;
          const totalDaysMin = procurementDelay + productionDays + shippingDays;
          const totalDaysMax = totalDaysMin + 2;

          const nowMin = new Date();
          nowMin.setDate(nowMin.getDate() + totalDaysMin);
          const nowMax = new Date();
          nowMax.setDate(nowMax.getDate() + totalDaysMax);

          const minStr = nowMin.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
          const maxStr = nowMax.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });

          const arrivalEl = document.getElementById('estimated-arrival-date');
          if (arrivalEl) arrivalEl.textContent = `${minStr} - ${maxStr} ${nowMin.getFullYear()}`;

          const badgeEl = document.getElementById('lead-time-mode-badge');
          if (badgeEl) {
            if (procurementDelay > 0) {
              badgeEl.textContent = 'Handmade Pre-Order';
              badgeEl.className = 'text-[11px] font-bold text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full';
            } else {
              badgeEl.textContent = 'Ready Stock';
              badgeEl.className = 'text-[11px] font-bold text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-full';
            }
          }
        } catch(e) {
          console.error('Lead time update error:', e);
        }
      }

      updateDynamicLeadTime();

      outsoleRadios.forEach(radio => {
        radio.addEventListener('change', updateDynamicLeadTime);
      });

      // --- Size Selection Logic ---
      sizeBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget;
          selectedSize = target.dataset.size;
          
          // Reset styles
          sizeBtns.forEach(b => {
            b.classList.remove('border-gray-900', 'bg-gray-900', 'text-white');
            b.classList.add('border-gray-200', 'text-gray-700');
          });
          
          // Apply active style
          target.classList.remove('border-gray-200', 'text-gray-700');
          target.classList.add('border-gray-900', 'bg-gray-900', 'text-white');
          
          // Hide error if selected
          if (errorMsg) errorMsg.classList.add('hidden');
        });
      });

      // --- Quantity Logic ---
      btnMinus?.addEventListener('click', () => {
        if (quantity > 1) {
          quantity--;
          if (qtyInput) qtyInput.value = quantity.toString();
          updateDynamicLeadTime();
        }
      });

      btnPlus?.addEventListener('click', () => {
        if (quantity < currentMaxStock) {
          quantity++;
          if (qtyInput) qtyInput.value = quantity.toString();
          updateDynamicLeadTime();
        } else {
          if (window.showToast) window.showToast('Maksimal stok tercapai', 'error');
        }
      });

      // --- Add to Cart Logic ---
      function handleAddToCart(buyNow = false) {
        if (!selectedSize) {
          if (errorMsg) errorMsg.classList.remove('hidden');
          
          // Shake animation on size selector
          const selector = document.getElementById('size-selector');
          selector.classList.add('animate-[shake_0.5s_ease-in-out]');
          setTimeout(() => selector.classList.remove('animate-[shake_0.5s_ease-in-out]'), 500);
          
          if (window.showToast) window.showToast('Pilih ukuran terlebih dahulu', 'error');
          return;
        }

        let selectedOutsole = 'Model 1';
        outsoleRadios.forEach(radio => {
          if (radio.checked) selectedOutsole = radio.value;
        });

        // Load existing cart
        let cart = [];
        try {
          const c = localStorage.getItem('ballqish_cart');
          if (c) cart = JSON.parse(c);
        } catch(e) {}

        const itemToAdd = {
          id: product.id,
          name: product.name,
          price: product.price,
          image: product.image_url,
          size: selectedSize,
          outsole: selectedOutsole,
          quantity: quantity
        };

        const existingItemIndex = cart.findIndex(item => item.id === itemToAdd.id && item.size === itemToAdd.size && item.outsole === itemToAdd.outsole);
        
        if (existingItemIndex > -1) {
          cart[existingItemIndex].quantity += itemToAdd.quantity;
        } else {
          cart.push(itemToAdd);
        }

        localStorage.setItem('ballqish_cart', JSON.stringify(cart));

        if (window.showToast) {
          window.showToast(`Berhasil menambahkan ${itemToAdd.quantity} pasang ke keranjang!`, 'success');
        }

        // Trigger custom event so Header can update cart count
        window.dispatchEvent(new Event('cartUpdated'));

        if (buyNow) {
          // If buy now, we could theoretically redirect directly to checkout page, 
          // or just open the cart modal. For now, redirect home to open cart.
          setTimeout(() => {
            window.location.href = '/?openCart=true';
          }, 500);
        }
      }

      btnAddToCart?.addEventListener('click', () => handleAddToCart(false));
      btnBuyNow?.addEventListener('click', () => handleAddToCart(true));

      // Interactive Thumbnail Image Switcher
      function bindThumbnails() {
        const mainImg = document.getElementById('mainProductImage');
        const thumbnailButtons = document.querySelectorAll('.thumbnail-btn');

        thumbnailButtons.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const newSrc = btn.getAttribute('data-img-src');
            if (mainImg && newSrc) {
              mainImg.setAttribute('src', newSrc);
            }

            thumbnailButtons.forEach((b) => {
              b.classList.remove('border-gray-900', 'border-2');
              b.classList.add('border-gray-200', 'opacity-70');
            });

            btn.classList.remove('border-gray-200', 'opacity-70');
            btn.classList.add('border-gray-900', 'border-2');
          });
        });
      }

      bindThumbnails();

      // Check Raw Material Supplier PO Status
      async function checkMaterialStatus() {
        if (!supabaseUrl || !supabaseKey) return;
        try {
          const res = await fetch(`${supabaseUrl}/rest/v1/raw_materials?select=*`, {
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`
            }
          });
          if (res.ok) {
            const rawMats = await res.json();
            if (rawMats && rawMats.length > 0) {
              const limitedOrOut = rawMats.find(m => m.status === 'Terbatas' || m.status === 'Habis');
              if (limitedOrOut) {
                const noticeBox = document.getElementById('craftsman-material-notice');
                const noticeText = document.getElementById('craftsman-notice-text');
                if (noticeBox && noticeText) {
                  const delay = limitedOrOut.delay_days || 2;
                  noticeText.textContent = `Info Pasokan: ${limitedOrOut.name} berstatus ${limitedOrOut.status}. Estimasi tambahan waktu produksi +${delay} hari (PO).`;
                  noticeBox.classList.remove('hidden');
                }
              }
            }
          }
        } catch (e) {
          // Silent fallback
        }
      }

      checkMaterialStatus();
    });
  </script>
</Layout>
