---
import '../styles/global.css';
import Toast from '../components/Toast.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Ballqish Shoes - The Best Quality" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		{/* Font Ballqish — dimuat di <head> agar Playfair Display/Manrope/Inter
		    benar-benar terpakai (jika via @import di CSS, font sering gagal
		    termuat dan jatuh ke Georgia/serif). */}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,600&display=swap"
		/>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-ivory text-ink min-h-screen flex flex-col antialiased">
		<slot />
		<Toast />
	</body>
</html>

<script>
  declare global {
    interface Window {
      showToast: (message: string, type?: 'success' | 'error' | 'info') => void;
    }
  }
</script>
